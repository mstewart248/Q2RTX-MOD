# Commented out - stock Q2RTX already ships a high-res override for this texture in
# q2rtx_media.pkz (overrides/<basename>.tga and/or _n.tga). The automatic MAT_Find
# branch picks those up by convention; an explicit entry disables that and pins the
# surface to the files named here, which are a low-res palette dump plus a flat
# 255/128/128 normals template. This file is only for textures the base game does
# not already cover.
# textures/unused/notch1_1:
# 	texture_base materialDev/textures/unused/notch1_1.tga
# 	texture_normals materialDev/textures/unused/notch1_1_n.tga
# 	metalness_factor 0

