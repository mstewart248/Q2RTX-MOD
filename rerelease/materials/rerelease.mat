textures/e2u1/redfield:
	texture_base materialDev/textures/e2u1/redfield.tga
	texture_normals materialDev/textures/e2u1/redfield_n.tga
	metalness_factor 0

# Commented out - this texture carries SURF_LIGHT with a non-zero radiance in the BSP,
# so Q2RTX synthesizes an emissive material for it. That synthesis only happens when the
# material has NO .mat entry at all: bsp_mesh.c does
#     bool material_custom = !mat->source_matfile[0];
#     synth_surface_material &= (pt_enable_surface_lights >= 2) || material_custom;
# and pt_enable_surface_lights defaults to 1. Any entry here sets source_matfile, which
# turns material_custom off and silently kills the light. A stub is only safe for a
# texture that is not a BSP surface light.
# textures/e2u1/redlt1_4:
# 	texture_base materialDev/textures/e2u1/redlt1_4.tga
# 	texture_normals materialDev/textures/e2u1/redlt1_4_n.tga
# 	metalness_factor 0

