# Commented out - stock Q2RTX already ships a high-res override for this texture in
# q2rtx_media.pkz (overrides/<basename>.tga and/or _n.tga). The automatic MAT_Find
# branch picks those up by convention; an explicit entry disables that and pins the
# surface to the files named here, which are a low-res palette dump plus a flat
# 255/128/128 normals template. This file is only for textures the base game does
# not already cover.
# textures/trigger:
# 	texture_base materialDev/textures/trigger.tga
# 	texture_normals materialDev/textures/trigger_n.tga
# 	metalness_factor 0

# Commented out - an emissive map for this texture already ships in q2rtx_media.pkz
# (as <name>_light.tga, or overrides/<basename>_light.tga with the wad dir stripped).
# With no .mat entry, MAT_Find's automatic branch probes for exactly that file and
# lights the surface. An explicit entry takes the other branch, where only the files
# it names are loaded - and this stub names no texture_emissive, so the glow is lost.
# Stub a texture only if it has no _light companion anywhere on the search path.
# textures/unused/+0btshoot1:
# 	texture_base materialDev/textures/unused/+0btshoot1.tga
# 	texture_normals materialDev/textures/unused/+0btshoot1_n.tga
