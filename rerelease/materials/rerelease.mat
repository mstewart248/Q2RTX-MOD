# Alpha-tested foliage/grate surfaces from the rerelease Call of the Machine maps.
# These carry SURF_ALPHATEST (0x2000000) in the BSP and their .wal is a cutout -
# 82-89% palette index 255 - but the path tracer decides masking solely from a
# material texture_mask (see filter_static_masked in bsp_mesh.c); it never looks at
# SURF_ALPHATEST or at alpha in the base texture. With no material at all these
# rendered as solid opaque quads. The *_mask.png files are generated from the .wal:
# black where the palette index is 255, white elsewhere, and the shader keeps a
# texel when mask.r >= 0.5.
#
# NOTE: texture_base is required even though it just points back at the .wal.
# MAT_Find only fills original_width/height inside "if (mat->filename_base[0])",
# and bsp_mesh.c derives the surface UV scale from those (1/width, 1/height).
# An entry without texture_base leaves them 0, the scale falls back to 1.0, and
# the texture tiles once per unit - the foliage rendered as a grid of tiny plants.

textures/hodge/ho_foliage_01:
	texture_base materialDev/HO_Foliage_01.tga
	texture_normals materialDev/HO_Foliage_01_n.tga
	metalness_factor 0
	texture_mask materialDev/HO_Foliage_01_mask.png

textures/hodge/ho_foliage_02:
	texture_base materialDev/HO_Foliage_02.tga
	texture_normals materialDev/HO_Foliage_02_n.tga
	metalness_factor 0
	texture_mask materialDev/HO_Foliage_02_mask.png

textures/hodge/ho_foliage_03:
	texture_base materialDev/HO_Foliage_03.tga
	texture_normals materialDev/HO_Foliage_03_n.tga
	metalness_factor 0
	texture_mask materialDev/HO_Foliage_03_mask.png

textures/hodge/ho_vent_01:
	texture_base materialDev/HO_vent_01.tga
	texture_normals materialDev/HO_vent_01_n.tga
	metalness_factor 0
	texture_mask materialDev/HO_vent_01_mask.png

textures/tomc/tc_tomb_roots_a:
 	texture_base materialDev/tc_tomb_roots_a.tga
 	texture_normals materialDev/tc_tomb_roots_a_n.tga
 	metalness_factor 0
 	texture_mask materialDev/tc_tomb_roots_a_mask.png

models/weapons/v_tesla/skin:
	texture_base materialDev/v_tesla.tga
	texture_normals materialDev/v_tesla_n.tga

models/proj/lightning/skin:
	texture_base materialDev/lightning_a.tga
	texture_normals materialDev/lightning_n.tga
	texture_emissive materialDev/lightning_light.tga
	metalness_factor 0
	emissive_factor 2.0
	

