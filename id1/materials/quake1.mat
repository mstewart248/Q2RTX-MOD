# === END q1matdev.py generated block - entries below here are kept, and win ===
# HAND-MADE ENTRIES: after the generated block, so they win over it.

# STAINED GLASS (Matt, 11-21: start.bsp's window02_1). The texture is a pane of
# thick coloured glass with a made-up lamp behind it: the glass lights up from
# inside, and the light that comes through takes its colour onto the floor.
# Replaces the generated entry above (texture_emissive is not used by this kind).
#   emissive_factor        brightness of the light behind the glass
#   light_factor           the room's light only, not the glass's look
#   stained_light_height   1 = level with the top of the picture, 0 the bottom
#   stained_light_distance how far behind the glass, in tile heights
#   stained_light_sun      1 = a sun (parallel light) along the same line
#   stained_light_size     its radius in degrees: bigger = softer image
#   stained_scatter        0 clear glass (a sharp image) .. 1 all spread (glow)
#   stained_spread         half-width of the glow round the light, degrees
textures/q1/window02_1:
	kind STAINEDGLASS
	texture_base materialDev/remix/TextureDev/window02_1.png
	texture_normals materialDev/remix/TextureDev/window02_1_normal.png
	metalness_factor 0
	emissive_factor 1
	bsp_radiance 0
	default_radiance 0.5
	specular_factor 1
	light_factor 4
	stained_light_height 1
	stained_light_distance 1
	stained_light_sun 1
	stained_light_size 2
	stained_scatter 0.6
	stained_spread 25
	roughness_override 0
	texture_roughness materialDev/remix/TextureDev/window02_1_rough.png
