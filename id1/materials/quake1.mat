#	roughness_override 0.5
#	Remix metallic constant 0.505 - off, Q2RTX shades a metal map only:
#	texture_metallic materialDev/remix/solid*M1.wal + metalness_factor 0.505
	texture_emissive materialDev/remix/TextureDev/EarthScreen_frame0_emissive.png
	is_light 1
	emissive_factor 1.25
