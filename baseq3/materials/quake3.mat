#	stage1: map textures/sfx/tesla1.tga; blendfunc add; rgbgen wave sawtooth 0 1 0 5; tcmod scale 1 .5; tcmod turb 0 .1 0 1; tcMod scroll -1 -1
	stage1_map materialDev/textures/sfx/tesla1.jpg
#	stage2: map textures/sfx/electricslime.tga; blendfunc add; rgbgen wave sin 0 .5 0 1; tcmod scale .5 .5; tcmod turb 0 .1 0 1; tcmod rotate 180; tcmod scroll -1 -1
	stage2_map materialDev/textures/sfx/electricslime.jpg
