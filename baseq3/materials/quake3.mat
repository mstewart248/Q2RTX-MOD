models/powerups/holdable/medkit_sphere:
# scripts/models.shader
#	stage0: map textures/effects/envmapdim.tga; tcgen environment; blendfunc GL_ONE GL_ONE
# Hand edit 2026-11-17: the syringe's glass tube round the red fluid (Matt: the
# glass and liquid looked wrong). An additive reflection map on a model with no
# "surfaceparm trans" is not taken for glass (q3_is_env_glass), so the tube came
# out opaque, banded with envmapdim, and hid the fluid. GLASS gets a white base
# (apply_q3_shader), as the health spheres do.
	kind GLASS
	stage0_map materialDev/textures/effects/envmapdim.jpg
#	texture_normals materialDev/models/powerups/holdable/medkit_sphere_n.png
#	texture_roughness materialDev/models/powerups/holdable/medkit_sphere_rough.png
#	texture_metallic materialDev/models/powerups/holdable/medkit_sphere_metal.png
#	texture_height materialDev/models/powerups/holdable/medkit_sphere_height.png
#	texture_emissive materialDev/models/powerups/holdable/medkit_sphere_light.png

