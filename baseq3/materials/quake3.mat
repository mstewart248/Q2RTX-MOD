#	stage0: clampmap models/mapobjects/bitch/orb.tga; blendFunc GL_ONE GL_ONE; tcMod rotate 30
	stage0_map materialDev/models/mapobjects/bitch/orb.jpg
# The glow sprite in the statue's hand (q3dm4, q3tourney1): Quake III's fake
# lens flare, hidden (Matt, 2026-11-17). Its light was q3map_surfacelight 70,
# a radiance of 0.07 - nothing to lose. To keep it faintly instead, replace
# the kind line with:  emissive_factor 0.02  and  light_factor 50
	kind INVISIBLE
#	texture_normals materialDev/models/mapobjects/bitch/orb_n.png
#	texture_roughness materialDev/models/mapobjects/bitch/orb_rough.png
#	texture_metallic materialDev/models/mapobjects/bitch/orb_metal.png
