# QUAKE III ARENA MATERIALS
#
# Written 2026-11-16 by q3matdev.py from the retail pak0-pak8.pk3: an entry for
# every texture a Quake III map or model draws (2068 entries: 1234 shader scripts,
# 834 plain textures), after the hand-made ones. Every image under textures/
# and models/ in the paks was copied to baseq3/materialDev/ (lower-case paths)
# and the entries name those copies, so editing a copy changes the game.
#
# A PLAIN TEXTURE (no shader script) names its copy with texture_base.
#
# A SCRIPTED SHADER (scripts/*.shader) is drawn from its stages, so each
# stage's image is named with stage<N>_map - N is the stage's place in the
# script from 0, $lightmap stages counted. There is no texture_base: the script
# says which stage is the colour and which glows, and the material takes its
# images from those stages. The comment above each stage line is the stage as
# the script has it. Commented-out stages:
#   animMap - one image would stop the animation; the frames are listed.
#   sky     - the sky's layers are drawn from the script (q3stages.c).
#   $lightmap / $whiteimage, video, and images outside textures/ and models/.
#
# The commented texture_normals / _roughness / _metallic / _height / _emissive
# lines are where PBR maps go: make the file, uncomment the line, then
# "mat reload". kind, roughness_override, emissive_factor and the rest work as
# in any .mat file; whatever an entry leaves unsaid still comes from the script.

# ---------------------------------------------------------------------------
# HAND-MADE ENTRIES
# ---------------------------------------------------------------------------

# Quake III health (g_q3_items 1): a clear glass sphere round a glowing cross.
# Quake III drew the spheres with an additive reflection map and the crosses
# as reflective metal; here the sphere is real glass (apply_q3_shader gives it
# a white base) and the cross emits in its own colour. The md3 loader rounds
# the spheres (vkpt models.c, round_sphere_mesh). NOT EYE-CHECKED: the
# emissive_factor is a first guess.
#
# 2026-11-16: the crosses are real lights (is_light 1, a light per triangle,
# 44 a cross), so their light goes out through the glass - only a real light's
# does, and only then can the glass bend it. caustic_ripple 1 throws it in
# moving water ripples, "mystical and ethereal" (Matt): 2 = sharper folds,
# 0.5 = softer, 0 = off. Needs pt_caustics 1.

models/powerups/health/green_sphere:
	kind GLASS
	caustic 1
	caustic_ripple 1

models/powerups/health/yellow_sphere:
	kind GLASS
	caustic 1
	caustic_ripple 1

models/powerups/health/red_sphere:
	kind GLASS
	caustic 1
	caustic_ripple 1

models/powerups/health/mega1:
	kind GLASS
	caustic 1
	caustic_ripple 1

models/powerups/health/green:
	kind REGULAR
	texture_emissive materialDev/textures/effects/envmaprail.jpg
	emissive_factor 1
	is_light 1

models/powerups/health/yellow:
	kind REGULAR
	texture_emissive materialDev/textures/effects/envmapyel.jpg
	emissive_factor 1
	is_light 1

# red and mega2 also have an electric layer (kenelectric) turning over them;
# that stage draws the glow image here, so the glow keeps the motion
models/powerups/health/red:
	kind REGULAR
	texture_emissive materialDev/textures/effects/envmapgold.jpg
	emissive_factor 1
	is_light 1

models/powerups/health/mega2:
	kind REGULAR
	texture_emissive materialDev/textures/effects/envmapblue.jpg
	emissive_factor 1
	is_light 1

