textures/gothic_door/skullarch_b:
# scripts/gothic_block.shader
#	stage0: map textures/sfx/firegorre.tga; tcmod scroll 0 1; tcMod turb 0 .25 0 5.6; tcmod scale 1.5 1.5; blendFunc GL_ONE GL_ZERO; rgbGen identity
	stage0_map materialDev/textures/sfx/firegorre.tga
#	stage1: map textures/gothic_door/skullarch_b.tga; blendFunc blend; rgbGen identity
	stage1_map materialDev/textures/gothic_door/skullarch_b.tga
	emissive_factor 0.2
	is_light 1
#	stage2: map $lightmap; blendFunc filter; rgbGen identity
#	texture_normals materialDev/textures/gothic_door/skullarch_b_n.png
#	texture_roughness materialDev/textures/gothic_door/skullarch_b_rough.png
#	texture_metallic materialDev/textures/gothic_door/skullarch_b_metal.png
#	texture_height materialDev/textures/gothic_door/skullarch_b_height.png
	texture_emissive materialDev/textures/sfx/firegorre.tga
	default_radiance 0.2

