models/mapobjects/kmlamp_white:
# scripts/models.shader
#	stage0: map textures/effects/tinfxb.tga; tcGen environment; blendFunc GL_ONE GL_ONE
	stage0_map materialDev/textures/effects/tinfxb.jpg
# HAND: clear glass that bends a light placed inside the bulb by the bulb's own
# shape (vertex normals) - focus spots, dark bands past ~41 deg. Needs
# pt_caustics 1. "caustic 0.5" halves the bend, "caustic 0" turns it off.
	kind GLASSCAUSTIC
#	texture_normals materialDev/models/mapobjects/kmlamp_white_n.png
#	texture_roughness materialDev/models/mapobjects/kmlamp_white_rough.png
#	texture_metallic materialDev/models/mapobjects/kmlamp_white_metal.png
#	texture_height materialDev/models/mapobjects/kmlamp_white_height.png
#	texture_emissive materialDev/models/mapobjects/kmlamp_white_light.png

