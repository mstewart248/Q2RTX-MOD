# scripts/base_wall.shader
#	stage0 (animMap - one stage0_map would stop it): animMap .25 textures/base_wall/q3tourney1.tga textures/base_wall/q3tourney2.tga textures/base_wall/q3tourney3.tga textures/base_wall/q3tourney4.tga textures/base_wall/q3tourney5.tga; rgbGen wave sawtooth 0 1 0 .25
