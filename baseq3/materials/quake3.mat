#	stage0 (animMap - one stage0_map would stop it): animMap .25 textures/base_wall/medal_impressive.tga textures/base_wall/medal_gauntlet.tga textures/base_wall/medal_excellent.tga textures/base_wall/medal_accuracy.tga textures/base_wall/medal_victory.tga textures/base_wall/medal_frags.tga; rgbGen wave sawtooth 0 1 0 .25
#		materialDev/textures/base_wall/medal_impressive.jpg
#		materialDev/textures/base_wall/medal_gauntlet.jpg
#		materialDev/textures/base_wall/medal_excellent.jpg
#		materialDev/textures/base_wall/medal_accuracy.tga
#		materialDev/textures/base_wall/medal_victory.tga
#		materialDev/textures/base_wall/medal_frags.tga
#	stage1: map textures/base_wall/comp3textd.tga; blendfunc add; tcmod scroll 5 .25; rgbGen wave inversesawtooth 0 1 0 .25
	stage1_map materialDev/textures/base_wall/comp3textd.jpg
#	stage2: map textures/base_wall/chrome_env.tga; tcgen environment; tcmod scale .5 .5; blendfunc add; rgbgen wave triangle .5 .05 0 10
	stage2_map materialDev/textures/base_wall/chrome_env.jpg
#	stage3: map textures/base_wall/comp3frame.tga; blendfunc blend; rgbgen identity
	stage3_map materialDev/textures/base_wall/comp3frame.tga
	roughness_override 0.01
	emissive_factor 5
	default_radiance 10
#	stage4: map $lightmap; rgbGen identity; blendfunc gl_dst_color gl_zero
#	texture_normals materialDev/textures/base_wall/medal_impressive_n.png
#	texture_roughness materialDev/textures/base_wall/medal_impressive_rough.png
#	texture_metallic materialDev/textures/base_wall/medal_impressive_metal.png
#	texture_height materialDev/textures/base_wall/medal_impressive_height.png
#	texture_emissive materialDev/textures/base_wall/medal_impressive_light.png

