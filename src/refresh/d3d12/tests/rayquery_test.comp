#version 460
#extension GL_EXT_ray_query : require

// d3d12_accel_test.c's shader: through the same glslang -> spv2dxil route as
// vkpt's, bound like the path tracer's (set 0 binding 0 = the TLASes, set 1
// binding 1 = the instance buffer slot, used here for the answers). A 16x16
// grid of rays straight down from z = 10 over [-4, 4]^2; each writes
// (committed instance custom index << 24) | (its geometry index << 16) |
// round(t * 100), or ~0 for a miss.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS[2];

layout(set = 1, binding = 1, std430) buffer Hits {
    uint hits[];
};

void main()
{
    uvec2 p = gl_GlobalInvocationID.xy;
    vec3 origin = vec3(-4.0 + (float(p.x) + 0.5) * 0.5, -4.0 + (float(p.y) + 0.5) * 0.5, 10.0);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topLevelAS[0], gl_RayFlagsOpaqueEXT, 0xff, origin, 0.0, vec3(0.0, 0.0, -1.0), 100.0);
    while (rayQueryProceedEXT(rq)) {
    }

    uint result = 0xffffffffu;
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT)
        result = (uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true)) << 24) |
                 (uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true)) << 16) |
                 uint(rayQueryGetIntersectionTEXT(rq, true) * 100.0 + 0.5);
    hits[p.y * 16u + p.x] = result;
}
