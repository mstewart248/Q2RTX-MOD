#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : enable

// d3d12_cluster_test.c's shader, bound as rayquery_test.comp is (set 0 binding
// 0 = the TLASes, set 1 binding 1 = the answers). A 16x16 grid of rays straight
// down from z = 10 over [-4, 4]^2; each writes (committed instance custom index
// << 24) | (round(t) << 16) | the triangle of its run it hit - by the hit
// shaders' rule (get_model_index_and_prim_offset): geometry index *
// PT_CLUSTER_TRIANGLES + primitive index, which a BLAS built whole (one
// geometry, index 0) answers as plainly as a clustered one - or ~0 for a miss.

#include "../../vkpt/shader/constants.h"

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform accelerationStructureEXT topLevelAS[2];

layout(set = 1, binding = 1, std430) buffer Hits {
    uint hits[];
};

void main()
{
    uvec2 p = gl_GlobalInvocationID.xy;
    vec3 origin = vec3(-4.0 + (float(p.x) + 0.5) * 0.5, -4.0 + (float(p.y) + 0.5) * 0.5, 10.0);

    rayQueryEXT rq;
    rayQueryInitializeEXT(rq, topLevelAS[0], gl_RayFlagsOpaqueEXT, 0xff, origin, 0.0, vec3(0.0, 0.0, -1.0), 100.0);
    while (rayQueryProceedEXT(rq)) {
    }

    uint result = 0xffffffffu;
    if (rayQueryGetIntersectionTypeEXT(rq, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
        uint prim = uint(rayQueryGetIntersectionGeometryIndexEXT(rq, true)) * PT_CLUSTER_TRIANGLES
                  + uint(rayQueryGetIntersectionPrimitiveIndexEXT(rq, true));
        result = (uint(rayQueryGetIntersectionInstanceCustomIndexEXT(rq, true)) << 24) |
                 (uint(rayQueryGetIntersectionTEXT(rq, true) + 0.5) << 16) |
                 (prim & 0xffffu);
    }
    hits[p.y * 16u + p.x] = result;
}
