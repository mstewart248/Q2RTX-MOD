/* TAA FOLDED INTO THIS PASS. Must match taa_folded_in_shader() in asvgf.c, which
   skips the TAA dispatch when this holds (single GPU).

   Under DLSS with no TAA (flt_taa 0), no photo-mode accumulation, pt_dlss_exact_color
   and no A-SVGF, asvgf_taau.comp is a copy on this pass's own grid: TAA_OUTPUT =
   (FLAT_COLOR.rgb, 1) and PT_DLSS_MOTION = FLAT_MOTION.xy through its fp16 shared
   memory. Writing both here saves reading FLAT_COLOR and FLAT_MOTION back. Its
   ASVGF_TAA_A history write is dead under these conditions: flt_enable 0 makes the
   next frame's flt_taa 0, so nothing reads it. */
bool taa_folded()
{
    return global_ubo.pt_dlss != 0
        && global_ubo.flt_taa == AA_MODE_OFF
        && !(global_ubo.temporal_blend_factor > 0)
        && global_ubo.pt_dlss_exact_color != 0
        && global_ubo.flt_enable == 0
        && global_ubo.width == global_ubo.taa_output_width
        && global_ubo.height == global_ubo.taa_output_height;
}

// asvgf_taau.comp's in-range outputs. TAA_OUTPUT and FLAT_COLOR are both rgba16f,
// so storing the fp32 colour here rounds exactly as FLAT_COLOR did, and TAA's copy
// of that fp16 value was exact. The motion goes through packHalf2x16 as TAA's shared
// memory takes it; it came from rgba16f PT_MOTION, so FLAT_MOTION held it exactly.
void taa_folded_store(ivec2 opos, vec3 color, vec2 motion)
{
    imageStore(IMG_TAA_OUTPUT, opos, vec4(color, 1));
    imageStore(IMG_PT_DLSS_MOTION, opos, vec4(unpackHalf2x16(packHalf2x16(motion)), 0, 0));

    // TAA reads FLAT_COLOR back for this, i.e. the fp16-rounded colour this
    // invocation has just stored.
    if (all(equal(opos, ivec2(global_ubo.unscaled_width / 2, global_ubo.unscaled_height / 2))))
        readback.hdr_color = imageLoad(IMG_FLAT_COLOR, opos).rgb;
}

// asvgf_taau.comp zeroes TAA_OUTPUT over the rest of its dispatch grid; see
// taa_dispatch_size() in asvgf.c, which also sizes this pass to cover it.
void taa_folded_clear(ivec2 opos)
{
    ivec2 taa_size = ivec2(global_ubo.taa_output_width, global_ubo.taa_output_height);
    ivec2 grid = taa_size;
    if (taa_size.x < global_ubo.taa_image_width)  grid.x += 8;
    if (taa_size.y < global_ubo.taa_image_height) grid.y += 8;
    grid = ((grid + 15) / 16) * 16;

    if (all(lessThan(opos, grid)))
        imageStore(IMG_TAA_OUTPUT, opos, vec4(0));
}

ivec2 get_input_position(out int other_side_offset)
{
    ivec2 pos;

    pos.x = int(gl_GlobalInvocationID.x / 2);
    pos.y = int(gl_GlobalInvocationID.y);

    int px = int(gl_GlobalInvocationID.x & 1);
    int py = int(gl_GlobalInvocationID.y & 1);

    other_side_offset = global_ubo.pt_field_offset;


    bool is_even_checkerboard = px == py;
    if(global_ubo.pt_swap_checkerboard != 0)
        is_even_checkerboard = !is_even_checkerboard;

    if (!is_even_checkerboard)
    {
        pos.x += global_ubo.pt_field_offset;
        other_side_offset = -other_side_offset;
    }

    return pos;
}

