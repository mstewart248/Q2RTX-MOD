vec2 load_reflect_motion(ivec2 p, int other_side_offset) {
    // Load reflect motion for this field; if it's zero (refraction path), try the neighbor reflection field.
    vec2 mv = imageLoad(IMG_PT_REFLECT_MOTION, p).xy;
    // Use small epsilon to be robust against denormals/precision
    if (length(mv) < 1e-6) {
        vec2 mv_nei = imageLoad(IMG_PT_REFLECT_MOTION, p + ivec2(other_side_offset, 0)).xy;
        // If neighbor exists and has non-zero MV, use it; otherwise preserve zero
        if (length(mv_nei) > 1e-6)
            mv = mv_nei;
    }
    return mv;
}


// ========================================================================== //
// Full-resolution field combine (global_ubo.pt_fullres_fields != 0)
//
// Instead of two checkerboard halves, the path tracer traces a second full-resolution
// layer of the screen, but only where it is needed:
//
//   field 0, at x + 0                  -> the reflection path
//   field 1, at x + pt_field_offset    -> the refraction path
//
// A pixel whose two paths diverge therefore carries BOTH of them, at full internal
// render resolution, and nothing is checkerboarded. This is what DLSS wants; the
// DLSS-RR integration guide (3.5) lists checkerboard rendering as a practice to
// avoid, and the interleave + cross-blur below is what made glass and water look
// noisy under Ray Reconstruction.
//
// The two layers are recombined here:
//
//   split pixels (glass, water, translucent, security cameras) - the two fields carry
//     different light paths, already weighted by their Fresnel / alpha factors, so they
//     are SUMMED.
//
//   everything else - field 1 is never traced or lit at all, so field 0 alone is
//     taken. Only the pixels that genuinely need a second light path pay for one;
//     tracing the whole frame twice is what made this mode cost a second frame.
//
// The G-buffer handed to DLSS is taken from ONE field so that depth, normal, roughness,
// albedo and motion all describe the same surface - the requirement that the old
// checkerboard path could not meet. For split pixels that is the refraction layer: it is
// the see-through base surface, geometrically continuous with whatever is behind the
// glass. The reflection layer is handed over separately through the inputs DLSS-RR
// provides for exactly that purpose - specular motion vectors, specular hit distance and
// reflected albedo.
// ========================================================================== //
/* pt_dlss_guide_albedo_share: HOW MUCH OF A SPLIT PIXEL'S LIGHT IS ITS REFLECTION.

   DLSS-RR keeps texture detail only where its albedo guide shows that detail: whatever
   else is in the colour is lighting to it, and lighting is what it denoises. On a split
   pixel the colour is two pictures summed and the guide (guide field 0) shows one of
   them, the surface seen THROUGH the water. Over a dark pool the reflection is nearly
   all of the light, and its bricks were being denoised away as if they were noise on
   the pool's floor.

   Measured 2026-11-25 against the real nvngx_dlssd.dll (preset F), a rippling reflection
   of a brick wall over a floor carrying 15% of the light, sharpness against the truth:
     the floor's albedo (guide field 0)                 0.59, 0.39 without reflection MVs
     the two albedos mixed by Fresnel (guide field 4)   0.62
     mixed by each layer's share of the LIGHT           0.86, 0.77 without reflection MVs
   and with nothing moving 0.70 against 0.95. A share taken from this pixel's own two
   noisy samples measured nearly as well (0.86, a little more residual noise); over a
   small neighbourhood it matched the exact share.

   So: the reflection's part of the light over a 9x9 neighbourhood (every second pixel,
   25 of them), split pixels only. A robust mean - the square of the mean square root -
   so one firefly does not swing the guide for a frame, and pixels pt_sparse left unlit
   this frame simply add nothing. Depth, normal, roughness and motion are untouched.
   Returns `fallback` (the Fresnel weight) where the neighbourhood holds no light. */
float reflection_light_share(ivec2 opos, float fallback)
{
    float sum_reflect = 0.0;
    float sum_refract = 0.0;
    for(int oy = -2; oy <= 2; oy++)
    {
        for(int ox = -2; ox <= 2; ox++)
        {
            ivec2 q = opos + ivec2(ox, oy) * 2;
            if(q.x < 0 || q.y < 0 || q.x >= global_ubo.width || q.y >= global_ubo.height)
                continue;
            // half-resolution fields: a row not traced this frame borrows its neighbour's
            if(!PT_FIELD_ROW_TRACED(global_ubo, q.y))
                q.y = (q.y + 1 < global_ubo.height) ? q.y + 1 : q.y - 1;

            vec4 c_a = imageLoad(IMG_ASVGF_COLOR, q);
            if(bitCount(int(c_a.a) & CHECKERBOARD_FLAG_FIELD_MASK) <= 1)
                continue;   // not a split pixel: it has no second layer
            vec3 c_b = imageLoad(IMG_ASVGF_COLOR, q + ivec2(global_ubo.pt_field_offset, 0)).rgb;

            float l_a = luminance(max(c_a.rgb, vec3(0)));
            float l_b = luminance(max(c_b, vec3(0)));
            // NaN and Inf fail the comparison and are left out
            if(l_a >= 0.0 && l_a < 1e6) sum_reflect += sqrt(l_a);
            if(l_b >= 0.0 && l_b < 1e6) sum_refract += sqrt(l_b);
        }
    }
    float r2 = sum_reflect * sum_reflect;
    float t2 = sum_refract * sum_refract;
    return (r2 + t2 > 1e-8) ? r2 / (r2 + t2) : fallback;
}

void combine_fullres_fields(ivec2 opos)
{
    ivec2 p_reflect = opos;
    ivec2 p_refract = opos + ivec2(global_ubo.pt_field_offset, 0);

    // Half-resolution reflection/refraction: on a row this frame did not trace, a
    // reflect/refract pixel has no data in either field, so both are read from the
    // neighbouring row that was traced. Opaque pixels are full resolution, untouched.
    if(!PT_FIELD_ROW_TRACED(global_ubo, opos.y)
    	&& IS_REFLECT_REFRACT_KIND(floatBitsToUint(imageLoad(IMG_PT_SHADING_POSITION, p_reflect).w)))
    {
    	int src_y = (opos.y + 1 < global_ubo.height) ? opos.y + 1 : opos.y - 1;
    	p_reflect.y = src_y;
    	p_refract.y = src_y;
    }

    vec4 c_reflect = imageLoad(IMG_ASVGF_COLOR, p_reflect);

    // Both fields write the same flags; reflect_refract.rgen only marks a pixel as split
    // when the two fields genuinely diverge.
    int checkerboard_flags = int(c_reflect.a);
    bool paths_split = bitCount(checkerboard_flags & CHECKERBOARD_FLAG_FIELD_MASK) > 1;

    // Field 1 is only read for a split pixel - compositing.comp no longer even
    // writes it otherwise - so only load it then.
    vec4 c_refract = paths_split ? imageLoad(IMG_ASVGF_COLOR, p_refract) : vec4(0);

    vec3 color;
    ivec2 p_primary;
    // True when the primary guides describe the REFLECTED surface, so the reflection is
    // no longer a secondary lobe that RR has to reproject separately - it is the surface.
    bool reflection_is_primary = false;
    // pt_dlss_guide_field 4: mix the DEMODULATION guides (diffuse and specular albedo)
    // between the two layers by the split's Fresnel weight instead of taking one layer's.
    bool mix_albedo_by_fresnel = false;
    float fresnel_weight = 0.0;
    // pt_dlss_blood_guides: this split is a translucent blood splat's alpha, see below.
    bool blood_split = false;
    // pt_dlss_guide_albedo_share: a split on a Fresnel term (glass, water), and which
    bool fresnel_split = false;
    bool glass_split = false;

    /* primary_rays.rgen's RESPONSIVITY CODE for this pixel: the mask value it wants
       (pt_dlss_animated_responsive), plus DLSS_RESPONSIVITY_CAMERA_BIAS on a security-camera
       screen. Read at opos, never at p_reflect: this pass overwrites opos with the final
       mask below, and a half-resolution row borrowing its neighbour's p_reflect would race
       that write. Field 0 of every render pixel stores a code, so nothing here is stale. */
    float responsivity_code = imageLoad(IMG_DLSS_RESPONSIVITY, opos).x;
    bool camera_screen = responsivity_code >= DLSS_RESPONSIVITY_CAMERA_BIAS;
    float responsivity = camera_screen ? responsivity_code - DLSS_RESPONSIVITY_CAMERA_BIAS : responsivity_code;
    /* pt_dlss_camera_mv 1/2: a camera split hands RR the CAMERA field. Field 0 is the
       picture, field 1 the 5% black-mirror reflection (primary_rays.rgen turns the odd
       field into a SCREEN). Under guide field 0 - and motion field 0 - RR got field 1's
       mirrored motion vector and depth for the whole picture: a doubled, offset image
       that ghosts even up close. Take field 0 for the guides, depth and motion, and hand
       field 1 over through the reflection inputs, which is what they are for. */
    bool camera_fields = false;

    if(paths_split)
    {
        color = c_reflect.rgb + c_refract.rgb;

        // Which layer the DLSS guides describe (pt_dlss_guide_field). Taking the
        // refraction always told RR the pixel was the wall behind the glass - rough,
        // diffuse - while the colour also carried a mirror-sharp reflection, so RR
        // filtered that reflection away. The classic checkerboard interleave picks the
        // brighter field instead (see use_center_mv below). Glass and water want
        // opposite answers here: water is mostly seen THROUGH and swims in motion.
        //   0 refraction always  1 brighter layer  2 reflection always
        //   3 reflection on GLASS only - water/slime keep the refraction
        // A material may answer this for itself - see CHECKERBOARD_FLAG_GUIDE_SET.
        // The cvar is a single global answer to a per-surface question, and gets it
        // wrong on any pane of glass that is a window rather than a mirror.
        int guide_field = (checkerboard_flags & CHECKERBOARD_FLAG_GUIDE_SET) != 0
            ? (checkerboard_flags & CHECKERBOARD_FLAG_GUIDE_MASK) >> CHECKERBOARD_FLAG_GUIDE_SHIFT
            : int(global_ubo.pt_dlss_guide_field);
        bool split_was_glass = (checkerboard_flags & CHECKERBOARD_FLAG_GLASS) != 0;

        /* The split's Fresnel weight, as reflect_refract.rgen parked it in the unused
           alpha of the reflected albedo, biased by +1. Below 1 means this pixel split on
           something that is not a Fresnel term - a security camera, an emissive screen -
           and mode 4 then has nothing to weight with and falls back to mode 3. */
        float fresnel_encoded = imageLoad(IMG_PT_REFLECTED_ALBEDO, p_reflect).a;
        // A blood splat's alpha rides the same channel above REFLECTED_ALBEDO_BLOOD_BIAS.
        bool blood_encoded = fresnel_encoded >= REFLECTED_ALBEDO_BLOOD_BIAS;
        bool have_fresnel = fresnel_encoded >= 1.0 && !blood_encoded;
        fresnel_weight = have_fresnel ? clamp(fresnel_encoded - 1.0, 0.0, 1.0) : 0.0;
        fresnel_split = have_fresnel;
        glass_split = split_was_glass;

        if(guide_field == 2)
            reflection_is_primary = true;
        else if(guide_field == 3)
            reflection_is_primary = split_was_glass;
        else if(guide_field == 1)
            reflection_is_primary = luminance(c_reflect.rgb) > luminance(c_refract.rgb);
        else if(guide_field == 4)
        {
            /* FRESNEL-WEIGHTED GUIDES - the middle ground between 0 and 3.
 
               Depth, normal, motion and roughness describe a place in space. They cannot
               be averaged between two unrelated surfaces, so they follow whichever layer
               actually dominates the pixel, and the test is F: a smooth function of the
               viewing angle carrying no sample noise. The boundary it draws across a pane
               is therefore ONE coherent region edge, which is the difference between this
               and guide_field 1 - comparing two noisy luminances per pixel flips the
               guides pixel to pixel and frame to frame, and RR answers incoherent guides
               by distrusting the history and blurring everything.
 
               Diffuse and specular albedo are not geometry, they are what RR DIVIDES the
               colour by before filtering and multiplies back afterwards. This pixel holds
               F * reflection + (1 - F) * refraction, so the albedo that makes that
               round-trip exact is the same F-weighted mix, applied below. Giving RR one
               layer's albedo for a summed pixel is what inflates a faint reflection into
               a solid one under guide_field 3 and divides it away under guide_field 0. */
            reflection_is_primary = have_fresnel
                ? (fresnel_weight >= global_ubo.pt_dlss_guide_fresnel)
                : split_was_glass;
            mix_albedo_by_fresnel = have_fresnel;
        }
        else if(guide_field == 6)
        {
            /* GUIDE FIELD 3, WITH THE DEMODULATION CORRECTED.

               Geometry is picked exactly as mode 3 picks it - reflection on glass,
               refraction on water and slime - because that is what actually looked
               right, and because forcing the reflection's geometry (or a mirror
               roughness) onto water is what turns moving water to mush.

               The one thing mode 3 gets wrong is energy. RR divides by
               pInDiffuseAlbedo, filters, and multiplies back; mode 3 hands it the
               REFLECTED surface's albedo for a pixel that is only F reflection, so
               the round trip does not close and the reflection comes back stronger
               than it should - slightly, which is exactly the reported symptom. The
               albedo that makes the round trip exact for F*reflect + (1-F)*refract is
               the F-weighted mix of the two, so take mode 3's geometry and mode 4's
               albedo. Roughness is deliberately left alone here. */
            reflection_is_primary = split_was_glass;
            mix_albedo_by_fresnel = have_fresnel;
        }
        else if(guide_field == 5)
        {
            /* The reflection field no longer describes the reflected object - it carries
               the PANE's own normal, albedo, roughness and specular albedo, captured in
               reflect_refract.rgen before the surface was replaced, plus the pane's own
               depth and motion vector. So it is the field to take, and there is nothing
               to mix: RR demodulates the reflected content with pInReflectedAlbedo and
               the pane's specular albedo, which is the division of labour it documents. */
            reflection_is_primary = true;
        }

        /* TRANSLUCENT BLOOD (pt_dlss_blood_guides). A splat below pt_blood_splat_alpha 1
           splits on its ALPHA: field 0 is the blood surface at alpha, field 1 the floor
           seen through it at 1 - alpha. There is no reflection layer here at all, so none
           of the modes above describe it - guide field 0 handed RR the floor for every
           splat pixel, a 0.99 splat included, and RR filtered the blood's wet highlight
           with the floor's roughness.

           So treat alpha the way mode 4 treats F. primary_rays.rgen parks it in the same
           side channel. Geometry follows whichever layer covers more of the pixel - alpha
           carries no sample noise, so the switch is one clean ring inside the feather
           edge - and the demodulation albedos mix by alpha, which is what makes RR's
           divide-filter-multiply close for alpha * blood + (1 - alpha) * floor. The
           roughness is left as the chosen layer's own (see guide_roughness_x below):
           mode 4's mirror roughness is for a pane, and blood is 0.06, not 0.

           Blood is identified by the bias on its alpha (REFLECTED_ALBEDO_BLOOD_BIAS), not
           by field 0's material: IMG_PT_SHADING_POSITION holds the LAST BOUNCE's hit by now
           whenever pt_num_bounce_rays > 1, so that test never passed in play and every
           translucent splat was handed to RR as the floor under it (2026-11-06). */
        if(global_ubo.pt_dlss_blood_guides != 0 && blood_encoded)
        {
            blood_split = true;
            fresnel_weight = clamp(fresnel_encoded - REFLECTED_ALBEDO_BLOOD_BIAS, 0.0, 1.0);
            reflection_is_primary = fresnel_weight >= 0.5;
            mix_albedo_by_fresnel = true;
        }

        // A security-camera screen - see camera_fields above. Overrides every mode.
        if(camera_screen && global_ubo.pt_dlss_camera_mv >= 1 && !blood_split)
        {
            camera_fields = true;
            reflection_is_primary = true;
            mix_albedo_by_fresnel = false;
        }

        p_primary = reflection_is_primary ? p_reflect : p_refract;
    }
    else
    {
        // Field 1 is not lit for non-split pixels (see direct_lighting.rgen), so
        // field 0 carries the complete path here. Averaging in an unlit field
        // would halve the image.
        color = c_reflect.rgb;
        p_primary = p_reflect;
    }

    imageStore(IMG_FLAT_COLOR, opos, vec4(color, float(checkerboard_flags)));

    // --- Primary surface: colour motion, depth and the DLSS-RR guide buffers ---------
    /* MOTION AND DEPTH NEED NOT COME FROM THE SAME FIELD AS THE REST OF THE GUIDES.

       The albedo/normal/roughness guides describe what a pixel LOOKS like; the motion
       vector says where its content was last frame, and DLSS warps the WHOLE pixel
       with it. On a window that pixel is mostly the view THROUGH the glass, so taking
       the reflection's mirrored vector - as guide field 2 and 3 do - stamps the
       reflected character's motion onto the static scenery behind the pane, and it
       visibly bobs along with the player.

       The reflection does not need this channel: it has pInMotionVectorsReflections,
       written below from p_reflect either way. So let the motion vector be chosen
       separately. Depth follows it, because DLSS uses the two together to reproject -
       pairing a refraction motion vector with a reflection depth would describe
       neither surface. */
    ivec2 p_motion = p_primary;
    if(paths_split)
    {
        int motion_field = int(global_ubo.pt_dlss_guide_motion);
        if(motion_field == 1)      p_motion = p_refract;
        else if(motion_field == 2) p_motion = p_reflect;
        // the camera picture's own vector (the screen's, plus the portal step in mode 2)
        if(camera_fields)          p_motion = p_reflect;
    }

    vec4 primary_motion = imageLoad(IMG_PT_MOTION, p_motion);

    imageStore(IMG_FLAT_MOTION,             opos, primary_motion);
    // pt_dlss_particle_layer 2: where primary_rays found no effect to give the
    // transparency layer a vector of its own (.z 0), it moves with the colour
    if (global_ubo.pt_dlss_particle_layer >= 2.0
        && imageLoad(IMG_DLSS_PARTICLE_MOTION, opos).z == 0.0)
        imageStore(IMG_DLSS_PARTICLE_MOTION, opos, vec4(primary_motion.xy, 0, 0));
    if (taa_folded())
        taa_folded_store(opos, color, primary_motion.xy);
    imageStore(IMG_DLSS_DEPTH,              opos, imageLoad(IMG_PT_VIEW_DEPTH_SPLIT,    p_motion));
    /* DLSS FRAME GENERATION WANTS INVERSE DEPTH, NOT LINEAR DEPTH.

       nvsdk_ngx_defs_dlssg.h states that DLSS-G linearizes the depth buffer ITSELF:
         DepthInverted false -> lin_depth = 1 / (1 - depth)
         DepthInverted true  -> lin_depth = 1 / depth
       and every depth heuristic it exposes (MinRelativeLinearDepthObjectSeparation 40,
       LinearizedDepth_NearFarPartition 600) is a threshold in THAT space.

       IMG_DLSS_DEPTH holds raw linear view depth in Quake units, roughly 1..4000, because
       super resolution and ray reconstruction are created with
       NVSDK_NGX_DLSS_Depth_Type_Linear and need it that way. Feeding the same buffer to
       frame generation put the whole scene through 1/(1-depth): a divide by zero at
       exactly 1 unit from the camera, a sign flip across it, and everything else squashed
       into a narrow band of tiny NEGATIVE numbers. No two surfaces are ever 40 apart in
       that space, so the heuristics deciding what is a contiguous surface, and what must
       not scatter motion into the near plane, were inoperative.

       Reflections and refractions took the worst of it: reflect_refract.rgen replaces the
       depth on those pixels with the VIRTUAL distance of the reflected or refracted
       surface, so they are exactly the pixels that swing hardest across the singularity -
       which is why the artifacts concentrated on glass.

       Writing 1/|d| and setting depthInverted makes DLSS-G compute lin_depth = |d|, the
       linear view distance IN QUAKE UNITS: positive, monotonic, no singularity, and the
       SDK's tuned 40 / 600 defaults land at sane world scales (40 units is about a
       doorframe, 600 about a large room). */
    imageStore(IMG_DLSS_FG_DEPTH, opos, vec4(1.0 / max(abs(imageLoad(IMG_PT_VIEW_DEPTH_SPLIT, p_motion).x), 0.01)));
    // Roughness and normal stay with p_primary: they are geometry, and a mix of a mirror
    // and a rough wall is neither surface. Only the two demodulation guides are mixed.
    vec4 guide_albedo      = imageLoad(IMG_PT_ALBEDO,          p_primary);
    vec4 guide_spec_albedo = imageLoad(IMG_PT_SPECULAR_ALBEDO, p_primary);
    if(mix_albedo_by_fresnel)
    {
        guide_albedo.rgb = mix(imageLoad(IMG_PT_ALBEDO, p_refract).rgb,
                               imageLoad(IMG_PT_ALBEDO, p_reflect).rgb, fresnel_weight);
        guide_spec_albedo.rgb = mix(imageLoad(IMG_PT_SPECULAR_ALBEDO, p_refract).rgb,
                                    imageLoad(IMG_PT_SPECULAR_ALBEDO, p_reflect).rgb, fresnel_weight);
    }

    /* pt_dlss_guide_albedo_share (see reflection_light_share): the two demodulation
       guides follow the light. Only where no other mode already mixes them, and never on
       blood (mixed by its alpha) or a camera screen (its picture is field 0 whole). */
    int albedo_share_mode = int(global_ubo.pt_dlss_guide_albedo_share);
    if(paths_split && fresnel_split && !mix_albedo_by_fresnel && !blood_split && !camera_fields
        && albedo_share_mode != 0 && (albedo_share_mode >= 2 || !glass_split))
    {
        float light_share = reflection_light_share(opos, fresnel_weight);
        guide_albedo.rgb = mix(imageLoad(IMG_PT_ALBEDO, p_refract).rgb,
                               imageLoad(IMG_PT_ALBEDO, p_reflect).rgb, light_share);
        guide_spec_albedo.rgb = mix(imageLoad(IMG_PT_SPECULAR_ALBEDO, p_refract).rgb,
                                    imageLoad(IMG_PT_SPECULAR_ALBEDO, p_reflect).rgb, light_share);
    }

    /* ROUGHNESS IS A PROPERTY OF THE REFLECTOR, NOT OF WHAT THE RAY LANDED ON.

       p_primary's roughness belongs to the surface the chosen field hit - the room
       through the glass, or the object in the reflection - and get_material defaults
       that to 1 for anything without a roughness map, which is most BSP geometry. RR
       sizes its specular filter with this, so a split pixel was asking for the widest
       filter available and the reflection came back blurred however the geometry was
       picked. That is the blur left at a low pt_dlss_guide_fresnel.

       On a flat pane BOTH images are specular: the reflection is reflect(), and the
       transmission is a straight refraction. Neither should be spatially filtered, so
       the honest roughness for the composite is pt_dlss_guide_mirror_roughness, ~0.
       Raise it towards 1 to buy noise suppression back at the cost of sharpness. */
    float guide_roughness_x = imageLoad(IMG_PT_ROUGHNESS, p_primary).x;
    if(mix_albedo_by_fresnel && int(global_ubo.pt_dlss_guide_field) != 6 && !blood_split)
        guide_roughness_x = clamp(global_ubo.pt_dlss_guide_mirror_roughness, 0.0, 1.0);
    // pt_dlss_guide_mirror_snap (global_ubo.h): a near-mirror is a mirror to RR
    if(guide_roughness_x < global_ubo.pt_dlss_guide_mirror_snap)
        guide_roughness_x = 0.0;

    imageStore(IMG_DLSS_ALBEDO,             opos, guide_albedo);
    imageStore(IMG_DLSS_ROUGHNESS,          opos, vec4(guide_roughness_x));
    imageStore(IMG_DLSS_NORMAL,             opos, imageLoad(IMG_PT_NORMAL,              p_primary));
    imageStore(IMG_DLSS_SPECULAR_ALBEDO,    opos, guide_spec_albedo);
    // Colour before the transparency overlay. Like the main colour, the two layers are
    // summed for split pixels and averaged otherwise, so that this guide stays consistent
    // with what was written to IMG_FLAT_COLOR above.
    vec4 bt_reflect = imageLoad(IMG_PT_BEFORE_TRANSPARENT, p_reflect);
    vec4 bt_refract = paths_split ? imageLoad(IMG_PT_BEFORE_TRANSPARENT, p_refract) : vec4(0);
    imageStore(IMG_DLSS_BEFORE_TRANSPARENT, opos, vec4(bt_reflect.rgb + bt_refract.rgb, 0));

    /* DLSS 5's control mask (pt_dlss5_volumetric). Compositing left each field's share of
       scene light - as opposed to fog and transparencies - in the alpha of
       PT_BEFORE_TRANSPARENT (dlss5_scene_share, brdf.glsl). A split pixel's colour is the
       two layers summed, so their shares are weighted by how much light each brings. */
    float scene_share = bt_reflect.a;
    if(paths_split)
    {
        float l_reflect = luminance(max(c_reflect.rgb, vec3(0)));
        float l_refract = luminance(max(c_refract.rgb, vec3(0)));
        float l_sum = l_reflect + l_refract;
        scene_share = l_sum > 1e-6
            ? (bt_reflect.a * l_reflect + bt_refract.a * l_refract) / l_sum
            : min(bt_reflect.a, bt_refract.a);
    }
    scene_share = clamp(scene_share, 0.0, 1.0);
    imageStore(IMG_DLSS5_MASK, opos, vec4(vec3(scene_share), 1));

    float diffuse_length  = imageLoad(IMG_PT_RAYLENGTH_DIFFUSE, p_primary).x;
    imageStore(IMG_DLSS_RAYLENGTH_DIFFUSE, opos, vec4(diffuse_length));

    // --- Reflection layer: what DLSS-RR uses to reproject reflections ----------------
    // For a split pixel this is the reflection field's mirrored motion vector and the
    // distance from the glass to the reflected surface. For a non-split pixel the
    // specular lobe sits on the primary surface itself (or the primary surface *is* the
    // mirrored image, as with chrome), so the primary motion vector is the correct
    // specular motion vector - handing DLSS a zero here would claim the reflection is
    // pinned to the screen.
    //
    // No branch needed for pt_dlss_guide_field: when the reflection supplies the guides
    // p_primary IS p_reflect, and reflect_refract.rgen writes the same mirrored vector
    // to both PT_MOTION and PT_REFLECT_MOTION there.
    // A blood split has no mirrored layer: its specular lobe rides the surface the
    // guides describe, exactly as on a non-split pixel.
    // A camera split's reflection layer is field 1, the black mirror: its mirrored
    // vector, hit distance and reflected albedo (camera_fields above).
    //
    // pt_dlss_reflect_mv_surface 0 (Matt, 11-25: this channel is the reflection's motion
    // and nothing else): a pixel with no split hands over only what reflect_refract.rgen
    // wrote at its reflection field - chrome's mirrored motion, a screen's - and the
    // per-frame clear's 0 everywhere nothing was reflected, instead of the surface's own
    // motion (an animated torch, every wall while the camera turns). 1 = the line above.
    ivec2 p_specular = camera_fields ? p_refract : p_reflect;
    vec2 reflect_motion = (paths_split && !blood_split)
        ? imageLoad(IMG_PT_REFLECT_MOTION, p_specular).xy
        : (global_ubo.pt_dlss_reflect_mv_surface != 0 || blood_split)
            ? primary_motion.xy
            : imageLoad(IMG_PT_REFLECT_MOTION, p_reflect).xy;

    float specular_length = imageLoad(IMG_PT_RAYLENGTH_SPECULAR, p_specular).x;

    imageStore(IMG_DLSS_REFLECT_MOTION,     opos, vec4(reflect_motion, 0, 0));
    imageStore(IMG_DLSS_RAYLENGTH_SPECULAR, opos, vec4(specular_length));
    // Alpha carries the Fresnel weight for mode 4 above; zero it so RR is handed a plain
    // albedo and never sees the side channel.
    imageStore(IMG_DLSS_REFLECTED_ALBEDO,   opos, vec4(imageLoad(IMG_PT_REFLECTED_ALBEDO, p_specular).rgb, 0));

    /* RR2's RESPONSIVITY MASK (pt_dlss_animated_responsive): where the picture changes with
       no motion vector that could describe it - a texinfo animation chain (the mguhub
       SECURITY OFF signs blink on and off twice a second, and RR's history kept the near one
       dark while the far ones were lit), a security camera without portal motion vectors,
       or one that has just cut to its next camera. primary_rays.rgen decided the strength;
       this only strips the camera mark.

       The glass and water masks that used to live here (pt_dlss_glass_responsive,
       pt_dlss_water_responsive: mask where the reflection's motion and the through-pane
       motion disagree) were removed on 2026-11-14: on glass and water the mask was the
       wrong tool. This channel now carries only the animation and camera mask. */
    imageStore(IMG_DLSS_RESPONSIVITY, opos, vec4(clamp(responsivity, 0.0, 1.0)));
}

void main()
{
    if(global_ubo.pt_fullres_fields != 0)
    {
        ivec2 opos_full = get_output_position();

        if (opos_full.x >= global_ubo.width || opos_full.y >= global_ubo.height)
        {
            imageStore(IMG_FLAT_COLOR, opos_full, vec4(0));
            if (taa_folded())
                taa_folded_clear(opos_full);
            return;
        }

        combine_fullres_fields(opos_full);
        return;
    }

    int other_side_offset;
    ivec2 ipos = get_input_position(other_side_offset);
    //ivec2 iposTrans = get_input_position_transparent(other_side_offset);
    ivec2 opos = get_output_position();
    
    if (opos.x >= global_ubo.width || opos.y >= global_ubo.height)
    {
        imageStore(IMG_FLAT_COLOR, opos, vec4(0));
        if (taa_folded())
            taa_folded_clear(opos);
        return;
    }

    vec4 center = imageLoad(IMG_ASVGF_COLOR, ipos);
    vec4 color;
    bool use_center_mv = true;
    int checkerboard_flags = int(center.a);
    //bool is_checkerboarded_surface = (global_ubo.flt_enable != 0 /*|| global_ubo.pt_dlss != 0*/) && (bitCount(checkerboard_flags & CHECKERBOARD_FLAG_FIELD_MASK) > 1);
    bool is_checkerboarded_surface = (global_ubo.pt_denoiser_present != 0) && (bitCount(checkerboard_flags & CHECKERBOARD_FLAG_FIELD_MASK) > 1);
    //bool is_checkerboarded_surface = false;
    // The alpha channel encodes whether the material uses checkerboard reflections and refractions.
    // Don't do the filter if there is no checkerboarding - which improves sharpness and reduces sparkles.
    if(is_checkerboarded_surface)
    {
        vec4 a = safe_load(ipos + ivec2(other_side_offset, 1));
        vec4 b = safe_load(ipos + ivec2(other_side_offset, -1));
        vec4 c = safe_load(ipos + ivec2(other_side_offset, 0));
        vec4 d = safe_load(ipos + ivec2(other_side_offset + (((opos.x & 1) != 0) ? 1 : -1), 0));

        if(gl_GlobalInvocationID.x == 0 || gl_GlobalInvocationID.x == global_ubo.width - 1)
        {
            c = vec4(0);
            d = vec4(0);
        }

        vec4 neighbors = (a + b + c + d) * 0.25;

        // Make sure that transparent surfaces contain motion vectors for the brightest component
        // (reflection or refraction), not a mix of both. Helps with TAA quality.
        if(luminance(neighbors.rgb) > luminance(center.rgb))
            use_center_mv = false;

        // Blend the color, not the checkerboard flags.
        color.rgb = mix(center.rgb, neighbors.rgb, 0.5);
        color.a = center.a;
    }
    else
    {
        color = center;
    }

    imageStore(IMG_FLAT_COLOR, opos, color);

    // The two fields only differ in which one supplies the motion vector and guides.
    ivec2 src = use_center_mv ? ipos : ipos + ivec2(other_side_offset, 0);

    vec4 flat_motion = imageLoad(IMG_PT_MOTION, src);
    imageStore(IMG_FLAT_MOTION, opos, flat_motion);
    if (taa_folded())
        taa_folded_store(opos, color.rgb, flat_motion.xy);
    // motion_blur.comp reads this one whether or not DLSS is on.
    imageStore(IMG_DLSS_DEPTH, opos, imageLoad(IMG_PT_VIEW_DEPTH_SPLIT, src));

    // The rest are DLSS inputs only. With DLSS off nothing reads them, and writing them
    // made this pass cost ~0.85 ms at 2913x1670 under A-SVGF.
    if(global_ubo.pt_dlss != 0)
    {
        imageStore(IMG_DLSS_REFLECT_MOTION, opos, vec4(imageLoad(IMG_PT_REFLECT_MOTION, src).xy, 0, 0));
        imageStore(IMG_DLSS_FG_DEPTH, opos, vec4(1.0 / max(abs(imageLoad(IMG_PT_VIEW_DEPTH_SPLIT, src).x), 0.01)));
        imageStore(IMG_DLSS_ALBEDO, opos, imageLoad(IMG_PT_ALBEDO, src));
        float flat_roughness = imageLoad(IMG_PT_ROUGHNESS, src).x;
        if(flat_roughness < global_ubo.pt_dlss_guide_mirror_snap)   // see above
            flat_roughness = 0.0;
        imageStore(IMG_DLSS_ROUGHNESS, opos, vec4(flat_roughness));
        imageStore(IMG_DLSS_NORMAL, opos, imageLoad(IMG_PT_NORMAL, src));
        imageStore(IMG_DLSS_SPECULAR_ALBEDO, opos, imageLoad(IMG_PT_SPECULAR_ALBEDO, src));
        // alpha is DLSS 5's per-field scene share (below), not part of RR's guide
        imageStore(IMG_DLSS_BEFORE_TRANSPARENT, opos, vec4(imageLoad(IMG_PT_BEFORE_TRANSPARENT, src).rgb, 0));
        // DLSS 5's control mask (pt_dlss5_volumetric) - see combine_fullres_fields. A
        // checkerboarded pixel's colour is half its own field, half the other's.
        float scene_share = imageLoad(IMG_PT_BEFORE_TRANSPARENT, ipos).a;
        if(is_checkerboarded_surface)
            scene_share = mix(scene_share, imageLoad(IMG_PT_BEFORE_TRANSPARENT, ipos + ivec2(other_side_offset, 0)).a, 0.5);
        imageStore(IMG_DLSS5_MASK, opos, vec4(vec3(clamp(scene_share, 0.0, 1.0)), 1));
        imageStore(IMG_DLSS_REFLECTED_ALBEDO, opos, imageLoad(IMG_PT_REFLECTED_ALBEDO, src));
        // The responsivity mask (pt_dlss_animated_responsive) is split-field only:
        // primary_rays.rgen writes its code only under pt_fullres_fields, so here the mask
        // only has to be defined
        imageStore(IMG_DLSS_RESPONSIVITY, opos, vec4(0));

        float specularRayLength = ConvertDistance(imageLoad(IMG_PT_RAYLENGTH_SPECULAR, src).x);
        float diffuseRayLength = ConvertDistance(imageLoad(IMG_PT_RAYLENGTH_DIFFUSE, src).x);

        imageStore(IMG_DLSS_RAYLENGTH_DIFFUSE, opos, vec4(diffuseRayLength));
        imageStore(IMG_DLSS_RAYLENGTH_SPECULAR, opos, vec4(specularRayLength));
    }
    
}
