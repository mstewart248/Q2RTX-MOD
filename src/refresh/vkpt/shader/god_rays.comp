// ========================================================================== //
// This shader computes volumetric lighting ("god rays") effects for a given 
// frame by marching rays through a shadow map. Volumetric lighting is computed
// in half resolution for performance, and then filtered to remove some noise
// that is used in the tracing pass to remove banding.
// ========================================================================== //

#version 460
#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_GOOGLE_include_directive    : enable
#extension GL_EXT_nonuniform_qualifier    : enable
#extension GL_EXT_ray_query               : enable

#include "constants.h"
#include "utils.glsl"

#define GOD_RAYS_DESC_SET_IDX 0
#include "god_rays_shared.h"

#define GLOBAL_UBO_DESC_SET_IDX 2
#include "global_ubo.h"

#define VERTEX_BUFFER_DESC_SET_IDX 1
#define VERTEX_READONLY 1
#include "vertex_buffer.h"

#define GLOBAL_TEXTURES_DESC_SET_IDX 3
#include "global_textures.h"

#include "water.glsl"

float GetShadow(vec3 worldPos, out float distanceToWater)
{
	vec4 uvzShadow = global_ubo.shadow_map_VP * vec4(worldPos, 1);
	uvzShadow.x = uvzShadow.x * 0.5 + 0.5;
	uvzShadow.y = 0.5 - 0.5 * uvzShadow.y;

	float depthOpaque = textureLod(TEX_SHADOW_MAP, vec3(uvzShadow.xy, 0), 0).x;
	float depthWater = textureLod(TEX_SHADOW_MAP, vec3(uvzShadow.xy, 1), 0).x;

	distanceToWater = max(0, uvzShadow.z - depthWater) * global_ubo.shadow_map_depth_scale;

	return depthOpaque > uvzShadow.z ? 1 : 0;
}

float rand(ivec2 pos)
{
    int texnum = global_ubo.current_frame_idx & (NUM_BLUE_NOISE_TEX - 1);
    ivec2 texpos = pos & ivec2(BLUE_NOISE_RES - 1);
    float noise = texelFetch(TEX_BLUE_NOISE, ivec3(texpos, texnum), 0).r;
    return noise;
}

const float PI = 3.1415926535;

#define NORMALIZE_PHASE_FUNCTIONS 1

float ScatterPhase_HenyeyGreenstein(float cosa, float g)
{
#if NORMALIZE_PHASE_FUNCTIONS
	// "normalized" Henyey-Greenstein
	float g_sqr = g * g;
	float num = (1 - abs(g));
	float denom = sqrt(max(1 - 2 * g*cosa + g_sqr, 0));
	float frac = num / denom;
	float scale = g_sqr + (1 - g_sqr) / (4 * PI);
	return scale * (frac*frac*frac);
#else
	// Classic Henyey-Greenstein
	float k1 = (1.f - g * g);
	float k2 = (1.f + g * g - 2.f*g*cosa);
	return (1.f / (4.f*PI)) * k1 / pow(abs(k2), 1.5f);
#endif
}

float vmin(vec3 v) { return min(v.x, min(v.y, v.z)); }
float vmax(vec3 v) { return max(v.x, max(v.y, v.z)); }

bool IntersectRayBox(vec3 origin, vec3 direction, vec3 mins, vec3 maxs, out float tIn, out float tOut)
{
	vec3 t1 = (mins - origin) / direction;
	vec3 t2 = (maxs - origin) / direction;
	tIn = vmax(min(t1, t2));
	tOut = vmin(max(t1, t2));

	return tIn < tOut && tOut > 0;
}

#include "fog_medium.glsl"

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
void main()
{
	vec3 sun_color = sun_color_ubo.sun_color;

	// In fog mode 2 the medium is lit by the map's own lights, so an absent sun
	// is the normal case rather than a reason to bail - every rerelease map has
	// no sun at all. Only bail when there is nothing whatsoever to scatter.
	// Mode 2 no longer depends on there being any DYNAMIC lights - it reads the
	// cluster light list, which is populated on every map by the emissive
	// surfaces and the sky.
	bool fog_lights = (global_ubo.fog_enable != 0) && (global_ubo.fog_mode >= 2);

	// Whether the map's medium is given real, density-proportional extinction
	// this frame - see the note at extinction_factors below. Applies to BOTH fog
	// modes; the runaway it fixes is a property of the march, not of what lights it.
	bool fog_medium = (global_ubo.fog_enable != 0) && (global_ubo.pt_fog_extinction > 0.0);

	if(luminance(sun_color) == 0 && !fog_lights)
	{
		imageStore(IMG_GODRAYS_INTERMEDIATE, ivec2(gl_GlobalInvocationID.xy), vec4(0, 0, 0, 1));
		return;
	}
		
	ivec2 pixelPos = ivec2(gl_GlobalInvocationID.xy);
	ivec2 sourcePixelPos = pixelPos.xy * 2 + GetRotatedGridOffset(pixelPos.xy);

	if (sourcePixelPos.x >= global_ubo.pt_field_offset * 2 || sourcePixelPos.y >= global_ubo.height)
		return;

	if(push.pass_index != 0)
	{
		float view_depth = texelFetch(TEX_PT_VIEW_DEPTH_A, sourcePixelPos.xy, 0).x;
		if(view_depth >= 0)
		{
			return;
		}
	}

	vec4 position_material = texelFetch(TEX_PT_SHADING_POSITION, sourcePixelPos.xy, 0);
	vec3 surface_pos = position_material.xyz;
	uint material_id = floatBitsToUint(position_material.w);
	int medium = int((material_id & MATERIAL_LIGHT_STYLE_MASK) >> MATERIAL_LIGHT_STYLE_SHIFT);

	vec3 direction = texelFetch(TEX_PT_VIEW_DIRECTION, sourcePixelPos.xy, 0).xyz;

	// The light set for this ray. Written by the primary ray pass, which runs
	// before this one in the frame graph.
	// (the per-pixel cluster from TEX_PT_CLUSTER_A used to be read here; it is
	// what caused the seams, see the note at step_cluster below)

	vec4 throughput_distance = texelFetch(TEX_PT_GODRAYS_THROUGHPUT_DIST, sourcePixelPos.xy, 0);
	float distance = throughput_distance.w;

	vec3 original_pos = surface_pos - direction * distance;
	
	float cosa = dot(direction, global_ubo.sun_direction);
	float eccentricity = global_ubo.god_rays_eccentricity;

	// Map fog gets its own directionality, separate from the classic god rays.
	//
	// At cl_fog 1 the sun term below is the ONLY in-scatter there is - the
	// isotropic sky/local-light term is gated on fog_mode >= 2 - so the Henyey-
	// Greenstein lobe about the sun direction is the whole appearance. At the
	// gr_eccentricity default of 0.75 that lobe scatters 343x more looking into
	// the sun than away from it, which reads as "the fog is only there when I
	// look at the sun". Density cannot fix that: it multiplies both ends alike.
	//
	// gr_eccentricity is shared with the original campaign's god rays, where the
	// tight 0.75 lobe is exactly what makes a shaft through a window read as a
	// shaft. So this overrides it only where fog_enable says the map's own
	// atmospheric fog is what is being marched, and -1 means "leave it alone".
	//
	// Lowering it is a trade, not a free win - it lifts the off-axis fog and
	// lowers the on-axis peak at the same time. Relative to 0.75: 0.5 gives 6.6x
	// the away-from-sun fog for 0.52x the into-sun peak, 0.3 gives 14.6x for
	// 0.27x, and 0 is fully even at 45.7x for 0.13x. Put the overall strength
	// back with cl_fog_scale, which is direction-independent.
	if(global_ubo.fog_enable != 0 && global_ubo.pt_fog_eccentricity >= 0.0)
		eccentricity = min(global_ubo.pt_fog_eccentricity, 0.95);

	if(medium != MEDIUM_NONE)
		eccentricity = 0.5;
	float phase = ScatterPhase_HenyeyGreenstein(cosa, eccentricity);

	float offset = 0;

	float tIn, tOut;
	if (IntersectRayBox(
		original_pos,
		direction,
		global_ubo.world_center.xyz - global_ubo.world_size.xyz * 0.75, // matches the 'bounds' function in getDensity(...)
		global_ubo.world_center.xyz + global_ubo.world_size.xyz * 0.75,
		tIn, tOut))
	{	
		if (tIn > distance)
		{
			imageStore(IMG_GODRAYS_INTERMEDIATE, ivec2(gl_GlobalInvocationID.xy), vec4(0, 0, 0, 1));
			return;
		}

		offset = max(tIn, offset);
		distance = min(tOut, distance);
	}
	else
	{
		imageStore(IMG_GODRAYS_INTERMEDIATE, ivec2(gl_GlobalInvocationID.xy), vec4(0, 0, 0, 1));
		return;
	}

	vec3 currentPos = original_pos + direction * offset;
	float density = getDensity(currentPos);

	// EXTINCTION - the reason no single cl_fog_scale can serve both a small
	// chamber and an open vista.
	//
	// Air was a flat vec3(0.0001) here no matter how dense the map's fog
	// actually is, and god_rays_filter.comp composites the result purely
	// ADDITIVELY. Between them the medium never saturates: in-scatter is a raw
	// sum of stepLength * density * L over the march, so it grows LINEARLY with
	// how far the ray travels and has no upper bound at all. A 3000-unit canyon
	// accumulates roughly ten times what a 300-unit chamber does at identical
	// density and identical lighting. That is the "150 out by the rail carts,
	// 500 at the start" split on mgu1m1, and the density curve cannot close it
	// because the two areas differ by RAY LENGTH, which no density term sees.
	//
	// Real fog does not behave that way. It saturates: past a few optical depths
	// you see the medium's own colour and nothing more, however much further it
	// extends. Tying extinction to the actual density restores that - throughput
	// decays by exp(-stepLength * density * sigma) at the bottom of the march
	// loop, so the in-scatter it multiplies rolls off towards L_medium * (1 - T)
	// instead of running away. The vista then clamps at the map's own authored
	// fog colour, which frees cl_fog_scale to be raised until the enclosed areas
	// read properly without the open ones blowing out.
	//
	// 0 keeps the legacy flat 0.0001 byte for byte, so nothing moves until this
	// is set. Choose it from the range at which geometry should disappear: unity
	// optical depth at distance R under density d is sigma = 1 / (d * R).
	vec3 extinction_factors;
	if (medium != MEDIUM_NONE)
		extinction_factors = get_extinction_factors(medium);
	else if (fog_medium)
		extinction_factors = vec3(global_ubo.pt_fog_extinction);
	else
		extinction_factors = vec3(0.0001);

	vec3 throughput = throughput_distance.xyz;
	vec3 inscatter = vec3(0);

	// How much of what is BEHIND the fog survives it. Tracked separately from
	// `throughput`, which starts at the path tracer's own value rather than at 1,
	// and handed to god_rays_filter.comp in the alpha channel.
	float fog_transmittance = 1.0;

	// Local lights are accumulated separately because the sun contribution below
	// is multiplied by sun_color at the end, and these must not be.
	vec3 localInscatter = vec3(0);
	int step_index = 0;

	offset += getStep(offset, density) * (rand(pixelPos.xy) - 1);

	while(true)
	{
		float density = getDensity(currentPos);
		float stepLength = getStep(offset, density);

		offset += stepLength;

		if (offset >= distance)
			break;

		currentPos = original_pos + direction * offset;
		step_index++;

		if (fog_lights && density > 0)
		{
			// WHICH light list this point belongs to - the CAMERA's cluster, for
			// the whole ray, deliberately.
			//
			// Two earlier attempts both produced hard lines across the fog.
			// Using the per-pixel surface cluster meant neighbouring pixels
			// looking at different rooms sampled different light sets, so every
			// depth discontinuity became a visible seam - and the sky term made
			// it worse, since a cluster either has sky or it does not, with no
			// in-between. Switching between the camera's cluster and the
			// surface's at the ray midpoint added a THIRD seam, because the
			// midpoint moves with the surface depth and so jumps between
			// adjacent pixels.
			//
			// The camera cluster is uniform across the whole screen, so it
			// cannot produce a spatial seam at all. It is correct near the
			// player - which is where fog is most visible - and wrong for
			// distant fog, but wrong-and-smooth reads far better than
			// right-and-banded. The cost is a pop when the player crosses a
			// cluster boundary.
			//
			// The real fix for both is a light list per march point, which is
			// what a froxel grid provides.
			uint step_cluster = (global_ubo.fog_camera_cluster < 0)
			                  ? ~0u : uint(global_ubo.fog_camera_cluster);

			// Isotropic, not Henyey-Greenstein: HG here is oriented about the SUN
			// direction, which means nothing for a lamp off to one side. Fog lit
			// by a nearby point light scatters essentially evenly.
			const float isotropic_phase = FOG_ISOTROPIC_PHASE;

			float r = rand(ivec2(pixelPos.xy) + ivec2(step_index * 17, step_index * 31));

			localInscatter += (isotropic_phase * stepLength * density) * throughput
			                * getFogColor(currentPos)
			                * getClusterLightInscatter(step_cluster, currentPos, r);
		}

		const vec3 shadowBias = -global_ubo.sun_direction * 20;
		float distanceToWater;
		float shadow = GetShadow(currentPos + shadowBias, distanceToWater);

		// AMBIENT IN SHADOW.
		//
		// `shadow` is a binary shadow-map lookup, so at cl_fog 1 - where the sun
		// term is the ONLY term - a march point the sun cannot reach contributes
		// exactly zero. That is the cliff behind "mgu1m1 needs cl_fog_scale 500
		// at the start and 150 out by the rail carts": the enclosed start is
		// almost wholly in the sun's shadow, so nearly every step there is
		// multiplied by zero and the only way to get any fog at all is to crank
		// the scale until a handful of lit steps carry the whole look.
		// Multiplying zero by a larger number does not produce fog.
		//
		// Fog in shadow is not black in reality - it is lit by the sky and by
		// multiple scattering, which is the same quantity these maps' authors
		// wrote into worldspawn as _sunlight2 (mgu1m1: 300, a dull red-violet).
		// This puts that floor back as a fraction of the sun's radiance,
		// scattered ISOTROPICALLY rather than through the sun-oriented
		// Henyey-Greenstein lobe, because skylight has no preferred direction -
		// and so it does not fight gr_eccentricity / pt_fog_eccentricity, which
		// stay in charge of how tight the sunlit shafts are.
		//
		// This is what actually lets one cl_fog_scale cover both areas. With a
		// floor under the shadowed volume the two differ only by ray length and
		// by height in the fog band, and the extinction above handles the first.
		// 0 restores the hard cliff exactly.
		float scatter = shadow * phase;
		if (global_ubo.pt_fog_ambient > 0.0)
			scatter += (1.0 - shadow) * global_ubo.pt_fog_ambient * FOG_ISOTROPIC_PHASE;

		vec3 differentialInscatter = (scatter * stepLength * density) * throughput;
		if(medium != MEDIUM_NONE)
		{
			differentialInscatter *= exp(-extinction_factors * distanceToWater);
		}

		// Tint by the map's own fog colour. This is applied per step rather than
		// once at the end because the height fog is a gradient - the colour at
		// the bottom of the band differs from the colour at the top - so a single
		// tint on the accumulated result would lose exactly the variation the
		// map author was going for. Treated as a scattering albedo, which is what
		// "the colour the fog appears" physically means.
		differentialInscatter *= getFogColor(currentPos);

		inscatter += differentialInscatter;
		throughput *= exp(-(stepLength * density) * extinction_factors);

		if (fog_medium)
		{
			fog_transmittance *= exp(-(stepLength * density) * global_ubo.pt_fog_extinction);

			// Once the medium is this opaque nothing further along the ray can be
			// seen, and `throughput` has decayed by the same factor, so every
			// remaining step contributes nothing. Worth an explicit break: at the
			// large cl_fog_scale values these maps need, getStep is already pinned
			// at its 1-unit minimum, so a vista ray is thousands of steps.
			if (fog_transmittance < 0.003)
				break;
		}
	}

	vec3 inscatterColor = inscatter * sun_color_ubo.sun_color * global_ubo.god_rays_intensity * 0.0001;

	// The local-light half carries its own radiance already, so it is added
	// after the sun tint rather than being folded into it.
	//
	// The constant here is NOT the sun path's 0.0001, which is what this had at
	// first and it made the whole term invisible. That factor exists to bring
	// SUN radiance down - sun_color is of order 1e4. A model light's colour is
	// dlight_intensity/25 (main.c add_dlights), i.e. order 1e1..1e2, so reusing
	// 0.0001 left the result around 1e-5: the pass ran and cost frame time while
	// producing nothing visible, which is exactly what Matt saw.
	// 0.005, not the 0.05 this had before the triangle area was folded in - a
	// light panel is hundreds of square units, so including area raised the whole
	// term by roughly two orders of magnitude. This constant only puts the light
	// buffer's radiance*area units in the same range as the sun term; the knob
	// for taste is pt_fog_light_scale.
	if (fog_lights)
		inscatterColor += localInscatter * global_ubo.pt_fog_light_scale * 0.005;

	if(medium != MEDIUM_NONE)
		inscatterColor *= global_ubo.pt_water_density * 30;
	
	vec4 prevColor;

	if(push.pass_index != 0)
		prevColor = imageLoad(IMG_GODRAYS_INTERMEDIATE, ivec2(gl_GlobalInvocationID.xy));
	else
		prevColor = vec4(0);

	// Alpha carries the medium's transmittance to god_rays_filter.comp, which
	// uses it to fade what is behind the fog. Nothing read this channel before.
	// A later pass multiplies into what the first wrote, because it continues the
	// same view ray on through a reflection or a refraction.
	float prev_transmittance = (push.pass_index != 0) ? prevColor.a : 1.0;
	vec4 outputColor = vec4(inscatterColor + prevColor.rgb, prev_transmittance * fog_transmittance);

	imageStore(IMG_GODRAYS_INTERMEDIATE, ivec2(gl_GlobalInvocationID.xy), outputColor);
}
