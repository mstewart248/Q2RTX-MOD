// ========================================================================== //
// This rgen shader computes direct lighting for the first opaque surface. 
// The parameters of that surface are loaded from the G-buffer, stored there
// previously by the `primary_rays.rgen` and `reflect_refract.rgen` shaders.
//
// See `path_tracer.h` for an overview of the path tracer.
// ========================================================================== //

#version 460
#extension GL_GOOGLE_include_directive    : enable
#extension GL_EXT_debug_printf : enable
#extension GL_KHR_shader_subgroup_arithmetic : require

#pragma optionNV(unroll all)

#define ENABLE_SHADOW_CAUSTICS
#include "restir.h"
#include "projection.glsl"

layout(constant_id = 0) const uint spec_enable_caustics = 0;



void
direct_lighting_restir(ivec2 ipos, bool is_odd_checkerboard, out vec3 high_freq, out vec3 o_specular)
{
	high_freq = vec3(0);
	o_specular = vec3(0);

	rng_seed = texelFetch(TEX_ASVGF_RNG_SEED_A, ipos, 0).r;

	vec3 direct_diffuse, direct_specular;
	float vis;

	Reservoir r, prev_r, spatial_r;
	prev_r.W = 0;

	// Diagnostics for pt_restir_debug 24 / 25 - see the debug block below.
	float dbg_w_fresh = 0.0;
	float dbg_W_fresh = 0.0;

	vec4 position_material = texelFetch(TEX_PT_SHADING_POSITION, ipos, 0);

	vec3 position   = position_material.xyz;
	uint material_id = floatBitsToUint(position_material.w);
		
	// don't compute lighting for invalid surfaces
	if(material_id == 0)
	{
		imageStore(IMG_PT_RESTIR_ID_A, ipos, uvec4(RESTIR_INVALID_ID));
		return;
	}

	vec4 view_direction = texelFetch(TEX_PT_VIEW_DIRECTION, ipos, 0);
	vec3 normal = decode_normal(texelFetch(TEX_PT_NORMAL_A, ipos, 0).x);
	vec3 geo_normal = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_A, ipos, 0).x);
	vec4 primary_base_color = texelFetch(TEX_PT_BASE_COLOR_A, ipos, 0);
	float primary_specular_factor = primary_base_color.a;
	vec2 metal_rough = texelFetch(TEX_PT_METALLIC_A, ipos, 0).xy;
	float primary_metallic = metal_rough.x;
	float primary_roughness = metal_rough.y;
	uint cluster_idx = texelFetch(TEX_PT_CLUSTER_A, ipos, 0).x;
	if(cluster_idx == 0xffff) cluster_idx = ~0u; // because the image is uint16
	float view_depth =  texelFetch(TEX_PT_VIEW_DEPTH_A, ipos, 0).x;
	vec4 motion = texelFetch(TEX_PT_MOTION, ipos, 0);

	bool primary_is_weapon = (material_id & MATERIAL_FLAG_WEAPON) != 0;
	int primary_medium = int((material_id & MATERIAL_LIGHT_STYLE_MASK) >> MATERIAL_LIGHT_STYLE_SHIFT);

	bool use_shadow_rays = true;
	ivec2 ipos_r = ipos;
	
	if(global_ubo.pt_restir == 2)
	{
		ipos_r.y >>= 1;
		use_shadow_rays = (ipos.x & 1) == (ipos.y & 1);
	} 
	else if(global_ubo.pt_restir == 3)
	{
		ipos_r >>= 1;
		use_shadow_rays = (ipos.x & 1) == 0 && (ipos.y & 1) == 0;
	}

	int shadow_cull_mask = SHADOW_RAY_CULL_MASK;

	if(global_ubo.first_person_model != 0 && !primary_is_weapon)
		shadow_cull_mask |= AS_FLAG_VIEWER_MODELS;
	else
		shadow_cull_mask |= AS_FLAG_VIEWER_WEAPON;

	float direct_specular_weight = smoothstep(
		global_ubo.pt_direct_roughness_threshold - 0.02,
		global_ubo.pt_direct_roughness_threshold + 0.02,
		primary_roughness);

	vec3 primary_albedo, primary_base_reflectivity;
	get_reflectivity(primary_base_color.rgb, primary_metallic, primary_albedo, primary_base_reflectivity);
    
	float alpha = square(primary_roughness);
	float phong_exp = RoughnessSquareToSpecPower(alpha);
	float phong_scale = min(100, 1 / (M_PI * square(alpha)));
	float phong_weight = clamp(primary_specular_factor * luminance(primary_base_reflectivity) / (luminance(primary_base_reflectivity) + luminance(primary_albedo)), 0, 0.9);
    
	int field_left = 0;
	int field_right = global_ubo.pt_prev_field_offset;
	if(ipos.x >= global_ubo.pt_field_offset)
	{
		field_left = field_right;
		field_right = global_ubo.pt_prev_field_offset * 2;
	}
	
	//Do temporal
	// A field pixel spans 2 screen pixels horizontally when checkerboarded, 1 when the
	// fields are full-resolution layers; the motion vector is full-screen normalized
	// either way. The old hard-coded inv_width * 2 applied only HALF the horizontal
	// motion in split-field mode, so the depth test rejected the reservoir and ReSTIR
	// lost its history on every horizontal turn. Same fix as asvgf_temporal.comp.
	float field_scale_x = (global_ubo.pt_fullres_fields != 0) ? 1.0 : 2.0;
	ivec2 pos_prev = ivec2(((vec2(ipos) + vec2(0.5)) * vec2(global_ubo.inv_width * field_scale_x, global_ubo.inv_height) + motion.xy) * vec2(global_ubo.pt_prev_field_offset, global_ubo.prev_height));

	// Permutation sampling. Without this every pixel reuses the reservoir at exactly its
	// own reprojected position every frame, so neighbouring pixels end up sharing light
	// samples. That correlation is what DLSS-RR is documented not to tolerate - RR guide
	// 3.5: "RR assumes independent samples, which is violated by ReSTIR temporal and
	// spatial reuse", with permutation sampling given as the mitigation. Rotating which
	// neighbour's reservoir a pixel reuses each frame breaks the correlation up.
	//
	// Applied to pos_prev before the reduced-resolution derivation below, so the depth and
	// normal rejection tests validate the same pixel the reservoir is taken from. Permuting
	// only the reservoir fetch would reuse reservoirs across geometric discontinuities and
	// trade blotches for fireflies.
	if(global_ubo.pt_restir_permutation != 0)
	{
		ivec2 perm_offset = ivec2(global_ubo.current_frame_idx & 3, (global_ubo.current_frame_idx >> 2) & 3);
		ivec2 permuted = pos_prev + perm_offset;
		permuted.x ^= 3;
		permuted.y ^= 3;
		permuted -= perm_offset;

		// Keep the original position if the permuted one leaves the field or the screen -
		// the bounds test below would otherwise reject the reuse entirely.
		if(permuted.x >= field_left && permuted.x < field_right
			&& permuted.y >= 0 && permuted.y < global_ubo.height)
			pos_prev = permuted;
	}
	ivec2 pos_prev_r = pos_prev;
	
	if(global_ubo.pt_restir == 2) 
	{
		pos_prev.x = (pos_prev.x & ~1) + (pos_prev.y & 1); 
		pos_prev_r = pos_prev;
		pos_prev_r.y >>= 1;
	}
	else if(global_ubo.pt_restir == 3) 
	{
		pos_prev &= ~1;
		pos_prev_r >>= 1;
	}
	
	if (!(pos_prev.x < field_left || pos_prev.x >= field_right || pos_prev.y < 0 || pos_prev.y >= global_ubo.height))
	{
		uint prev_idx = texelFetch(TEX_PT_RESTIR_ID_B, pos_prev_r, 0).x;

		prev_idx = get_light_current_idx(prev_idx);
		
		if(prev_idx != RESTIR_INVALID_ID)
		{
			float depth_prev = texelFetch(TEX_PT_VIEW_DEPTH_B, pos_prev, 0).x;
			float dist_depth = abs(depth_prev - view_depth) / abs(view_depth);
			
			if(dist_depth < 0.1)
			{
				
				vec3 normal_prev;
				float dot_normals;
				
				if(use_shadow_rays)
				{
					normal_prev = decode_normal(texelFetch(TEX_PT_NORMAL_B, pos_prev, 0).x);
					dot_normals = dot(normal_prev, normal);
				}
				else
				{
					dot_normals = 1.0f;
				}
				if(dot_normals > 0.9)
				{
					uvec4 packed_reservoir = texelFetch(TEX_PT_RESTIR_B, pos_prev_r, 0);
					unpack_reservoir(packed_reservoir, prev_idx, prev_r);
					prev_r.p_hat = get_unshadowed_path_contrib(prev_r.y, position, normal, view_direction.xyz, phong_exp, phong_scale, phong_weight, prev_r.y_pos);                    
				}
			}
		}
	}

	//Sample lights
	if(use_shadow_rays)
	{
		get_direct_illumination_restir(
			position,
			normal,
			cluster_idx,
			view_direction.xyz,
			phong_exp,
			phong_scale,
			phong_weight,
			0,
			prev_r,
			r,
			dbg_w_fresh,
			dbg_W_fresh);
	}
	else
	{
		r = prev_r;
	}

    //Spatio-temporal
	if(global_ubo.pt_restir_spatial != 0)
	{
		float rng = get_rng(RNG_RESTIR_SP_LIGHT_SELECTION(0));
		uint processed = 0;
		ivec2 sample_pos;
		Reservoir st_r;
		init_reservoir(spatial_r);
		
		vec2 rng_pos = vec2(get_rng(RNG_RESTIR_SPATIAL_X(0)), get_rng(RNG_RESTIR_SPATIAL_Y(0)));

		// Pairwise MIS state. mis_k is the number of neighbours the weights are shared
		// out over - the target count, not the tap budget, so neighbours that are never
		// reached fall back to the canonical sample rather than vanishing.
		float mis_k = max(1.0, float(global_ubo.pt_restir_spatial));
		float mis_canonical = 0.0;
		int distance = use_shadow_rays ? RESTIR_SPACIAL_DISTANCE : 2;
		int samples = min(RESTIR_SPACIAL_SAMPLES, int(global_ubo.pt_restir_spatial) * 2);
		ivec2 pos;
		#pragma unroll
		for(int i=0; i < samples ; i++)
		{
			pos = ivec2(ceil(sample_disk(rng_pos) * distance));
			
			if(i == 4) distance *= 2;
			
			rng_pos = rng_pos * 10 - floor(rng_pos * 10);
			
			sample_pos.x = clamp(pos_prev.x + pos.x, field_left, field_right - 1);
			sample_pos.y = clamp(pos_prev.y + pos.y, 0, int(global_ubo.height - 1));
			ivec2 sample_pos_r = sample_pos;
				
			if(global_ubo.pt_restir == 2) 
			{
				sample_pos.x = min((sample_pos.x & ~1) + (sample_pos.y & 1), field_right - 1);
				sample_pos_r = sample_pos;
				sample_pos_r.y >>= 1;
			}
			else if(global_ubo.pt_restir == 3) 
			{
				sample_pos &= ~1;
				sample_pos_r >>= 1;
			}
			
			uint str_idx = texelFetch(TEX_PT_RESTIR_ID_B, sample_pos_r, 0).x;
			str_idx = get_light_current_idx(str_idx);
			
			if(str_idx == RESTIR_INVALID_ID) continue;
			
			float depth_prev = texelFetch(TEX_PT_VIEW_DEPTH_B, sample_pos, 0).x;
			float dist_depth = abs(depth_prev - view_depth) / abs(view_depth);
			
			if(dist_depth < 0.1)
			{
			
				vec3 normal_prev;
				float dot_normals;
				
				if(use_shadow_rays)
				{
					normal_prev = decode_normal(texelFetch(TEX_PT_NORMAL_B, sample_pos, 0).x);
					dot_normals = dot(normal_prev, normal);
				}
				else
				{
					dot_normals = 1.0f;
				}
				
				if(dot_normals > 0.9)
				{
					uvec4 packed_reservoir = texelFetch(TEX_PT_RESTIR_B, sample_pos_r, 0);
					unpack_reservoir(packed_reservoir, str_idx, st_r);

					// Skip a neighbour that carries no sample. It stored W == 0 because its
					// own shadow ray was occluded, which says nothing about visibility here,
					// and unpack_reservoir hands back a fabricated M of RESTIR_M_CLAMP
					// regardless. Combining it added 0 to w_sum but M-1 to the sample count,
					// so W = w_sum / (p_hat * M) was diluted by every shadowed neighbour -
					// which drained roughly half the energy out of sunlit pixels along a
					// shadow boundary and made the sun visibly fade in as reuse accumulated.
					// The temporal combine in restir.h already guards this way
					// ("prev_r.W > 0.0"); the spatial loop simply never did.
					if(st_r.W <= 0.0) {
						continue;
					}

					// The neighbour's sample, evaluated in *this* pixel's domain.
					float p_hat = get_unshadowed_path_contrib(st_r.y, position, normal, view_direction.xyz, phong_exp, phong_scale, phong_weight, st_r.y_pos);

					if(global_ubo.pt_restir_pairwise != 0)
					{
						RestirSurface ns = load_neighbour_surface(sample_pos, position, view_direction.xyz);

						float m_n = float(st_r.M) * mis_k;  // samples the neighbour's domain stands for

						// A canonical reservoir that selected nothing still carries
						// M == RESTIR_SAMPLING_M: get_direct_illumination_restir counts every
						// candidate it looked at, even when all of them had zero weight. Feeding
						// that M in as a domain size would hand a share of the MIS weight to a
						// strategy that has no sample to spend it on - the neighbours get scaled
						// down and the canonical's share is then dropped by the guarded stream
						// below, so the energy simply vanishes. Report an empty canonical as a
						// zero-size domain instead, which makes pairwise_mis_weight hand the
						// neighbours a full weight of 1.
						bool canonical_valid = r.y != RESTIR_INVALID_ID && r.p_hat > 0.0 && r.W > 0.0;
						float m_c = canonical_valid ? float(r.M) : 0.0;

						// Stream the neighbour's sample with the share of it that belongs
						// to the neighbour's domain. A sample this surface could not have
						// produced gets ~0 here instead of diluting a running count.
						if(p_hat > 0.0)
						{
							float p_hat_n = eval_target_at(st_r.y, st_r.y_pos, ns);
							float mis_n = pairwise_mis_weight(p_hat_n, p_hat, m_n, m_c);
							if(mis_n > 0.0)
								update_reservoir(st_r.y, p_hat * mis_n * st_r.W, st_r.y_pos, p_hat, rng, spatial_r);
						}

						// The canonical sample's share against this same neighbour. Summed
						// over the neighbours and normalised after the loop, this becomes
						// the canonical sample's own MIS weight.
						if(canonical_valid)
						{
							float p_hat_c_at_n = eval_target_at(r.y, r.y_pos, ns);
							mis_canonical += 1.0 - pairwise_mis_weight(p_hat_c_at_n, r.p_hat, m_n, m_c);
						}
						else
							mis_canonical += 1.0;

						processed ++;
						if(global_ubo.pt_restir_spatial == processed) break;
						continue;
					}

					if(p_hat <= 0.0) {
						continue;
					}
					
					//Combine reservoirs
					update_reservoir(st_r.y, p_hat * st_r.W * st_r.M, st_r.y_pos, p_hat, rng, spatial_r);
					spatial_r.M += st_r.M - 1;
					processed ++;
					if(global_ubo.pt_restir_spatial == processed) break;
				}
			}
			
		}

		if(global_ubo.pt_restir_pairwise != 0)
		{
			// Neighbours that were never streamed - rejected by the depth, normal or
			// weight tests, or simply not reached - hand their whole share back to the
			// canonical sample, which keeps the weights summing to one.
			mis_canonical += mis_k - float(processed);
			mis_canonical /= mis_k;

			// Stream the canonical sample last, with the weight accumulated above.
			if(r.y != RESTIR_INVALID_ID && r.W > 0.0 && r.p_hat > 0.0 && mis_canonical > 0.0)
				update_reservoir(r.y, r.p_hat * mis_canonical * r.W, r.y_pos, r.p_hat, rng, spatial_r);

			// The MIS weights already sum to one, so the estimate normalises with no
			// division by M. That missing division is the entire bug fix: M no longer
			// has to mean "samples that contributed weight" for the result to be right.
			// M is carried over from the canonical reservoir purely so the storage
			// rescale below and next frame's temporal clamp keep working.
			spatial_r.M = r.M;
			spatial_r.W = spatial_r.p_hat > 0.0 ? spatial_r.w_sum / spatial_r.p_hat : 0.0;
			if(isnan(spatial_r.W) || isinf(spatial_r.W)) spatial_r.W = 0.0;
			r = spatial_r;
		}
		else if(spatial_r.w_sum != 0)
		{
			//Combine with the other reservoir
			if(r.W != 0)
			{            
				update_reservoir(spatial_r.y, spatial_r.w_sum, spatial_r.y_pos, spatial_r.p_hat, rng, r);
				r.M += spatial_r.M - 1;      
				r.W = r.w_sum / (r.p_hat * r.M);
			}
			else
			{
				spatial_r.W = (spatial_r.w_sum ) / (spatial_r.p_hat * spatial_r.M);
				r = spatial_r;
			}
		}
	}

	// ---- Boiling filter ---------------------------------------------------------
	//
	// pt_restir_boiling is the threshold itself, as a multiple of the local average;
	// 0 disables. (It used to be keyed off pt_restir 4 / 5 / 6 = 8x / 4x / 16x, because
	// adding a UBO scalar was thought to shift every later member. The cvar list is the
	// last thing in global_ubo and is documented there as not vec4-aligned, so appending
	// floats to it is safe - check_ubo.py still reports 72 members / 448 bytes.)
	//
	// This is the RTXDI_BoilingFilter equivalent, and it is the piece this port is
	// missing relative to RTXDI (which is what RTX Remix uses - hence no boiling there).
	// Without it a reservoir whose weight greatly exceeds its neighbourhood keeps being
	// handed to neighbours by spatial reuse and to itself by temporal reuse, so it
	// self-reinforces and drifts: light and shadow visibly crawling around in motion.
	//
	// The subgroup stands in for RTXDI's tile: lanes of a ray-generation shader cover a
	// small 2D block of pixels, so the subgroup mean is a local spatial mean. Inactive
	// lanes (pixels that returned early) simply do not contribute, which is fine.
	if(global_ubo.pt_restir_boiling > 0.0)
	{
		float threshold = global_ubo.pt_restir_boiling;

		float w_sum_sg = subgroupAdd(r.W);
		float w_cnt_sg = subgroupAdd(r.W > 0.0 ? 1.0 : 0.0);
		float w_avg = w_cnt_sg > 0.0 ? w_sum_sg / w_cnt_sg : 0.0;

		if(w_avg > 0.0 && r.W > w_avg * threshold)
			r.W = 0.0;
	}
	// -----------------------------------------------------------------------------

	if(r.W != 0.0f)
	{
		process_selected_light_restir(
			r.y,
			r.y_pos,
			r.W,
			position,
			normal,
			geo_normal,
			shadow_cull_mask,
			view_direction.xyz,
			primary_base_reflectivity,
			primary_specular_factor,
			primary_roughness,
			primary_medium,
			spec_enable_caustics != 0,
			direct_specular_weight,
			phong_exp,
			phong_scale,
			phong_weight,
			use_shadow_rays,
			cluster_idx,
			direct_diffuse,
			direct_specular,
			vis);

		
		high_freq += direct_diffuse;
		o_specular += direct_specular;                
		if(vis == 0.0f) r.W = 0.0f;


	}

	// Captured before the rescale below, so view 13 shows the w_sum that actually
	// produced W = w_sum / (p_hat * M) this frame rather than the value stored for
	// the next one.
	float dbg_w_sum = r.w_sum;

	//Normalize reservoir
	// Must match the M unpack_reservoir fabricates next frame, or the stored w_sum is
	// rescaled to a history length the reader does not use.
	float m_clamp = global_ubo.pt_restir != 3 ? max(1.0, global_ubo.pt_restir_m_clamp) : float(RESTIR_M_VC_CLAMP);
	r.w_sum = (m_clamp * r.w_sum) / r.M;

	// ---- ReSTIR reservoir debug views -------------------------------------------
	// Instrumentation for the "sun fades out after a camera turn" bug. Now on its own
	// cvar, pt_restir_debug, keeping the numbering the pt_restir 10..26 views used so
	// existing notes still apply. Setting it no longer disturbs the sampling mode, so
	// the views can be read while pt_restir 2 / 3 or pt_restir_pairwise are active.
	//
	//   pt_restir_debug 10 - which light the reservoir holds:
	//                    green = the sun, blue = a polygon light, red = no reservoir
	//   pt_restir_debug 11 - log2(W) in quantised colour bands (see ramp below)
	//   pt_restir_debug 12 - M, banded: black 0, then blue/cyan/green/yellow/red as it grows
	//   pt_restir_debug 13 - w_sum, same log2 ramp as view 11
	//   pt_restir_debug 14 - p_hat of the selected sample, same log2 ramp
	//
	// Run with: pt_dlss 0, flt_enable 0, flt_fixed_albedo 1, pt_num_bounce_rays 0
	// so the bands are not multiplied by surface albedo or diluted by indirect light.
	int restir_debug = int(global_ubo.pt_restir_debug) - 10;
	if(restir_debug >= 0)
	{
		vec3 dbg = vec3(0);
		if(restir_debug == 0)
		{
			if(r.W <= 0.0 || r.y == RESTIR_INVALID_ID) dbg = vec3(1, 0, 0);
			else if(r.y == RESTIR_ENV_ID)              dbg = vec3(0, 1, 0);
			else                                       dbg = vec3(0, 0, 1);
		}
		else if(restir_debug == 1)
		{
			// log2(W) banded: each band is one power of two, so a decay of W shows up
			// as the colour marching down the ramp rather than as a subtle dimming.
			if(r.W <= 0.0) dbg = vec3(0);
			else
			{
				float e = clamp(floor(log2(r.W)) + 4.0, 0.0, 7.0);
				if(e < 1)      dbg = vec3(0.1, 0.0, 0.3);
				else if(e < 2) dbg = vec3(0.0, 0.0, 1.0);
				else if(e < 3) dbg = vec3(0.0, 1.0, 1.0);
				else if(e < 4) dbg = vec3(0.0, 1.0, 0.0);
				else if(e < 5) dbg = vec3(1.0, 1.0, 0.0);
				else if(e < 6) dbg = vec3(1.0, 0.5, 0.0);
				else           dbg = vec3(1.0, 0.0, 0.0);
			}
		}
		else if(restir_debug == 3 || restir_debug == 4)
		{
			// The two remaining unknowns in W = w_sum / (p_hat * M). Same one-band-per-
			// power-of-two ramp as view 11 so the three are directly comparable.
			float v = (restir_debug == 3) ? dbg_w_sum : r.p_hat;
			if(v <= 0.0) dbg = vec3(0);
			else
			{
				float e = clamp(floor(log2(v)) + 4.0, 0.0, 7.0);
				if(e < 1)      dbg = vec3(0.1, 0.0, 0.3);
				else if(e < 2) dbg = vec3(0.0, 0.0, 1.0);
				else if(e < 3) dbg = vec3(0.0, 1.0, 1.0);
				else if(e < 4) dbg = vec3(0.0, 1.0, 0.0);
				else if(e < 5) dbg = vec3(1.0, 1.0, 0.0);
				else if(e < 6) dbg = vec3(1.0, 0.5, 0.0);
				else           dbg = vec3(1.0, 0.0, 0.0);
			}
		}
		else if(restir_debug == 16)
		{
			// pt_restir_debug 26 - half-float overflow flag.
			//
			// pack_reservoir stores W and w_sum with packHalf2x16, whose maximum is
			// 65504, and unpack_reservoir zeroes W outright on isinf. Any pixel whose
			// reservoir exceeds that silently loses its entire history on the very next
			// frame. R = 1 marks such a pixel, so the mean of R over a region is
			// directly the fraction of pixels being discarded that way.
			//
			// Note this is a sibling branch, not an early return: the reservoir stores
			// at the end of this function must still run, or there would be no history
			// for the very thing being measured.
			bool overflow = isinf(r.W) || isinf(r.w_sum)
				|| r.W > 65504.0 || r.w_sum > 65504.0;
			dbg = vec3(overflow ? 1.0 : 0.0, 1.0, 0.0);
			if(global_ubo.tm_enable == 0)
				dbg /= float(STORAGE_SCALE_HDR);
		}
		else if(restir_debug >= 10)
		{
			// Continuous encodings (pt_restir_debug 20..23). The banded views above quantise to
			// one colour per power of two AND saturate at W >= 4, so they can show that
			// the fade happened but not how big it is. These encode the value itself so
			// it can be read back off a screenshot to about 0.1 stop:
			//
			//   pt_restir_debug 20 - W        R = (log2(v) + 20) / 48, covering 2^-20 .. 2^28
			//   pt_restir_debug 21 - M        G = 1 marks a valid sample, G = 0 means none
			//   pt_restir_debug 22 - w_sum    decode: v = 2^(R * 48 - 20)
			//
			// The range is deliberately far wider than the values look like they need:
			// the fresh-candidate weights are extremely heavy-tailed (mean/median ~4e4),
			// and an encoding that clips the tail hides exactly the part that carries
			// most of the energy.
			//   pt_restir_debug 23 - p_hat
			//   pt_restir_debug 24 - w_sum from the fresh candidates only, before any reuse
			//   pt_restir 25 - W the fresh candidates alone would have produced this
			//                  frame. Comparing 25 against 20 at a settled camera
			//                  measures the reuse bias directly, with no transient
			//                  and no timing involved.
			//
			// Read these with bloom_enable 0 and gr_enable 0 on top of the usual
			// pt_dlss 0 / flt_enable 0 / tm_enable 0 / flt_fixed_albedo 1: bloom and god
			// rays both composite over the image and would corrupt the encoded value.
			float v;
			if(restir_debug == 10)      v = r.W;
			else if(restir_debug == 11) v = float(r.M);
			else if(restir_debug == 12) v = dbg_w_sum;
			else if(restir_debug == 13) v = r.p_hat;
			else if(restir_debug == 14) v = dbg_w_fresh;
			else                        v = dbg_W_fresh;

			if(v > 0.0 && !isnan(v) && !isinf(v))
				dbg = vec3(clamp((log2(v) + 20.0) / 48.0, 0.0, 1.0), 1.0, 0.0);
			else
				dbg = vec3(0.0);

			// compositing.comp scales the whole frame by STORAGE_SCALE_HDR, and the only
			// thing that divides it back out is tone_mapping_apply.comp - a pass that
			// tm_enable 0 skips entirely on the CPU side (main.c). So with tone mapping
			// off the image reaching the swap chain is 128x overbright and everything
			// above 1/128 is clipped to white, which silently destroys any encoded value
			// (and collapses the orange and yellow bands of the views above into one).
			// These views are meant to be read with tm_enable 0, so cancel it here.
			if(global_ubo.tm_enable == 0)
				dbg /= float(STORAGE_SCALE_HDR);
		}
		else
		{
			float m = float(r.M);
			if(m <= 0)       dbg = vec3(0);
			else if(m <= 8)  dbg = vec3(0.0, 0.0, 1.0);
			else if(m <= 40) dbg = vec3(0.0, 1.0, 1.0);
			else if(m <= 80) dbg = vec3(0.0, 1.0, 0.0);
			else if(m <= 160)dbg = vec3(1.0, 1.0, 0.0);
			else             dbg = vec3(1.0, 0.0, 0.0);
		}
		high_freq = dbg;
		o_specular = vec3(0);
	}
	// ------------------------------------------------------------------------------

	o_specular = demodulate_specular(primary_base_reflectivity, o_specular);

	high_freq = clamp_output(high_freq);
	o_specular = clamp_output(o_specular);

	// DLSS-RR guide buffers.
	//
	// These must all describe the SAME surface. reflect_refract.rgen replaces the
	// primary surface with the reflected/refracted hit, and this shader runs after it,
	// so every channel written here describes that post-reflect_refract surface.
	// Roughness / metallic / diffuse albedo used to be left to primary_rays.rgen, which
	// meant a glass pixel handed RR the glass's roughness and albedo together with the
	// reflected surface's normal - an inconsistent G-buffer that RR cannot denoise.
	//
	// Written unconditionally: a zero normal is not valid RR input (guide 3.4.3 requires
	// normalized shading normals), so pixels with no valid reservoir must still get one.
	// A chrome model (the viewer weapon) already had the DLSS-RR guides written from the
	// mirror surface itself by reflect_refract.rgen, which is what RR wants for a mirror.
	// Everything below describes the reflected surface, so it must not overwrite them.
	bool mirror_model_guides = (int(view_direction.w) & CHECKERBOARD_FLAG_MIRROR_MODEL) != 0;

	imageStore(IMG_PT_SPECULAR, ipos, vec4(primary_specular_factor, 0, 0, 0));
	if(!mirror_model_guides)
	{
		imageStore(IMG_PT_NORMAL, ipos, vec4(normal, 0));
		imageStore(IMG_PT_MATERIALID, ipos, vec4(material_id, 0, 0, 0));
		imageStore(IMG_PT_ALBEDO, ipos, vec4(primary_albedo, 0));
		imageStore(IMG_PT_ROUGHNESS, ipos, vec4(primary_roughness));
		imageStore(IMG_PT_METALLIC, ipos, vec4(primary_metallic));

		// Specular albedo takes the specular reflectance (F0), not the diffuse albedo -
		// see the Specular Albedo Calculation appendix of the RR integration guide.
		imageStore(IMG_PT_SPECULAR_ALBEDO, ipos, vec4(EnvBRDFApprox2(primary_base_reflectivity, alpha, dot(normal, view_direction.xyz) ), 0));
	}

	if(use_shadow_rays)
	{
		imageStore(IMG_PT_RESTIR_ID_A, ipos_r, uvec4(r.W == 0.0f ? RESTIR_INVALID_ID : r.y));
		imageStore(IMG_PT_RESTIR_A, ipos_r, uvec4(pack_reservoir(r)));	
	}
}





void
direct_lighting(ivec2 ipos, bool is_odd_checkerboard, out vec3 high_freq, out vec3 o_specular)
{
	high_freq = vec3(0);
	o_specular = vec3(0);

	rng_seed = texelFetch(TEX_ASVGF_RNG_SEED_A, ipos, 0).r;


	vec4 position_material = texelFetch(TEX_PT_SHADING_POSITION, ipos, 0);

	vec3 position   = position_material.xyz;
	uint material_id = floatBitsToUint(position_material.w);

	// don't compute lighting for invalid surfaces
	if(material_id == 0)
		return;

	vec4 view_direction = texelFetch(TEX_PT_VIEW_DIRECTION, ipos, 0);
	vec3 normal = decode_normal(texelFetch(TEX_PT_NORMAL_A, ipos, 0).x);
	vec3 geo_normal = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_A, ipos, 0).x);
	vec4 primary_base_color = texelFetch(TEX_PT_BASE_COLOR_A, ipos, 0);
	float primary_specular_factor = primary_base_color.a;
	vec2 metal_rough = texelFetch(TEX_PT_METALLIC_A, ipos, 0).xy;
	float primary_metallic = metal_rough.x;
	float primary_roughness = metal_rough.y;
	uint cluster_idx = texelFetch(TEX_PT_CLUSTER_A, ipos, 0).x;
	if(cluster_idx == 0xffff) cluster_idx = ~0u; // because the image is uint16

	bool primary_is_weapon = (material_id & MATERIAL_FLAG_WEAPON) != 0;
	int primary_medium = int((material_id & MATERIAL_LIGHT_STYLE_MASK) >> MATERIAL_LIGHT_STYLE_SHIFT);

	int shadow_cull_mask = SHADOW_RAY_CULL_MASK;

	if(global_ubo.first_person_model != 0 && !primary_is_weapon)
		shadow_cull_mask |= AS_FLAG_VIEWER_MODELS;
	else
		shadow_cull_mask |= AS_FLAG_VIEWER_WEAPON;

	float direct_specular_weight = smoothstep(
		global_ubo.pt_direct_roughness_threshold - 0.02, 
		global_ubo.pt_direct_roughness_threshold + 0.02, 
		primary_roughness);

	bool is_gradient = get_is_gradient(ipos);

	vec3 primary_albedo, primary_base_reflectivity;
	get_reflectivity(primary_base_color.rgb, primary_metallic, primary_albedo, primary_base_reflectivity);

	vec3 direct_diffuse, direct_specular;
	get_direct_illumination(
		position, 
		normal, 
		geo_normal, 
		cluster_idx, 
		material_id, 
		shadow_cull_mask, 
		view_direction.xyz, 
		primary_albedo,
		primary_base_reflectivity,
		primary_specular_factor,
		primary_roughness, 
		primary_medium, 
		spec_enable_caustics != 0, 
		direct_specular_weight, 
		global_ubo.pt_direct_polygon_lights > 0,
		global_ubo.pt_direct_dyn_lights > 0,
		is_gradient,
		0,
		direct_diffuse,
		direct_specular);

	high_freq += direct_diffuse;
	o_specular += direct_specular;
	
	// DLSS-RR guide buffers - all describing the post-reflect_refract surface.
	// See the note in direct_lighting_restir() above.
	// A chrome model (the viewer weapon) already had the DLSS-RR guides written from the
	// mirror surface itself by reflect_refract.rgen, which is what RR wants for a mirror.
	// Everything below describes the reflected surface, so it must not overwrite them.
	bool mirror_model_guides = (int(view_direction.w) & CHECKERBOARD_FLAG_MIRROR_MODEL) != 0;

	imageStore(IMG_PT_SPECULAR, ipos, vec4(primary_specular_factor, 0, 0, 0));
	if(!mirror_model_guides)
	{
		imageStore(IMG_PT_ALBEDO, ipos, vec4(primary_albedo, 0));
		imageStore(IMG_PT_ROUGHNESS, ipos, vec4(primary_roughness));
		imageStore(IMG_PT_METALLIC, ipos, vec4(primary_metallic));
		imageStore(IMG_PT_NORMAL, ipos, vec4(normal, 0));
		imageStore(IMG_PT_MATERIALID, ipos, vec4(material_id, 0, 0, 0));
	}
	
	
	if(global_ubo.pt_direct_sun_light != 0)
	{
		vec3 direct_sun_diffuse, direct_sun_specular;
		get_sunlight(
			cluster_idx,
			material_id,
			position,
			normal,
			geo_normal,
			view_direction.xyz,
			primary_base_reflectivity,
			primary_specular_factor,
			primary_roughness,
			primary_medium,
			spec_enable_caustics != 0,
			direct_sun_diffuse,
			direct_sun_specular,
			shadow_cull_mask);

		high_freq += direct_sun_diffuse;
		o_specular += direct_sun_specular;
	}

	o_specular = demodulate_specular(primary_base_reflectivity, o_specular);

	high_freq = clamp_output(high_freq);
	o_specular = clamp_output(o_specular);
	float alpha = square(primary_roughness);

	// Specular albedo takes the specular reflectance (F0), not the diffuse albedo.
	if(!mirror_model_guides)
		imageStore(IMG_PT_SPECULAR_ALBEDO, ipos, vec4(EnvBRDFApprox2(primary_base_reflectivity, alpha, dot(normal, view_direction.xyz)), 0));
}

void
main() 
{
	ivec2 ipos = ivec2(rt_LaunchID.xy);
	if(rt_LaunchID.z != 0)
		ipos.x += global_ubo.pt_field_offset;

	bool is_odd_checkerboard = (rt_LaunchID.z != 0) || (push_constants.gpu_index == 1);

	// Split-field mode: field 1 exists only to carry the *other* Fresnel path, and only
	// on the pixels where reflection and refraction actually diverged - glass, water,
	// translucent surfaces, security cameras. Anywhere else it would re-light the very
	// same surface a second time, and the combine pass takes field 0 alone there, so
	// stop before any light sampling happens. Lighting the whole frame twice is what
	// made split-field mode cost a second full frame of path tracing.
	if(global_ubo.pt_fullres_fields != 0)
	{
		bool is_second_field = is_odd_checkerboard;
		int cb_flags = int(imageLoad(IMG_PT_VIEW_DIRECTION, ipos).w) & CHECKERBOARD_FLAG_FIELD_MASK;

		// Field 1 is idle wherever the two paths never diverged. In half-resolution mode
		// both fields are also idle on the rows this frame is not tracing - but only on
		// reflect/refract materials, so the opaque frame stays at full render resolution.
		bool field1_idle = is_second_field && bitCount(cb_flags) <= 1;
		bool row_idle = !PT_FIELD_ROW_TRACED(global_ubo, ipos.y)
			&& IS_REFLECT_REFRACT_KIND(floatBitsToUint(imageLoad(IMG_PT_SHADING_POSITION, ipos).w));

		if(field1_idle || row_idle)
		{
			// Zero rather than leave last frame's radiance behind, so nothing downstream
			// can pick up stale values out of a field that isn't being combined.
			imageStore(IMG_PT_COLOR_LF_SH, ipos, vec4(0));
			imageStore(IMG_PT_COLOR_LF_COCG, ipos, vec4(0));
			imageStore(IMG_PT_COLOR_HF, ipos, uvec4(packRGBE(vec3(0))));
			imageStore(IMG_PT_COLOR_SPEC, ipos, uvec4(packRGBE(vec3(0))));
			return;
		}
	}

	vec3 high_freq, specular;
	if(global_ubo.pt_restir > 0)
		direct_lighting_restir(ipos, is_odd_checkerboard, high_freq, specular);
	else
		direct_lighting(ipos, is_odd_checkerboard, high_freq, specular);

	high_freq *= STORAGE_SCALE_HF;
	specular *= STORAGE_SCALE_SPEC;
	
	imageStore(IMG_PT_COLOR_LF_SH, ipos, vec4(0));
	imageStore(IMG_PT_COLOR_LF_COCG, ipos, vec4(0));
	imageStore(IMG_PT_COLOR_HF, ipos, uvec4(packRGBE(high_freq)));
	imageStore(IMG_PT_COLOR_SPEC, ipos, uvec4(packRGBE(specular)));
	

}