// ========================================================================== //
// This rgen shader computes a single bounce of lighting for the surface
// stored in the G-buffer, and optionally writes the next surface into the 
// G-buffer for the next bounce stage.
//
// See `path_tracer.h` for an overview of the path tracer.
// ========================================================================== //

#version 460
#extension GL_GOOGLE_include_directive    : enable
#pragma optionNV(unroll all)

// later bounces run over a path list under pt_bounce_cull - see constants.h
#define PT_PATH_LAUNCH
#include "path_tracer_rgen.h"
#include "path_tracer_transparency.glsl"
#include "sharc.h"
#include "restir_gi.h"

layout(constant_id = 0) const uint spec_bounce_index = 0;

#ifdef VKPT_D3D12
/* SER (pt_ser) WHERE THE REORDER GOES. 0 (pt_ser 1): after the hit's triangle is
   fetched, keyed by its final material. 1 (pt_ser 3): BEFORE the fetch. MaybeReorderThread
   moves every value live across it through memory, and the fetched Triangle is about 40
   of them (positions, normals, UVs, tangents...) - early, only the hit record (5) goes
   along, and the fetch itself runs in the regrouped order, lanes on the same mesh
   together. The key is then the primitive's own material, one load (an instance's
   override and animation left out: it only groups the lanes). Only the D3D12 SER
   builds set it (CMakeLists' ".spec_1_1.ser" variants); Vulkan never sees it. */
layout(constant_id = 1) const uint spec_ser_early = 0;

uint ser_hit_key(uint material)
{
	return ((material >> 28) << 12) | (material & MATERIAL_INDEX_MASK);
}

/* pt_ser 4 (spec_ser_early 2): the early reorder keyed by WHERE the bounce landed -
   the hit's BSP cluster - instead of by its material. What the lanes do after the hit
   is the same code for every material; what differs is the data: the cluster's light
   list (get_direct_illumination walks it), the BVH around the hit that the light and
   sun shadow rays cross, and the textures, which neighbours mostly share anyway. Lanes
   that landed in the same cluster read the same list and trace through the same
   nodes. The sky goes in a group of its own (top bit): it leaves early. Two loads from
   one primitive (an instance's cluster from its record). */
uint ser_place_key(RayPayloadGeometry rp)
{
	uint buffer_idx = rp.buffer_and_instance_idx & 0xffff;
	int instance_idx = rp.buffer_and_instance_idx >> 16;
	uint material = primitive_buffers[nonuniformEXT(buffer_idx)].primitives[rp.primitive_id].material_id;
	int cluster = primitive_buffers[nonuniformEXT(buffer_idx)].primitives[rp.primitive_id].cluster;
	if (instance_idx >= 0)
		cluster = instance_buffer.model_instances[instance_idx].cluster;
	return (is_sky(material) ? 0x8000u : 0u) | (uint(cluster) & 0x7fffu);
}
#endif

/* WHICH BOUNCE THIS DISPATCH TRACES (0 = the first). The first-bounce pipeline is
   always bounce 0. The second-bounce pipeline is dispatched once for every later
   bounce - pt_num_bounce_rays goes up to 8 - with its number in the push constant;
   every bounce after the first runs the same code, so spec_bounce_index still only
   tells the two pipelines apart. Set in main(). */
int bounce_number = 0;

/* WHAT A BOUNCE PASS HANDS THE NEXT ONE (later bounces only). The pass that hits a
   surface knows its whole material, so it also picks where the path goes from there
   (sample_bounce_lobe below) and stores the ray ready to trace:
     IMG_PT_SHADING_POSITION  the hit and its material
     IMG_PT_GEO_NORMAL2       the direction to trace next (octahedral)
     IMG_PT_VIEW_DIRECTION2   .xyz the direction the path arrived in, .w = 2 x the
                              BOUNCE_FLAGs below + the roughness the lobe was picked with
     IMG_PT_BOUNCE_THROUGHPUT the throughput, the picked lobe's weight in it
   The roughness is stored in 1/256 steps, which a 16-bit float holds exactly next to
   any of the flags (bounce_store_roughness), and the pass that stores it shares the
   hit's light with the next ray by that same value, so the two halves add up to
   exactly one. */
#define BOUNCE_FLAG_LIGHT_SAMPLED 1.0   // the hit was light sampled (NEE)
#define BOUNCE_FLAG_SPECULAR      2.0   // the next ray samples the specular lobe

float bounce_store_roughness(float roughness)
{
	return round(clamp(roughness, 0.0, 1.0) * 256.0) / 256.0;
}

float bounce_origin_flags = 0.0;    // this ray's origin, from the pass before (later bounces);
                                    // negative once the ray went through a portal (pt_portal_light)

/* Was the vertex this bounce ray left from light sampled (NEE)? Then every light it
   can hit was already counted there - all of its diffuse part, and the specular part
   the light sampling took (direct_specular_weight) - and a light the ray lands on adds
   only the rest. Bounce 0 leaves the primary surface (direct_lighting.rgen); a later
   bounce leaves the hit the pass before it shaded, which says so (BOUNCE_FLAG_LIGHT_SAMPLED:
   the first bounce hit always is, a later one with pt_bounce_nee). Same rule for sky
   polygons that are lights. */
bool ray_origin_light_sampled()
{
	// pt_portal_light: light sampling looks for a light in a straight line, and one
	// reached through a portal was never sampled along this path - it counts in full.
	// Except through one Quake 1 gate straight from the primary surface (-0.5, set in
	// the portal loop): direct_lighting.rgen sampled the lights behind it there
	// (add_portal_light), so the same rule as a straight line's.
	if (bounce_origin_flags < 0.0)
		return bounce_origin_flags > -0.75 && bounce_number == 0 && global_ubo.pt_direct_polygon_lights >= 0;
	if (bounce_number == 0)
		return global_ubo.pt_direct_polygon_lights >= 0;
	if (mod(bounce_origin_flags, 2.0) >= 1.0)
		return global_ubo.pt_indirect_polygon_lights >= 0;
	return false;
}

// pt_sharc 4 debug: -1 = no cache query on this path, 0 = query missed, 1 = hit
int sharc_debug_hit = -1;

// This bounce stored the next one's surface: the path goes on (pt_bounce_cull's path lists)
bool path_continues = false;

// ReSTIR GI candidate (pt_restir_gi), filled in by indirect_lighting() on the first
// bounce and written out by main() - see restir_gi.h.
bool gi_candidate = false;     // a diffuse bounce was taken; its result belongs to ReSTIR GI
vec3 gi_sample_pos = vec3(0);
vec3 gi_sample_normal = vec3(0);
vec3 gi_t0 = vec3(0);          // throughput into the bounce, before the hit's albedo
// The pixel's throughput BEFORE the diffuse/specular lobe choice and its Fresnel split,
// stored with the candidate so restir_gi.rgen can shade the reservoir on every frame,
// not only on the frames whose first bounce happened to go diffuse - see restir_gi.h.
vec3 gi_base = vec3(0);
bool gi_active = false;        // this pixel takes part in ReSTIR GI this frame
bool gi_no_diffuse = false;    // the primary surface has no diffuse lobe (pure metal): nothing to resample
vec3 gi_origin = vec3(0);
vec3 gi_origin_normal = vec3(0);

/* Texture mip at a bounce hit from a ray cone - Akenine-Moller et al.,
   "Improved Shader and Texture Level of Detail Using Ray Cones", JCGT 2021:

     lod = 0.5 * log2(texel_area / world_area) + log2(cone_width / |cos|)

   texel_area is the triangle's UV area in texels of `tex_index`, world_area its
   area in world units, so the first term is log2 of texels per world unit. */
float
bounce_texture_lod(Triangle triangle, uint tex_index, float cone_width, vec3 ray_direction, vec3 geo_normal)
{
	if (tex_index == 0)
		return 0;

	vec2 duv0 = triangle.tex_coords[1] - triangle.tex_coords[0];
	vec2 duv1 = triangle.tex_coords[2] - triangle.tex_coords[0];
	vec3 dp0  = triangle.positions[1] - triangle.positions[0];
	vec3 dp1  = triangle.positions[2] - triangle.positions[0];

	ivec2 size = global_textureSize(tex_index, 0);
	float texel_area = abs(duv0.x * duv1.y - duv1.x * duv0.y) * float(size.x) * float(size.y);
	float world_area = length(cross(dp0, dp1));

	if (!(texel_area > 0) || !(world_area > 0))
		return 0;

	float cos_theta = max(abs(dot(ray_direction, geo_normal)), 0.05);
	float lod = 0.5 * log2(texel_area / world_area) + log2(max(cone_width, 1e-4) / cos_theta);

	return max(0, lod + global_ubo.pt_bounce_lod_bias);
}

/* pt_bounce_transparent: A SEE-THROUGH SURFACE'S GLOW IN A GLOSSY REFLECTION.

   The bounce mask (BOUNCE_RAY_CULL_MASK) has no AS_FLAG_TRANSPARENT, so a surface of
   kind TRANSPARENT - a Quake III additive effect such as q3tourney4's sfx/console03
   rings, a trans33 pane - was in no glossy reflection at all. Only the mirror pass
   (reflect_refract.rgen: CHROME / SCREEN under MAX_MIRROR_ROUGHNESS) traces that
   group. Matt, 2026-11-21: the rings vanished from a metal box the moment its kind
   went from CHROME to REGULAR, or as soon as the CHROME had any roughness - both
   send the reflection here.

   This looks along the specular ray, up to the solid surface it hit (ray.t_max), at
   the see-through instances only (trace_caustic_hit: the nearest one, no any-hit;
   that group is FORCE_OPAQUE and cull-disabled), and returns that surface's glow as
   it is drawn: the Quake III program's composite where it has one, otherwise the
   emissive map, times the surface's emissive_factor - what get_material gives - and
   the spotlight term every other emissive bounce hit gets (sample_light_lists).
   Light is only added: what is behind the surface is not dimmed, and a translucent
   surface's own lit colour is not shaded (it was missing before as well).
   ray_payload_geometry is the solid hit's again on return. `cone_base` and
   `cone_spread`: the ray cone's width at the ray's origin and how fast it widens -
   the pixel angle alone, as photo mode has it: a glow is not prefiltered by the
   lobe (path_tracer_rgen.h get_material_emissive_lod). */
vec3 bounce_transparent_glow(Ray ray, float cone_base, float cone_spread, out float hit_t, out bool is_light)
{
	hit_t = 0.0;
	is_light = false;

	RayPayloadGeometry solid = ray_payload_geometry;
	trace_caustic_hit(ray);

	vec3 glow = vec3(0);
	if (found_intersection(ray_payload_geometry))
	{
		Triangle t = get_hit_triangle(ray_payload_geometry);
		if ((t.material_id & MATERIAL_KIND_MASK) == MATERIAL_KIND_TRANSPARENT && t.emissive_factor > 0)
		{
			hit_t = ray_payload_geometry.hit_distance;
			is_light = (t.material_id & MATERIAL_FLAG_LIGHT) != 0;

			vec3 bary = get_hit_barycentric(ray_payload_geometry);
			vec2 tex_coord = t.tex_coords * bary;
			vec3 n = normalize(t.normals * bary);
			MaterialInfo minfo = get_material_info(t.material_id);

			// across the footprint, no 1/cos: a glow's mip (see the bounce hit's
			// get_material_emissive_lod). pt_bounce_emissive_lod 0: along the ray,
			// as before 11-23.
			float lod = bounce_texture_lod(t, minfo.base_texture,
				cone_base + cone_spread * hit_t,
				global_ubo.pt_bounce_emissive_lod != 0 ? n : ray.direction, n);

			vec3 q3_albedo;
			float q3_alpha;
			// only the glow is wanted here: no vertex alpha (alphaGen vertex
			// blends Team Arena's terrain, which does not glow), and no value
			// held over the call (local memory, 11-21)
			q3_vertex_alpha = 1.0;
			if (!q3_program_material(t.material_id, t.positions * bary, tex_coord, vec2(0), vec2(0), lod,
				n, ray.direction, minfo.base_texture, false, q3_albedo, glow, q3_alpha))
				glow = sample_emissive_texture(t.material_id, minfo, tex_coord, vec2(0), vec2(0), lod);

			glow *= t.emissive_factor * sqrt(abs(dot(ray.direction, n)));
		}
	}

	ray_payload_geometry = solid;
	return glow;
}

/* pt_bounce_lobe_select: how often the first bounce samples the specular lobe.

   Each lobe gets rays in proportion to what it can return: the specular lobe's
   directional albedo (the split-sum fit DLSS-RR's specular albedo guide uses, times the
   material's specular factor) against the diffuse albedo it leaves behind. On a rough
   dielectric that is ~0.04 against ~0.3, so the diffuse indirect is sampled ~85% of the
   time at weight ~1.2 instead of half the time at weight 2 - the 0-or-2x coin flip that
   ReSTIR GI used to hide.

   Glossy surfaces keep at least the old half of the rays: their reflection is sharp and
   on screen, and a 1-in-10 sample at 10x weight would turn it into sparkle under RR.
   The floor fades out between roughness 0.25 and 0.5. */
float
bounce_specular_probability(vec3 albedo, vec3 base_reflectivity, float specular_factor, float roughness, float NoV)
{
	// The specular sample needs NoV > 0 and can never succeed otherwise - spend every
	// ray on the diffuse lobe.
	if (NoV <= 0)
		return 0.0;

	float spec = clamp(luminance(EnvBRDFApprox2(base_reflectivity, square(roughness), NoV)) * specular_factor, 0.0, 1.0);

	// No specular lobe at all (specular factor 0): nothing to sample there.
	if (spec <= 0.0)
		return 0.0;

	float diff = luminance(albedo) * (1.0 - spec);

	// No diffuse lobe to speak of (a black or metal-like base): all specular.
	if (diff <= 0.0)
		return 1.0;

	float p = clamp(spec / (spec + diff), 0.1, 0.9);

	float glossy = 1.0 - smoothstep(0.25, 0.5, roughness);
	return max(p, 0.5 * glossy);
}

/* pt_bounce_brdf: WHERE A PATH GOES FROM A BOUNCE HIT - the hit's own material decides,
   the way the first bounce's does for the primary surface: the specular lobe with
   bounce_specular_probability, GGX visible normals, F * G1(L) / p; else the diffuse lobe,
   cosine around the shading normal, albedo * (1 - F) / (1 - p). A mirror inside a
   reflection reflects, a glossy floor in it is glossy, plaster stays diffuse - at every
   bounce pt_num_bounce_rays allows. `V` is the arriving direction; `N` and `geo_normal`
   face it. False when the sample carries nothing (below the horizon, or below the
   geometric surface under pt_bounce_geo_hemisphere): the path ends there.
   pt_bounce_brdf 0: the old way - every later bounce diffuse, around the geometric
   normal, weighted by the albedo alone. */
bool
sample_bounce_lobe(vec3 V, vec3 N, vec3 geo_normal, vec3 albedo, vec3 reflectance, vec3 base_reflectivity,
	float specular_factor, float roughness, vec3 throughput_in,
	out vec3 L, out vec3 throughput_out, out bool specular)
{
	// the same random numbers the next pass used to draw its own diffuse direction with
	vec2 rng = vec2(get_rng(RNG_BRDF_X(bounce_number + 2)), get_rng(RNG_BRDF_Y(bounce_number + 2)));
	specular = false;

	if (global_ubo.pt_bounce_brdf == 0)
	{
		L = normalize(construct_ONB_frisvad(geo_normal) * sample_cos_hemisphere(rng));
		throughput_out = throughput_in * reflectance;
		return true;
	}

	float NoV = -dot(N, V);
	float p_spec = bounce_specular_probability(albedo, base_reflectivity, specular_factor, roughness, NoV);
	mat3 basis = construct_ONB_frisvad(N);

	if (get_rng(RNG_BRDF_FRESNEL(bounce_number + 2)) < p_spec)
	{
		specular = true;
		vec3 H = ImportanceSampleGGX_VNDF(rng, roughness, V, basis);
		L = normalize(reflect(V, H));
		float NoL = dot(N, L);
		float VoH = max(0, -dot(V, H));
		if (NoL <= 0 || NoV <= 0 || (global_ubo.pt_bounce_geo_hemisphere != 0 && dot(L, geo_normal) <= 0))
		{
			throughput_out = vec3(0);
			return false;
		}
		// (BRDF / PDF) = F * G2(V, L) / G1(V) ~ F * G1(L), as at the first bounce
		throughput_out = throughput_in * G1_Smith(roughness, NoL)
			* schlick_fresnel(base_reflectivity, VoH, specular_factor) / p_spec;
		return true;
	}

	L = normalize(basis * sample_cos_hemisphere(rng));
	float VoH = max(0, -dot(V, normalize(L - V)));
	throughput_out = throughput_in * reflectance
		* (vec3(1.0) - schlick_fresnel(base_reflectivity, VoH, specular_factor)) / (1.0 - p_spec);
	if (global_ubo.pt_bounce_geo_hemisphere != 0 && dot(L, geo_normal) <= 0)
	{
		throughput_out = vec3(0);
		return false;
	}
	return true;
}

/* pt_bounce_cull 1: the least probability the roulette may keep this path with, judged
   by what the rest of the path is worth to ITS OWN PIXEL.

   The throughput rule alone (pt_bounce_rr's: p = remaining throughput) assumes every
   pixel is about as bright as a white, directly lit surface. On Quake albedos (~0.07
   rendered) it kept 12-17% of diffuse second bounces and 5% of specular ones (those
   carry the primary's Fresnel, ~0.04-0.1) everywhere - fine where direct light
   dominates, but in base1's armor tunnel the second bounce IS the light, and DLSS-RR
   given 1-in-6..20 samples at 6..20x weight lost about half of it, and the armor's
   reflection of that rock (Matt, 2026-11-12: pt_bounce_cull 3 now).

   share = what the rest is expected to bring / (that + what the pixel has so far), in
   the channel the rest lands in (the first bounce's lobe), and the rest is expected to
   bring its throughput times a typical radiance: the frame's adapted luminance, what a
   ray sees on average. Cutting the rest adds about share * sqrt((1 - p) / p) of noise
   relative to the pixel; keeping p = share^2 / (share^2 + e^2) holds that near e (25%).
   Lit surfaces (share ~1%) keep the throughput rule's p; a pixel lit only by what is
   still to come (share ~1) keeps ~94% of its paths.

   Any p in (0, 1] keeps the estimate unbiased; this only moves where the rays go. The
   units are the ones the images hold under DLSS-RR (flt_enable 0); under A-SVGF the
   specular image is demodulated, which makes `so_far` large there, and the throughput
   rule decides - as before. */
float
bounce_cull_keep_probability(ivec2 ipos, vec3 contrib, vec3 throughput, bool specular_channel)
{
	float so_far;
	if(specular_channel)
	{
		so_far = luminance(unpackRGBE(imageLoad(IMG_PT_COLOR_SPEC, ipos).x)) / STORAGE_SCALE_SPEC;
	}
	else
	{
		// direct light (HF) and the bounces before this one (LF: RGB under DLSS-RR, its
		// luminance SH under A-SVGF)
		vec4 lf = texelFetch(TEX_PT_COLOR_LF_SH, ipos, 0);
		float lf_lum = global_ubo.flt_enable == 0 ? luminance(lf.xyz) : lf.w / 0.282095;
		so_far = luminance(unpackRGBE(imageLoad(IMG_PT_COLOR_HF, ipos).x)) / STORAGE_SCALE_HF
		       + max(lf_lum, 0.0) / STORAGE_SCALE_LF;
	}
	so_far += luminance(contrib);

	float ahead = luminance(throughput) * global_ubo.prev_adapted_luminance;
	float share = ahead / max(ahead + max(so_far, 0.0), 1e-20);
	if(isnan(share) || isinf(share))
		return 0.0;    // (the throughput rule decides)

	const float e2 = 0.25 * 0.25;
	float s2 = share * share;
	return s2 / (s2 + e2);
}

void
indirect_lighting(
	ivec2 ipos, 
	bool half_res, 
	out vec3 bounce_direction,
	out vec3 bounce_contrib,
	out bool is_specular_ray)
{
    rng_seed = texelFetch(TEX_ASVGF_RNG_SEED_A, ipos, 0).r;
	
	uint cluster_idx = ~0u;

	vec4 position_material = texelFetch(TEX_PT_SHADING_POSITION, ipos, 0);
	
	vec3 position   = position_material.xyz;
	uint material_id = floatBitsToUint(position_material.w);

	// don't compute lighting for invalid surfaces;
	// don't compute lighting for lava because it's emissive and self-illuminating, which causes issues with the filters
	if(material_id == 0 || is_lava(material_id))
	{
		bounce_direction = vec3(0);
		bounce_contrib = vec3(0);
		is_specular_ray = false;
		return;
	}

	vec4 throughput = texelFetch(TEX_PT_BOUNCE_THROUGHPUT, ipos, 0).rgba;
	vec4 view_direction;
	vec3 normal;
    vec3 geo_normal;
    vec4 primary_base_color = vec4(0);
    float primary_metallic = 0;
	float primary_roughness = 1;
	float primary_specular_factor = 0;

	// later bounces: the ray the pass before picked (sample_bounce_lobe), and its lobe
	vec3 stored_direction = vec3(0);
	bool stored_specular = false;

	if(half_res)
		throughput.rgb *= 2;

	if(spec_bounce_index == 0)
	{
		// First bounce: use primary/reflected view direction,
		// actual normals of the surface, and specular parameters
		// (unless GI is set to "low", which means half res and no specular)

	    view_direction = texelFetch(TEX_PT_VIEW_DIRECTION, ipos, 0);
		normal = decode_normal(texelFetch(TEX_PT_NORMAL_A, ipos, 0).x);
	    geo_normal = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_A, ipos, 0).x);
	    primary_base_color = texelFetch(TEX_PT_BASE_COLOR_A, ipos, 0);
	    primary_specular_factor = primary_base_color.a;

	    if(!half_res)
	    {
		    vec2 metal_rough = texelFetch(TEX_PT_METALLIC_A, ipos, 0).xy;
		    primary_metallic = metal_rough.x;
			primary_roughness = metal_rough.y;
		}
	}
	else
	{
		// Later bounce: the pass that hit this surface already picked the ray from
		// its material (see "WHAT A BOUNCE PASS HANDS THE NEXT ONE" at the top).
		// These have to be stored in textures different from the primary
		// surface params, because the primary view direction and normal
		// are used for fake specular reconstruction (see `asvgf_atrous.comp`)
		// and for LF channel filtering, respectively.

	    view_direction = texelFetch(TEX_PT_VIEW_DIRECTION2, ipos, 0);
		stored_direction = decode_normal(texelFetch(TEX_PT_GEO_NORMAL2, ipos, 0).x);

		float code = view_direction.w;
		bounce_origin_flags = floor(code * 0.5);
		primary_roughness = code - 2.0 * bounce_origin_flags;
		stored_specular = bounce_origin_flags >= BOUNCE_FLAG_SPECULAR;

		// (only the first bounce samples around these)
		normal = -view_direction.xyz;
		geo_normal = normal;
	}

    vec3 primary_albedo, primary_base_reflectivity;
    get_reflectivity(primary_base_color.rgb, primary_metallic, primary_albedo, primary_base_reflectivity);

	bool use_restir_gi = spec_bounce_index == 0 && !half_res && restir_gi_enabled();
	gi_active = use_restir_gi;
	gi_base = throughput.rgb;
	gi_origin = position;
	gi_origin_normal = normal;


	bool primary_is_weapon = (material_id & MATERIAL_FLAG_WEAPON) != 0;

	float direct_specular_weight = smoothstep(
		global_ubo.pt_direct_roughness_threshold - 0.02, 
		global_ubo.pt_direct_roughness_threshold + 0.02, 
		primary_roughness);

	// (the primary surface's own specular image only; a later bounce keeps all of its ray)
	float fake_specular_weight = spec_bounce_index > 0 ? 0.0 : smoothstep(
		global_ubo.pt_fake_roughness_threshold,
		global_ubo.pt_fake_roughness_threshold + 0.1,
		primary_roughness);

    float NoV = max(0, -dot(normal, view_direction.xyz));

	bool first_bounce_is_specular = throughput.a != 0;

	vec3 bounce_throughput = throughput.rgb;

	is_specular_ray = false;
	{
		vec2 rng3 = vec2(get_rng(RNG_BRDF_X(bounce_number + 1)), get_rng(RNG_BRDF_Y(bounce_number + 1)));

		float rng_frensel = get_rng(RNG_BRDF_FRESNEL(bounce_number + 1));

		float specular_pdf = 0;

		// The specular lobe was picked but its sample was unusable - see
		// pt_bounce_failed_spec_zero. Such a path carries no light.
		bool specular_failed = false;

#if BOUNCE_SPECULAR
		if(spec_bounce_index == 0)
		{
			specular_pdf = (primary_metallic == 1 && fake_specular_weight == 0) ? 1.0 : 0.5;

			// pt_bounce_lobe_select - see bounce_specular_probability() above.
			if(global_ubo.pt_bounce_lobe_select != 0 && specular_pdf < 1.0)
				specular_pdf = bounce_specular_probability(primary_albedo, primary_base_reflectivity,
					primary_specular_factor, primary_roughness, NoV);

			gi_no_diffuse = specular_pdf >= 1.0;

			if(rng_frensel < specular_pdf)
			{
				mat3 basis = construct_ONB_frisvad(normal);

				// Sampling of normal distribution function to compute the reflected ray.
				// See the paper "Sampling the GGX Distribution of Visible Normals" by E. Heitz, 
				// Journal of Computer Graphics Techniques Vol. 7, No. 4, 2018.
				// http://jcgt.org/published/0007/04/01/paper.pdf 

				vec3 N = normal;
				vec3 V = view_direction.xyz;
				vec3 H = ImportanceSampleGGX_VNDF(rng3, primary_roughness, V, basis);
				vec3 L = reflect(V, H);

				float NoL = max(0, dot(N, L));
				float NoH = max(0, dot(N, H));
				float VoH = max(0, -dot(V, H));

				// pt_bounce_geo_hemisphere: a reflection below the GEOMETRIC surface
				// would only hit the surface itself.
				bool usable = NoL > 0 && NoV > 0;
				if(global_ubo.pt_bounce_geo_hemisphere != 0)
					usable = usable && dot(L, geo_normal) > 0;

				if (usable)
				{
					// See the Heitz paper referenced above for the estimator explanation.
					//   (BRDF / PDF) = F * G2(V, L) / G1(V)
					// Assume G2 = G1(V) * G1(L) here and simplify that expression to just G1(L).
					
					float G1_NoL = G1_Smith(primary_roughness, NoL);
					vec3 F = schlick_fresnel(primary_base_reflectivity, VoH, primary_specular_factor);

					bounce_throughput *= G1_NoL * F;

					bounce_throughput *= 1 / specular_pdf;
					is_specular_ray = true;
					bounce_direction = normalize(L);
				}
				else if(global_ubo.pt_bounce_failed_spec_zero != 0)
				{
					// An unusable sample is where the GGX lobe returns nothing - its
					// estimate is zero. It used to fall through to the diffuse branch
					// below and be weighted 1 / (1 - specular_pdf), so the diffuse lobe
					// was sampled more often than its probability: +10..44% indirect on
					// rough surfaces facing the camera.
					specular_failed = true;
				}
			}
		}
#endif

		if(spec_bounce_index > 0)
		{
			// picked, and weighted into the throughput, by the pass that hit this surface
			bounce_direction = stored_direction;
			is_specular_ray = stored_specular;
		}
		else if(specular_failed)
		{
			// Still a specular frame (ReSTIR GI files it as one) and still traced, so the
			// DLSS-RR hit-distance guides below get a value: along the mirror direction,
			// kept above the surface. No light comes back along it.
			vec3 V = view_direction.xyz;
			vec3 L = reflect(V, normal);
			if(dot(L, geo_normal) <= 0)
				L = reflect(V, geo_normal);
			bounce_direction = normalize(L);
			bounce_throughput = vec3(0);
			is_specular_ray = true;
		}
		else if(!is_specular_ray)
		{
			vec3 basis_normal, dir_sphere;
		#if ENABLE_SH
			if(spec_bounce_index == 0 && global_ubo.flt_enable != 0 && !use_restir_gi)
			{
				dir_sphere = sample_cos_hemisphere_multi(0, 1, rng3, HEMISPHERE_UNIFORMISH);
				basis_normal = geo_normal;
			}
			else
		#endif
			{
				dir_sphere = sample_cos_hemisphere(rng3);
				basis_normal = normal;
			}

			mat3 basis = construct_ONB_frisvad(basis_normal);
			bounce_direction = normalize(basis * dir_sphere);
			bounce_throughput *= 1 / (1 - specular_pdf);

			vec3 L = bounce_direction.xyz;
			vec3 V = -view_direction.xyz;
			vec3 H = normalize(V + L);
			float VoH = max(0, dot(V, H));

			vec3 F = schlick_fresnel(primary_base_reflectivity, VoH, primary_specular_factor);

			bounce_throughput *= vec3(1.0) - F;

			// pt_bounce_geo_hemisphere: the lobe is built around the bump-mapped normal,
			// so part of it can point INTO the geometry. Light cannot arrive from there -
			// light sampling already drops lights below the surface - so the sample
			// carries nothing. It is mirrored above the surface only so that the ray
			// traced for the hit-distance guides does not stop on the surface itself.
			if(global_ubo.pt_bounce_geo_hemisphere != 0 && dot(bounce_direction, geo_normal) <= 0)
			{
				bounce_direction = normalize(reflect(bounce_direction, geo_normal));
				bounce_throughput = vec3(0);
			}
		}
	}

	Ray bounce_ray;
	bounce_ray.origin = position;
	bounce_ray.direction = bounce_direction;
	bounce_ray.t_min = 0;
	bounce_ray.t_max = 10000;

	bounce_ray.origin -= view_direction.xyz * 0.01;

	int bounce_cull_mask = BOUNCE_RAY_CULL_MASK;
	int shadow_cull_mask = shadow_ray_cull_mask();

	if(global_ubo.first_person_model != 0 && !primary_is_weapon)
	{
		bounce_cull_mask |= AS_FLAG_VIEWER_MODELS;
		shadow_cull_mask |= AS_FLAG_VIEWER_MODELS;
	}
	else
	{
		bounce_cull_mask |= AS_FLAG_VIEWER_WEAPON;
		shadow_cull_mask |= AS_FLAG_VIEWER_WEAPON;
	}

	/* pt_portal_light: LIGHT THROUGH A PORTAL. A bounce ray that meets a Quake 1
	   teleporter's gate or a Quake III portal goes on from its far side, as the eye's
	   ray does (reflect_refract.rgen, portal_carry_ray), so the room a portal opens on
	   lights this side of it (Matt, 2026-11-21: "light passes through portals"). Up to
	   two portals in a row. From here on bounce_ray and bounce_direction are the far
	   side's - the hit is shaded there, and a later bounce goes on from there - but the
	   denoiser still gets the direction the light arrived from at this surface.
	   (One trace call site in a loop: a second inlined copy of the trace cost 32 B more
	   local memory.) */
	bool portal_light = Q3_SHADERS && global_ubo.pt_portal_light != 0 && global_ubo.pt_cameras != 0;
	for(int portal_pass = 0; ; portal_pass++)
	{
		trace_geometry_ray(bounce_ray, true, bounce_cull_mask);

		if(!portal_light || portal_pass == 2 || !found_intersection(ray_payload_geometry))
			break;
		Triangle portal_tri = get_hit_triangle(ray_payload_geometry);
		if(!is_camera(portal_tri.material_id) || !is_portal_camera(camera_id_of_material(portal_tri.material_id)))
			break;

		vec3 portal_pos = portal_tri.positions * get_hit_barycentric(ray_payload_geometry);
		vec3 portal_normal = normalize(cross(
			portal_tri.positions[1] - portal_tri.positions[0],
			portal_tri.positions[2] - portal_tri.positions[1]));
		vec3 portal_dir = bounce_ray.direction;
		mat4 portal_camera = global_ubo.security_camera_data[camera_id_of_material(portal_tri.material_id)];
		portal_carry_ray(portal_camera, portal_normal, portal_pos, portal_dir);

		// (This state rides on variables held anyway - a bool and a uint of its own
		// spilled 32 B more to local memory. From here on bounce_origin_flags is read
		// only by ray_origin_light_sampled(), and gi_sample_normal only for a ReSTIR GI
		// candidate, which a bounce through a portal never is. A later bounce's SH
		// direction is its view direction, see the end of indirect_lighting().)
		if(spec_bounce_index == 0 && bounce_origin_flags >= 0.0)
			gi_sample_normal = bounce_direction;
		// -0.5: the first portal from the primary surface, a Quake 1 gate whose lights
		// direct_lighting.rgen sampled from here (ray_origin_light_sampled)
		bounce_origin_flags = (portal_pass == 0 && bounce_number == 0
			&& portal_light_gate_weight(portal_camera, position, normal) > 0.0) ? -0.5 : -1.0;

		bounce_ray.origin = portal_pos + portal_dir * 0.01;
		bounce_ray.direction = portal_dir;
		bounce_ray.t_min = 0;
		bounce_ray.t_max = 10000;
		bounce_direction = portal_dir;
	}

	// (ReSTIR GI's reuse looks for a sample in a straight line from each pixel, and
	// one through a portal is not there: such a bounce lights its own pixel instead)
	if(use_restir_gi && !is_specular_ray && bounce_origin_flags >= 0.0)
	{
		gi_candidate = true;
		gi_t0 = bounce_throughput;
		// A miss still makes a (black) sample, somewhere far away along the ray.
		float t = found_intersection(ray_payload_geometry) ? ray_payload_geometry.hit_distance : 10000.0;
		gi_sample_pos = bounce_ray.origin + bounce_direction * t;
		gi_sample_normal = -bounce_direction; // replaced by the surface normal on a surface hit
	}

	// Specular hit distance for DLSS Ray Reconstruction (RR integration guide 3.4.9).
	//
	// This is what RR uses to judge how far a specular lobe is decoupled from the surface
	// carrying it, and therefore how aggressively to reject specular history under motion.
	// Until now only reflect_refract.rgen wrote it, and only for glass / water / chrome;
	// every other pixel kept the per-frame clear of 0, which tells RR "the specular is glued
	// to this surface, accumulate it freely".
	//
	// Harmless for world geometry - a static wall's own motion vector already approximates
	// its reflection's - but exactly wrong for the viewer weapon. The weapon is rigidly
	// attached to the camera, so its motion vector is ~0 while the room it reflects sweeps
	// past at the full camera rate. No motion vector can express "the content of this pixel
	// was replaced rather than moved", so this distance is the only signal that tells RR to
	// stop trusting the history. At 0 it accumulated for as long as the weapon stayed on
	// screen, i.e. forever - the ghosting on fast pans.
	//
	// The bounce ray above is already traced, so this costs nothing. It is taken whether the
	// ray came out specular or diffuse: for a specular ray it is exactly the quantity the
	// guide asks for, and for a diffuse ray it is a cosine-weighted sample of the same
	// neighbourhood - a far better estimate of how far away what this surface sees is than
	// zero. RR filters this input, so sample noise here is expected.
	//
	// Only the first bounce describes the primary surface, and a value already written by
	// reflect_refract.rgen is the exact mirror hit distance - do not overwrite it.
	if(spec_bounce_index == 0 && global_ubo.pt_dlss_spec_hitdist != 0
		&& imageLoad(IMG_PT_RAYLENGTH_SPECULAR, ipos).x <= 0.0)
	{
		float spec_hit_distance = found_intersection(ray_payload_geometry)
			? ray_payload_geometry.hit_distance
			: PRIMARY_RAY_T_MAX;

		imageStore(IMG_PT_RAYLENGTH_SPECULAR, ipos, vec4(spec_hit_distance));
	}

	// Diffuse hit distance for DLSS Ray Reconstruction.
	//
	// IMG_PT_RAYLENGTH_DIFFUSE had no live writer at all - the only code that filled it
	// is the commented-out block further down - so checkerboard_interleave.comp was
	// copying a never-initialised image into IMG_DLSS_RAYLENGTH_DIFFUSE. The buffer was
	// then not even handed to RR. This is the same hole that specular hit distance had.
	//
	// The guide tells RR how far away the geometry feeding a pixel's diffuse lighting is,
	// which is what sizes its diffuse spatial filter. With no signal RR has to assume a
	// wide footprint, so a small bright light - a blaster bolt against a wall - gets its
	// falloff smeared into a flat uniform wash, and light bleeds out of bright areas into
	// neighbouring dark ones, lifting the blacks.
	//
	// The bounce ray is already traced, so like the specular case this costs nothing. It
	// is written whether the bounce came out diffuse or specular: a diffuse ray is exactly
	// the cosine-weighted quantity the guide wants, and a specular ray still samples the
	// same neighbourhood. Writing every frame also keeps the image from going stale, since
	// nothing clears it.
	if(spec_bounce_index == 0)
	{
		float diff_hit_distance = found_intersection(ray_payload_geometry)
			? ray_payload_geometry.hit_distance
			: PRIMARY_RAY_T_MAX;

		imageStore(IMG_PT_RAYLENGTH_DIFFUSE, ipos, vec4(diff_hit_distance));
	}

	bounce_contrib = vec3(0);

	if(is_specular_ray)
	{
		if (found_intersection(ray_payload_geometry))
			bounce_ray.t_max = ray_payload_geometry.hit_distance;

		// a bounce is not a mirror image of the viewer, so it keeps the
		// first-person effects and drops the reflection-only twins
		vec4 transparency = trace_effects_ray(bounce_ray, /* skip_procedural = */ true, /* reflection_ray = */ false);
		bounce_contrib += transparency.rgb * transparency.a * bounce_throughput * (1.0 - direct_specular_weight);

		// pt_bounce_transparent: a see-through surface's glow in front of what the ray hit
		// (bounce_transparent_glow). Weighted as an emissive hit below: a light that was
		// light sampled gives only the share the sampling did not take.
		if (global_ubo.pt_bounce_transparent != 0)
		{
			// the pixel footprint's mip, live as in photo mode: a glow is not
			// prefiltered by the lobe (path_tracer_rgen.h get_material_emissive_lod)
			float pixel_angle = 2.0 / (abs(global_ubo.P[1][1]) * float(global_ubo.height));
			// pt_bounce_emissive_lod 0: widened by the lobe, as before 11-23
			float glow_spread = (global_ubo.pt_bounce_emissive_lod != 0 || global_ubo.temporal_blend_factor > 0.0)
				? 0.0 : 2.0 * primary_roughness * primary_roughness;
			float glow_t;
			bool glow_is_light;
			vec3 glow = bounce_transparent_glow(bounce_ray,
				pixel_angle * length(position - global_ubo.cam_pos.xyz), pixel_angle + glow_spread,
				glow_t, glow_is_light);

			float glow_weight = (glow_is_light && ray_origin_light_sampled())
				? 1.0 - direct_specular_weight
				: (1.0 - fake_specular_weight) / max(1, glow_t * primary_roughness * global_ubo.pt_specular_anti_flicker * 0.01);
			bounce_contrib += glow * bounce_throughput * glow_weight;
		}
	}

	Triangle triangle;

	bool bounce_is_sky_light = false;

	/*
		if(found_intersection(ray_payload_geometry)) {
			vec4 storedLength = imageLoad(IMG_PT_RAY_LENGTH, ipos);
			float storedDistance = storedLength[0];
			float numSamples = storedLength[1];		
		
			numSamples++;
		
			float totalDistance = storedDistance + ray_payload_geometry.hit_distance;		

			imageStore(IMG_PT_RAY_LENGTH, ipos, vec4(totalDistance, numSamples, numSamples, numSamples));
		
			if(is_specular_ray) {
				imageStore(IMG_PT_RAYLENGTH_SPECULAR, ipos, vec4(ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance));
			}
			else {
				imageStore(IMG_PT_RAYLENGTH_DIFFUSE, ipos, vec4(ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance));
			}

		}
		else {
			vec4 storedLength = imageLoad(IMG_PT_RAY_LENGTH, ipos);
			float storedDistance = storedLength[0];
			float numSamples = storedLength[1];
			float totalDistance = storedDistance + PRIMARY_RAY_T_MAX;

			numSamples++;

			imageStore(IMG_PT_RAY_LENGTH, ipos, vec4(totalDistance, numSamples, numSamples, numSamples));
			if(!is_specular_ray) {
				imageStore(IMG_PT_RAYLENGTH_DIFFUSE, ipos, vec4(PRIMARY_RAY_T_MAX, PRIMARY_RAY_T_MAX, PRIMARY_RAY_T_MAX, PRIMARY_RAY_T_MAX));
			}

		}
	*/

	if(!found_intersection(ray_payload_geometry))
	{
		// The path ends: the later bounce passes find material 0 and stand down.
		if(bounce_number < global_ubo.pt_num_bounce_rays - 1)
		{
			imageStore(IMG_PT_SHADING_POSITION, ipos, vec4(0));
		}
		// a later bounce lands in the first bounce's channel (see the end)
		if(spec_bounce_index > 0)
			is_specular_ray = first_bounce_is_specular;
		return;
	}

#ifdef VKPT_D3D12
	// SER, pt_ser 3: regroup the lanes before the triangle is fetched (see spec_ser_early)
	if (spec_ser_early == 2)
	{
		// pt_ser 4: by the cluster the bounce landed in (ser_place_key)
		d3d12_ser_reorder(ser_place_key(ray_payload_geometry), 16u);
	}
	else if (spec_ser_early != 0)
	{
		uint ser_buffer = ray_payload_geometry.buffer_and_instance_idx & 0xffff;
		d3d12_ser_reorder(ser_hit_key(
			primitive_buffers[nonuniformEXT(ser_buffer)].primitives[ray_payload_geometry.primitive_id].material_id), 16u);
	}
#endif

	triangle = get_hit_triangle(ray_payload_geometry);

#ifdef VKPT_D3D12
	// SER (pt_ser 1): regroup the lanes by what the bounce hit - the material's kind,
	// then its index - before shading it
	if (spec_ser_early == 0)
		d3d12_ser_reorder(ser_hit_key(triangle.material_id), 16u);
#endif

	float indirect_specular_weight = 1;
	if(is_specular_ray)
	{
		float cone_size = ray_payload_geometry.hit_distance * primary_roughness;
		indirect_specular_weight = 1 - fake_specular_weight;
		indirect_specular_weight /= max(1, cone_size * global_ubo.pt_specular_anti_flicker * 0.01);
	}

	if(is_sky(triangle.material_id))
	{
		// On the first bounce, analytic lights are processed in the direct lighting pass, so
		// check if `pt_direct_polygon_lights` is non-negative:
		//   0 means disable the polygon lights contribution;
		//   1 means sample the polygon lights analytically;
		//   -1 means replace the polygon lights with bounce ray sampling.
		// On later bounces, analytic lights are processed by the previous bounce pass,
		// guided by the same rules for the `pt_indirect_polygon_lights` setting - see
		// ray_origin_light_sampled().

		bool is_analytic_light = (triangle.material_id & MATERIAL_FLAG_LIGHT) != 0 && ray_origin_light_sampled();

		if(!is_analytic_light || is_specular_ray)
		{
			vec3 env = env_map(bounce_direction, true);

			env *= global_ubo.pt_env_scale;
			// the sky's light through the clouds over the point it left, as its sky
			// light polygons give it (pt_q3_cloud_shadow_sky; q3_sky.glsl)
			env *= q3_cloud_sky_shadow(position);
			
			if(!is_analytic_light)
				bounce_contrib = bounce_throughput * env * indirect_specular_weight;
			else if(is_specular_ray)
			{
				// MIS with direct specular - from the primary surface only, as
				// get_direct_illumination weights its side (bounce 0); from a bounce
				// hit the two keep the plain direct_specular_weight split, and so does
				// a ray through a portal (add_portal_light's split, direct_lighting.rgen)
				if (global_ubo.pt_specular_mis != 0 && spec_bounce_index == 0 && bounce_origin_flags >= 0.0)
				{
					mat3 projected_positions = project_triangle(triangle.positions, position);

					vec3 bary = get_hit_barycentric(ray_payload_geometry);
					vec3 pos_on_triangle = triangle.positions * bary;
					pos_on_triangle -= position;
					pos_on_triangle = normalize(pos_on_triangle);

					// The pdf light sampling would have had for this point - it must match
					// the sampler sample_lights used (pt_light_spherical_tri).
					float pdfw = (global_ubo.pt_light_spherical_tri != 0)
						? get_spherical_triangle_pdfw(projected_positions)
						: get_triangle_pdfw(projected_positions, pos_on_triangle);

					direct_specular_weight *= get_specular_sampled_lighting_weight(primary_roughness,
						normal, -view_direction.xyz, bounce_direction, pdfw);
				}

				bounce_contrib = bounce_throughput * env * indirect_specular_weight * (1.0 - direct_specular_weight);
			}
		}

		if(bounce_number < global_ubo.pt_num_bounce_rays - 1)
		{
			imageStore(IMG_PT_SHADING_POSITION, ipos, vec4(0));
		}
	}
	else
	{
		vec3 bary         = get_hit_barycentric(ray_payload_geometry);
		vec2 tex_coord    = triangle.tex_coords * bary;
		uint bounce_material_id = triangle.material_id;

		if((bounce_material_id & MATERIAL_FLAG_WARP) != 0)
		{
			tex_coord = lava_uv_warp(tex_coord, global_ubo.time);
		}

		MaterialInfo bounce_minfo = get_material_info(triangle.material_id);

		// world-space
		vec3 bounce_position = triangle.positions * bary;
		vec3 bounce_geo_normal = normalize(triangle.normals * bary);
			
		vec3 bounce_flat_normal = normalize(cross(
			triangle.positions[1] - triangle.positions[0],
			triangle.positions[2] - triangle.positions[1]));
		
		if (dot(bounce_flat_normal, bounce_direction) > 0)
			bounce_geo_normal = -bounce_geo_normal;

		if(gi_candidate)
			gi_sample_normal = dot(bounce_geo_normal, bounce_direction) > 0 ? -bounce_geo_normal : bounce_geo_normal;
		
		vec3 bounce_normal  = bounce_geo_normal;
		uint bounce_cluster_idx    = triangle.cluster;

		// pt_bounce_material 0's colour and emission. Under 1 (the default)
		// get_material below writes both through `out` parameters, so these two
		// fetches were made and thrown away on every bounce hit.
		vec3 bounce_base_color = vec3(bounce_minfo.base_factor);
		vec3 emissive = vec3(0);
		if (global_ubo.pt_bounce_material == 0)
		{
			if (bounce_minfo.base_texture != 0)
				bounce_base_color *= global_textureLod(bounce_minfo.base_texture, tex_coord, 2).rgb;
			bounce_base_color = clamp(bounce_base_color, vec3(0), vec3(1));

			emissive = sample_emissive_texture(triangle.material_id, bounce_minfo, tex_coord, vec2(0), vec2(0), is_specular_ray ? 2 : 3);
			emissive *= triangle.emissive_factor;
			emissive += get_emissive_shell(triangle.material_id) * bounce_base_color;
			emissive += get_emissive_q3_quad(triangle.material_id, triangle.texture_flags, bounce_geo_normal, bounce_direction);
		}

		// What the hit reflects. With pt_bounce_material 0 these are exactly the
		// old white-diffuse values, so every expression below is unchanged.
		vec3 bounce_albedo = bounce_base_color;
		vec3 bounce_base_reflectivity = vec3(0);
		float bounce_specular_factor = 0.0;
		float bounce_roughness = 1.0;
		float bounce_direct_specular = 0.0;
		vec3 bounce_light_normal = bounce_geo_normal;

		if (global_ubo.pt_bounce_material != 0)
		{
			/* Ray cone width at the hit. The camera leg uses the pixel angle
			   (P[1][1] = 1 / tan(fov_y / 2)); the bounce leg adds the lobe's
			   spread. Photo mode keeps only the pixel footprint: the reference
			   must not be prefiltered by a guess at the lobe. */
			// abs: P[1][1] is negative (Vulkan Y flip). Without it the cone came out negative,
			// was clamped to nothing, and every bounce hit sampled mip 0.
			float pixel_angle = 2.0 / (abs(global_ubo.P[1][1]) * float(global_ubo.height));
			float lobe_spread = is_specular_ray
				? 2.0 * primary_roughness * primary_roughness
				: global_ubo.pt_bounce_cone_diffuse;
			if (global_ubo.temporal_blend_factor > 0.0)
				lobe_spread = 0.0;
			float cone_width = pixel_angle * length(position - global_ubo.cam_pos.xyz)
			                 + (pixel_angle + lobe_spread) * ray_payload_geometry.hit_distance;

			float lod = bounce_texture_lod(triangle, bounce_minfo.base_texture, cone_width, bounce_direction, bounce_geo_normal);

			// The glow at the pixel footprint's mip only - photo mode's, live too
			// (path_tracer_rgen.h get_material_emissive_lod): a glow map's small
			// mips spread its glow over neighbours in the atlas. And across the
			// footprint, not along it: the normal for the ray direction leaves out
			// bounce_texture_lod's 1/cos, which at a grazing hit is 4 mips more,
			// blurring BOTH ways by the footprint's long axis - an isotropic
			// lookup's mistake that anisotropic filtering does not make. Took a
			// Quake lamp's small map past its bright band, and the nailgun's
			// (bleeding from mip 5) past what pt_bounce_lod_bias -2 could undo.
			// pt_bounce_emissive_lod 0: left at -1, the emissive map takes `lod` as before 11-23
			if (global_ubo.pt_bounce_emissive_lod != 0)
				get_material_emissive_lod = bounce_texture_lod(triangle, bounce_minfo.emissive_texture,
					pixel_angle * (length(position - global_ubo.cam_pos.xyz) + ray_payload_geometry.hit_distance),
					bounce_geo_normal, bounce_geo_normal);

			vec3 mapped_normal;
			float metallic;
			get_material_allow_pom = false;
			get_material(triangle, bary, triangle.tex_coords * bary, vec2(0), vec2(0), lod,
				bounce_geo_normal, bounce_direction,
				bounce_base_color, mapped_normal, metallic, bounce_roughness, emissive, bounce_specular_factor);
			get_material_emissive_lod = -1.0;

			// A normal map may tip the normal past the horizon at grazing hits;
			// shade those with the geometric normal instead.
			if (dot(mapped_normal, bounce_direction) < 0)
				bounce_normal = mapped_normal;
			bounce_light_normal = bounce_normal;

			get_reflectivity(bounce_base_color, metallic, bounce_albedo, bounce_base_reflectivity);
			bounce_direct_specular = 1.0;

			/* pt_restir_gi_secondary_roughness: the light leaving this hit becomes a ReSTIR GI
			   candidate, which other pixels reuse as if it left the hit evenly in all
			   directions - so its highlight toward THIS pixel must not be sharp, or one
			   glint becomes a bright sample spread over the neighbours. RTXDI's ReSTIR GI
			   notes advise clamping the secondary roughness. The hit's light, and the lobe
			   the path goes on from it with (pt_bounce_brdf). */
			if(gi_candidate && global_ubo.pt_restir_gi_secondary_roughness > 0)
				bounce_roughness = max(bounce_roughness, global_ubo.pt_restir_gi_secondary_roughness);

			/* pt_bounce_min_roughness - see global_ubo.h. Path regularisation: a bounce
			   cannot resolve a lobe sharper than the one it left, so a diffuse bounce (or
			   any later one) lights the surface it lands on with at least this roughness,
			   and a specular bounce off the first surface with at least that surface's
			   own roughness. This hit's lamp and sun highlight sees it, and so does the
			   lobe the path goes on from it with (pt_bounce_brdf). */
			if(global_ubo.pt_bounce_min_roughness > 0)
			{
				float min_roughness = global_ubo.pt_bounce_min_roughness;
				// the lobe this ray left: the primary surface's, or (pt_bounce_brdf) the
				// one the last bounce hit picked - so a mirror seen in a mirror seen in a
				// roughness-0 floor stays a mirror
				if(is_specular_ray)
					min_roughness = min(min_roughness, primary_roughness);
				bounce_roughness = max(bounce_roughness, min_roughness);
			}
		}

		if(luminance(emissive) > 0) 
		{        
			emissive *= bounce_throughput;

			// spotlight term that matches the sample_light_lists() function in light_lists.h
			float spotlight = sqrt(max(0, -dot(bounce_direction, bounce_normal)));
			emissive *= spotlight;

			// See the comment for `is_analytic_light` above under `if(is_sky(triangle.material_id))`
			// Same logic applies.

			bool is_analytic_light = (bounce_material_id & MATERIAL_FLAG_LIGHT) != 0 && ray_origin_light_sampled();

			if(is_specular_ray)
			{
				if(is_analytic_light)
				{
					// The share light sampling did not take. pt_light_mis: for a BSP-world
					// lamp hit from the first surface it is the balance-heuristic share,
					// the same get_polygon_light_mis_weight that get_direct_illumination
					// and process_selected_light_restir weighted their sample of this lamp
					// with, so the two add up to the whole highlight. Instanced models
					// (doors, lamps on models) keep the old split, as their light side does.
					float light_share = direct_specular_weight;
					// (not through a portal: add_portal_light keeps the plain split)
					if(light_share > 0 && spec_bounce_index == 0 && bounce_origin_flags >= 0.0
						&& global_ubo.pt_light_mis != 0 && global_ubo.pt_specular_mis != 0
						&& (ray_payload_geometry.buffer_and_instance_idx & 0xffff) == VERTEX_BUFFER_WORLD
						&& triangle.instance_index == ~0u)
					{
						uint primary_cluster = texelFetch(TEX_PT_CLUSTER_A, ipos, 0).x;
						if(primary_cluster == 0xffff) primary_cluster = ~0u; // uint16 image
						light_share *= get_polygon_light_mis_weight(primary_roughness, normal,
							-view_direction.xyz, bounce_direction, primary_cluster,
							triangle.positions, length(triangle.positions * bary - position));
					}
					bounce_contrib += emissive * (1.0 - light_share);
				}
				else
					bounce_contrib += emissive * indirect_specular_weight;
			}
			else 
			{
				if(!is_analytic_light)
					bounce_contrib += emissive;
			}
		}

		if(dot(bounce_direction, bounce_normal) > 0)
			bounce_normal = -bounce_normal;

		// The specular part of the hit's direct light is not tinted by its
		// diffuse albedo - its colour is in the Fresnel term.
		vec3 bounce_specular_throughput = bounce_throughput * indirect_specular_weight;

		/* pt_bounce_albedo_power: how much light a surface hands on to the next bounce.
		   Measured 2026-10-06, the rerelease base textures average a LINEAR albedo of
		   0.04 (median 0.02) - each bounce keeps 2-4% of its light, so a second bounce
		   is ~0.1% of the image and 2 vs 8 bounces look identical. Remastered PBR
		   textures sit around 0.2-0.6. Raising the albedo to a power below 1 lifts dark
		   surfaces far more than bright ones (0.5: 0.02 -> 0.14, 0.1 -> 0.32,
		   0.5 -> 0.71) and only for light bouncing off them; the surfaces look the same
		   on screen. Capped at 0.9 so a path can never gain energy. 1 = physical.
		   A material's albedo_strength replaces the cvar for that surface: the
		   textures are not uniformly dark, so one global power over- or under-lifts
		   some of them. */
		float albedo_power = bounce_minfo.albedo_strength > 0.0
			? bounce_minfo.albedo_strength
			: global_ubo.pt_bounce_albedo_power;
		vec3 bounce_reflectance = bounce_albedo;
		if(albedo_power != 1.0)
			bounce_reflectance = min(pow(max(bounce_albedo, vec3(0)), vec3(max(albedo_power, 0.05))), vec3(0.9));

		// the hit's diffuse light (light sampling, sun, radiance cache) comes in with this
		bounce_throughput *= bounce_reflectance;
		bounce_throughput *= indirect_specular_weight;

		float sun_bounce_range = global_ubo.pt_sun_bounce_range;
		if(is_specular_ray)
			sun_bounce_range *= (1 - sqrt(primary_roughness));
		
		float sun_attenuation = square(clamp(1.0 - square(square(ray_payload_geometry.hit_distance / sun_bounce_range)), 0, 1));

		/* Light sampling at the hit. The first bounce always had it. Every later bounce
		   used to get only the sun (below) and whatever non-light emissive it happened to
		   hit, so indoors a second bounce carried almost nothing: the lamps that light a
		   room were never sampled from its walls. pt_bounce_nee samples them at every
		   bounce, the same way, with that bounce's own random numbers. */
		bool light_sample_here = bounce_number == 0 || global_ubo.pt_bounce_nee != 0;

		/* WHERE THE PATH GOES FROM HERE (pt_bounce_brdf), when a later bounce pass will
		   trace it: this hit's own material picks the ray - see sample_bounce_lobe. Its
		   lamp highlight is then shared the way the primary surface's is: light sampling
		   below takes direct_specular_weight of it (pt_direct_roughness_threshold), the
		   specular ray that finds the lamp the rest - both from the same stored, rounded
		   roughness, so the two add up to exactly the highlight. With no later pass,
		   light sampling keeps all of it, as before. */
		bool path_goes_on = bounce_number < global_ubo.pt_num_bounce_rays - 1;
		float next_roughness = bounce_store_roughness(bounce_roughness);
		float hit_direct_specular = bounce_direct_specular;
		if(path_goes_on && global_ubo.pt_bounce_brdf != 0)
			hit_direct_specular *= smoothstep(
				global_ubo.pt_direct_roughness_threshold - 0.02,
				global_ubo.pt_direct_roughness_threshold + 0.02,
				next_roughness);

		// Nothing for light sampling to light - a mirror (no diffuse lobe) whose highlight
		// all goes to its reflection ray: no shadow ray. It still counts as light sampled.
		bool nee_has_work = any(greaterThan(bounce_reflectance, vec3(0))) || hit_direct_specular > 0;

		if(light_sample_here && nee_has_work)
		{
			bool is_gradient = get_is_gradient(ipos);

			vec3 bounce_diffuse, bounce_specular;
			get_direct_illumination(
				bounce_position,
				bounce_light_normal,
				bounce_geo_normal,
				bounce_cluster_idx,
				bounce_material_id,
				shadow_cull_mask,
				bounce_direction,
				bounce_albedo,
				bounce_base_reflectivity,
				bounce_specular_factor,
				bounce_roughness,
				MEDIUM_NONE,
				false, // enable_caustics
				hit_direct_specular, // 0 = the old diffuse-only bounce (pt_bounce_material 0)
		    	global_ubo.pt_indirect_polygon_lights > 0,
		    	global_ubo.pt_indirect_dyn_lights > 0,
		    	is_gradient,
		    	bounce_number + 1, // bounce
		    	bounce_diffuse,
				bounce_specular);

			bounce_contrib += bounce_throughput * bounce_diffuse;
			bounce_contrib += bounce_specular_throughput * bounce_specular;
		}
		
		if(sun_attenuation > 0)
		{
			vec3 bounce_sun_diffuse, bounce_sun_specular;
			get_sunlight(
				bounce_cluster_idx,
				bounce_material_id,
				bounce_position,
				bounce_normal,
				bounce_geo_normal,
				bounce_direction,
				bounce_base_reflectivity,
				bounce_specular_factor,
				bounce_roughness,
				MEDIUM_NONE,
				false, // enable_caustics
				bounce_sun_diffuse,
				bounce_sun_specular,
				shadow_cull_mask);
			bounce_contrib += bounce_throughput * bounce_sun_diffuse * global_ubo.sun_bounce_scale * sun_attenuation;
			// zero with pt_bounce_material 0 (base_reflectivity 0)
			if (global_ubo.pt_bounce_material != 0)
				bounce_contrib += bounce_specular_throughput * bounce_sun_specular * global_ubo.sun_bounce_scale * sun_attenuation;
		}

		// Radiance cache (pt_sharc): the path ends here, so instead of stopping in the
		// dark, pick up the light that would have kept bouncing - see sharc.h. Where this
		// hit was not light sampled above, the cache's direct light stands in for that
		// too, unless pt_sharc is 2. bounce_throughput already carries this hit's albedo.
		if(sharc_enabled() && bounce_number >= global_ubo.pt_num_bounce_rays - 1)
		{
			// oriented exactly as sharc_update.rgen orients it, or the normal bins differ
			vec3 cache_normal = dot(bounce_geo_normal, bounce_direction) > 0 ? -bounce_geo_normal : bounce_geo_normal;
			vec3 cached_indirect, cached_direct;
			bool sharc_found = sharc_lookup_bounce(bounce_position, cache_normal, ray_payload_geometry.hit_distance,
				rng_seed ^ (uint(bounce_number) * 0x9e3779b9u), cached_indirect, cached_direct);
			sharc_debug_hit = sharc_found ? 1 : 0;
			if(sharc_found)
			{
				vec3 cached = cached_indirect;
				if(!light_sample_here && global_ubo.pt_sharc != 2)
					cached += cached_direct;
				bounce_contrib += bounce_throughput * cached * global_ubo.pt_sharc_scale;
			}
		}

		if(path_goes_on)
		{
			// the ray from here, picked only now: nothing of it is held across the light
			// sampling above (registers)
			vec3 next_direction, next_throughput;
			bool next_specular;
			// (facing the arriving ray, as the radiance cache orients it: an interpolated
			// normal can face away at a silhouette)
			vec3 facing_geo_normal = dot(bounce_geo_normal, bounce_direction) > 0 ? -bounce_geo_normal : bounce_geo_normal;
			bool next_usable = sample_bounce_lobe(bounce_direction, bounce_normal, facing_geo_normal,
				bounce_albedo, bounce_reflectance, bounce_base_reflectivity, bounce_specular_factor,
				bounce_roughness, bounce_specular_throughput,
				next_direction, next_throughput, next_specular);

			/* RUSSIAN ROULETTE (pt_bounce_rr), from the third bounce on: continue with
			   probability p = the path's remaining throughput and divide by p, so the
			   estimate stays unbiased while a path that has already lost most of its
			   light - three Quake albedos in, about 3% is left - is usually not traced
			   further. What keeps 8 bounces from costing 8 bounce passes. Never ends a
			   path at the first or second bounce, so 1 and 2 bounces are unchanged. */
			// a lobe sample that carries nothing (sample_bounce_lobe) ends the path
			bool continue_path = next_usable;

			/* pt_bounce_cull: a path with nothing left to carry (a black texel, a failed
			   specular sample: throughput exactly zero) ends here - whatever it found
			   further on would be multiplied by zero. Under 1 and 3, roulette also
			   starts at the second bounce, except behind a diffuse first bounce that is
			   a ReSTIR GI candidate: that light becomes the candidate's radiance, the
			   resampling target, and a 1/p-weighted survivor would be picked and spread
			   around. Under 1 a path is also kept as often as its own pixel needs it -
			   bounce_cull_keep_probability(). */
			bool rr_on = global_ubo.pt_bounce_rr != 0;
			int rr_from = 2;
			if(global_ubo.pt_bounce_cull != 0)
			{
				if(!any(greaterThan(next_throughput, vec3(0))))
					continue_path = false;
				if(global_ubo.pt_bounce_cull == 1 || global_ubo.pt_bounce_cull == 3)
				{
					rr_on = true;
					if(!gi_candidate)
						rr_from = 1;
				}
			}

			if(continue_path && rr_on && bounce_number + 1 >= rr_from)
			{
				float p = clamp(max(next_throughput.r, max(next_throughput.g, next_throughput.b)), 0.05, 1.0);
				if(global_ubo.pt_bounce_cull == 1)
				{
					// the channel the rest of the path lands in: the first bounce's lobe
					bool rest_specular = (spec_bounce_index == 0) ? is_specular_ray : first_bounce_is_specular;
					p = max(p, bounce_cull_keep_probability(ipos, bounce_contrib, next_throughput, rest_specular));
				}
				if(get_rng(RNG_RUSSIAN_ROULETTE(bounce_number + 1)) >= p)
					continue_path = false;
				else
					next_throughput /= p;
			}

			if(continue_path)
			{
				// the next bounce's ray, ready to trace (see the top)
				imageStore(IMG_PT_GEO_NORMAL2, ipos, uvec4(encode_normal(next_direction)));
				imageStore(IMG_PT_SHADING_POSITION, ipos, vec4(bounce_position.xyz, uintBitsToFloat(triangle.material_id)));
				float flags = (light_sample_here ? BOUNCE_FLAG_LIGHT_SAMPLED : 0.0)
				            + (next_specular ? BOUNCE_FLAG_SPECULAR : 0.0);
				imageStore(IMG_PT_VIEW_DIRECTION2, ipos, vec4(bounce_direction, 2.0 * flags + next_roughness));
				// .a says which channel the rest of the path lands in: the FIRST bounce's
				// lobe, carried through every later bounce, whatever their own lobes.
				bool path_is_specular = (spec_bounce_index == 0) ? is_specular_ray : first_bounce_is_specular;
				imageStore(IMG_PT_BOUNCE_THROUGHPUT, ipos, vec4(next_throughput, path_is_specular ? 1 : 0));
				path_continues = true;
			}
			else
			{
				// The path ends: the later bounce passes find material 0 and stand down.
				imageStore(IMG_PT_SHADING_POSITION, ipos, vec4(0));
			}
		}
	}

	// (the first bounce's own specular only: a later bounce's ray is specular for the
	// surface it left, not for the primary one)
	if (is_specular_ray && spec_bounce_index == 0)
		bounce_contrib = demodulate_specular(primary_base_reflectivity, bounce_contrib);

	// a later bounce lands in the channel of the first bounce's lobe, whatever its own ray
	if(spec_bounce_index > 0)
		is_specular_ray = first_bounce_is_specular;

	if(spec_bounce_index > 0)
		bounce_direction = view_direction.xyz;
}

void
main()
{
#ifdef KHR_RAY_QUERY
	// pt_bounce_cull: a later bounce over a path list takes its pixel from the list
	pt_path_launch_init();
	if (pt_tile_launch_none())
		return;
#endif

	ivec2 ipos = ivec2(rt_LaunchID.xy);
	if(rt_LaunchID.z != 0)
		ipos.x += global_ubo.pt_field_offset;

	// See bounce_number at the top: the second-bounce pipeline runs once per later bounce.
	bounce_number = (spec_bounce_index == 0) ? 0 : max(1, push_constants.bounce_index);

	// Half-resolution tracing happens in the "low" GI setting
	bool half_res = global_ubo.pt_num_bounce_rays == 0.5;

	if(half_res)
	{
		// Tracing threads are launched in a dense grid whose vertical
		// size is only half of the frame, so rename the threads.
		// This is more efficient than launching an entire frame of 
		// threads and then doing nothing in every other row.
		ipos.y = ipos.y * 2 + (global_ubo.current_frame_idx & 1);
	}

	vec3 bounce_direction;
	vec3 bounce_contrib;
	bool is_specular_ray;

	// Split-field mode: nothing to bounce for field 1 unless this pixel's two Fresnel
	// paths genuinely diverged - see direct_lighting.rgen. This is the pass that
	// dominated the cost of split-field mode.
	if(global_ubo.pt_fullres_fields != 0)
	{
		bool is_second_field = (rt_LaunchID.z != 0) || (push_constants.gpu_index == 1);
		int cb_flags = int(imageLoad(IMG_PT_VIEW_DIRECTION, ipos).w) & CHECKERBOARD_FLAG_FIELD_MASK;

		// Field 1 is idle wherever the two paths never diverged. In half-resolution mode
		// both fields are also idle on the rows this frame is not tracing - but only on
		// reflect/refract materials, so the opaque frame stays at full render resolution.
		bool field1_idle = is_second_field && bitCount(cb_flags) <= 1;
		bool row_idle = !PT_FIELD_ROW_TRACED(global_ubo, ipos.y)
			&& IS_REFLECT_REFRACT_KIND(floatBitsToUint(imageLoad(IMG_PT_SHADING_POSITION, ipos).w));

		if(field1_idle || row_idle)
			return;
	}

	// SPARSE RENDERING (pt_sparse, constants.h): the first bounce lights the pixels direct
	// lighting did. Over the sparse path list those are all there is; over the whole grid
	// (no tile buffer, half-resolution bounces, SER on D3D12) the others stop here, and
	// end their path for the later bounces as a miss would.
	if(spec_bounce_index == 0 && global_ubo.pt_sparse > 0.0
		&& push_constants.tile_read_list != PT_PATH_LIST_SPARSE && !sparse_pixel_active(ipos))
	{
		if(bounce_number < global_ubo.pt_num_bounce_rays - 1)
			imageStore(IMG_PT_SHADING_POSITION, ipos, vec4(0));
		return;
	}

	// pt_sharc 3: debug view of the radiance cache itself. The screen shows what the
	// cache holds at each visible surface (indirect + direct, times the albedo applied
	// downstream) and nothing else; black means the lookup found no usable entry.
	if(global_ubo.pt_sharc == 3 || global_ubo.pt_sharc == 5)
	{
		if(spec_bounce_index == 0)
		{
			vec3 debug_position = texelFetch(TEX_PT_SHADING_POSITION, ipos, 0).xyz;
			vec3 debug_normal = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_A, ipos, 0).x);
			vec3 cached_indirect, cached_direct;
			sharc_lookup(debug_position, debug_normal, cached_indirect, cached_direct);
			// 5 = the indirect half alone, times pt_sharc_scale
			vec3 debug_color = global_ubo.pt_sharc == 5
				? cached_indirect * global_ubo.pt_sharc_scale
				: cached_indirect + cached_direct;
			debug_color = clamp_output(debug_color) * STORAGE_SCALE_HF;

			imageStore(IMG_PT_COLOR_LF_SH, ipos, vec4(0));
			imageStore(IMG_PT_COLOR_LF_COCG, ipos, vec4(0));
			imageStore(IMG_PT_COLOR_HF, ipos, uvec4(packRGBE(debug_color)));
			imageStore(IMG_PT_COLOR_SPEC, ipos, uvec4(packRGBE(vec3(0))));
		}
		return;
	}

	indirect_lighting(ipos, half_res, bounce_direction, bounce_contrib, is_specular_ray);

	// pt_portal_light: the SH below is projected on the way the light arrives here, not
	// the way it went on from a portal (gi_sample_normal: see the trace in indirect_lighting())
	if(!gi_candidate && any(notEqual(gi_sample_normal, vec3(0))))
		bounce_direction = gi_sample_normal;

#ifdef KHR_RAY_QUERY
	// pt_bounce_cull: the next bounce runs only over the paths that go on to it. Every
	// thread still here takes part; the ones that returned above never have a next bounce.
	if (push_constants.tile_append_list != 0u)
		pt_path_append(push_constants.tile_append_list, path_continues, rt_LaunchID);
#endif

	// pt_sharc 4: hit-rate view of the cache lookups the path tracer itself makes at its
	// last bounce. Green = found a usable entry, red = missed, black = the path ended
	// in sky / nothing before reaching the last bounce. Best with flt_fixed_albedo 1.
	if(global_ubo.pt_sharc == 4)
	{
		if(spec_bounce_index == 0)
		{
			imageStore(IMG_PT_COLOR_LF_SH, ipos, vec4(0));
			imageStore(IMG_PT_COLOR_LF_COCG, ipos, vec4(0));
			imageStore(IMG_PT_COLOR_HF, ipos, uvec4(packRGBE(vec3(0))));
			imageStore(IMG_PT_COLOR_SPEC, ipos, uvec4(packRGBE(vec3(0))));
		}
		if(sharc_debug_hit >= 0)
		{
			vec3 marker = (sharc_debug_hit == 1 ? vec3(0, 1, 0) : vec3(1, 0, 0)) * global_ubo.prev_adapted_luminance * 2.0;
			imageStore(IMG_PT_COLOR_HF, ipos, uvec4(packRGBE(marker * STORAGE_SCALE_HF)));
		}
		return;
	}

	// ReSTIR GI, first bounce: every pixel leaves restir_gi.rgen a candidate (or a marker
	// saying why there is none), and a diffuse bounce stops here instead of lighting
	// the pixel - restir_gi.rgen does that with whichever sample wins.
	if(spec_bounce_index == 0 && restir_gi_enabled())
	{
		imageStore(IMG_PT_RESTIR_GI_ORIGIN_A, ipos, vec4(gi_origin, uintBitsToFloat(encode_normal(gi_origin_normal))));

		if(gi_candidate && !gi_no_diffuse)
		{
			vec3 contrib = clamp_output(bounce_contrib);
			vec3 radiance = vec3(
				gi_t0.x > 1e-6 ? contrib.x / gi_t0.x : 0,
				gi_t0.y > 1e-6 ? contrib.y / gi_t0.y : 0,
				gi_t0.z > 1e-6 ? contrib.z / gi_t0.z : 0);

			// POS.w carries the pre-lobe throughput until restir_gi.rgen replaces it with W.
			imageStore(IMG_PT_RESTIR_GI_POS_A, ipos, vec4(gi_sample_pos, uintBitsToFloat(packRGBE(gi_base))));
			imageStore(IMG_PT_RESTIR_GI_DATA_A, ipos, uvec4(
				encode_normal(gi_sample_normal),
				packRGBE(radiance),
				floatBitsToUint(RESTIR_GI_CAND_DIFFUSE),
				packRGBE(gi_t0)));
			return;
		}

		// A material-0 or lava pixel returns from indirect_lighting() with
		// is_specular_ray false and nothing sampled. A pixel that is not taking part
		// (half-resolution GI) is INVALID too, so no stale reservoir keeps shading it.
		// So is a pure metal: it has no diffuse lobe, and without this a reservoir
		// reprojected from a neighbouring dielectric lit it with diffuse light.
		float marker = (gi_active && is_specular_ray && !gi_no_diffuse) ? RESTIR_GI_CAND_SPECULAR : RESTIR_GI_CAND_INVALID;
		imageStore(IMG_PT_RESTIR_GI_POS_A, ipos, vec4(0, 0, 0, uintBitsToFloat(packRGBE(gi_base))));
		imageStore(IMG_PT_RESTIR_GI_DATA_A, ipos, uvec4(0, 0, floatBitsToUint(marker), 0));
	}

	if(any(isinf(bounce_contrib)) || any(isnan(bounce_contrib)) || any(isinf(bounce_direction)) || any(isnan(bounce_direction)) )
		return;

	bounce_contrib = clamp_output(bounce_contrib);

	if(all(equal(bounce_contrib, vec3(0))))
		return;

	// ReSTIR GI, second bounce behind a diffuse first bounce: this light belongs to the
	// candidate's L_o, not to the pixel. The throughput here is T0 * albedo * ..., so
	// dividing by T0 leaves what the first hit sends back.
	if(spec_bounce_index > 0 && restir_gi_enabled() && !is_specular_ray)
	{
		uvec4 data = imageLoad(IMG_PT_RESTIR_GI_DATA_A, ipos);
		if(uintBitsToFloat(data.z) == RESTIR_GI_CAND_DIFFUSE)
		{
			vec3 t0 = unpackRGBE(data.w);
			vec3 radiance = unpackRGBE(data.y);
			radiance += vec3(
				t0.x > 1e-6 ? bounce_contrib.x / t0.x : 0,
				t0.y > 1e-6 ? bounce_contrib.y / t0.y : 0,
				t0.z > 1e-6 ? bounce_contrib.z / t0.z : 0);
			data.y = packRGBE(radiance);
			imageStore(IMG_PT_RESTIR_GI_DATA_A, ipos, data);
		}
		return;
	}

	if(is_specular_ray)
	{
		bounce_contrib *= STORAGE_SCALE_SPEC;

		vec3 specular = unpackRGBE(imageLoad(IMG_PT_COLOR_SPEC, ipos).x);
		specular += bounce_contrib;
		imageStore(IMG_PT_COLOR_SPEC, ipos, uvec4(packRGBE(specular)));
	}
	else
	{
		bounce_contrib *= STORAGE_SCALE_LF;

		SH low_freq = load_SH(TEX_PT_COLOR_LF_SH, TEX_PT_COLOR_LF_COCG, ipos);

	#if ENABLE_SH
		if(global_ubo.flt_enable == 0)
			low_freq.shY.xyz += bounce_contrib;
		else
		{
			accumulate_SH(low_freq, irradiance_to_SH(bounce_contrib, bounce_direction), 1.0);
		}
	#else
		low_freq.shY.xyz += bounce_contrib;
	#endif

		STORE_SH(IMG_PT_COLOR_LF_SH, IMG_PT_COLOR_LF_COCG, ipos, low_freq);
	}
}
