// ========================================================================== //
// This rgen shader computes a single bounce of lighting for the surface
// stored in the G-buffer, and optionally writes the next surface into the 
// G-buffer for the next bounce stage.
//
// See `path_tracer.h` for an overview of the path tracer.
// ========================================================================== //

#version 460
#extension GL_GOOGLE_include_directive    : enable
#pragma optionNV(unroll all)

#include "path_tracer_rgen.h"
#include "path_tracer_transparency.glsl"
#include "sharc.h"
#include "restir_gi.h"

layout(constant_id = 0) const uint spec_bounce_index = 0;

// pt_sharc 4 debug: -1 = no cache query on this path, 0 = query missed, 1 = hit
int sharc_debug_hit = -1;

// ReSTIR GI candidate (pt_restir_gi), filled in by indirect_lighting() on the first
// bounce and written out by main() - see restir_gi.h.
bool gi_candidate = false;     // a diffuse bounce was taken; its result belongs to ReSTIR GI
vec3 gi_sample_pos = vec3(0);
vec3 gi_sample_normal = vec3(0);
vec3 gi_t0 = vec3(0);          // throughput into the bounce, before the hit's albedo
vec3 gi_origin = vec3(0);
vec3 gi_origin_normal = vec3(0);

/* Texture mip at a bounce hit from a ray cone - Akenine-Moller et al.,
   "Improved Shader and Texture Level of Detail Using Ray Cones", JCGT 2021:

     lod = 0.5 * log2(texel_area / world_area) + log2(cone_width / |cos|)

   texel_area is the triangle's UV area in texels of `tex_index`, world_area its
   area in world units, so the first term is log2 of texels per world unit. */
float
bounce_texture_lod(Triangle triangle, uint tex_index, float cone_width, vec3 ray_direction, vec3 geo_normal)
{
	if (tex_index == 0)
		return 0;

	vec2 duv0 = triangle.tex_coords[1] - triangle.tex_coords[0];
	vec2 duv1 = triangle.tex_coords[2] - triangle.tex_coords[0];
	vec3 dp0  = triangle.positions[1] - triangle.positions[0];
	vec3 dp1  = triangle.positions[2] - triangle.positions[0];

	ivec2 size = global_textureSize(tex_index, 0);
	float texel_area = abs(duv0.x * duv1.y - duv1.x * duv0.y) * float(size.x) * float(size.y);
	float world_area = length(cross(dp0, dp1));

	if (!(texel_area > 0) || !(world_area > 0))
		return 0;

	float cos_theta = max(abs(dot(ray_direction, geo_normal)), 0.05);
	float lod = 0.5 * log2(texel_area / world_area) + log2(max(cone_width, 1e-4) / cos_theta);

	return max(0, lod + global_ubo.pt_bounce_lod_bias);
}

void
indirect_lighting(
	ivec2 ipos, 
	bool half_res, 
	out vec3 bounce_direction,
	out vec3 bounce_contrib,
	out bool is_specular_ray)
{
    rng_seed = texelFetch(TEX_ASVGF_RNG_SEED_A, ipos, 0).r;
	
	uint cluster_idx = ~0u;

	vec4 position_material = texelFetch(TEX_PT_SHADING_POSITION, ipos, 0);
	
	vec3 position   = position_material.xyz;
	uint material_id = floatBitsToUint(position_material.w);

	// don't compute lighting for invalid surfaces;
	// don't compute lighting for lava because it's emissive and self-illuminating, which causes issues with the filters
	if(material_id == 0 || is_lava(material_id))
	{
		bounce_direction = vec3(0);
		bounce_contrib = vec3(0);
		is_specular_ray = false;
		return;
	}

	vec4 throughput = texelFetch(TEX_PT_BOUNCE_THROUGHPUT, ipos, 0).rgba;
	vec4 view_direction;
	vec3 normal;
    vec3 geo_normal;
    vec4 primary_base_color = vec4(0);
    float primary_metallic = 0;
	float primary_roughness = 1;
	float primary_specular_factor = 0;
	
	if(half_res)
		throughput.rgb *= 2;

	if(spec_bounce_index == 0)
	{
		// First bounce: use primary/reflected view direction,
		// actual normals of the surface, and specular parameters
		// (unless GI is set to "low", which means half res and no specular)

	    view_direction = texelFetch(TEX_PT_VIEW_DIRECTION, ipos, 0);
		normal = decode_normal(texelFetch(TEX_PT_NORMAL_A, ipos, 0).x);
	    geo_normal = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_A, ipos, 0).x);
	    primary_base_color = texelFetch(TEX_PT_BASE_COLOR_A, ipos, 0);
	    primary_specular_factor = primary_base_color.a;

	    if(!half_res)
	    {
		    vec2 metal_rough = texelFetch(TEX_PT_METALLIC_A, ipos, 0).xy;
		    primary_metallic = metal_rough.x;
			primary_roughness = metal_rough.y;
		}
	}
	else
	{
		// Second bounce: use the first bounce view direction,
		// and the geo normal of the first bounce surface.
		// These have to be stored in textures different from the primary
		// surface params, because the primary view direction and normal
		// are used for fake specular reconstruction (see `asvgf_atrous.comp`)
		// and for LF channel filtering, respectively.

	    view_direction = texelFetch(TEX_PT_VIEW_DIRECTION2, ipos, 0);
	    geo_normal = decode_normal(texelFetch(TEX_PT_GEO_NORMAL2, ipos, 0).x);
		normal = geo_normal;
	}

    vec3 primary_albedo, primary_base_reflectivity;
    get_reflectivity(primary_base_color.rgb, primary_metallic, primary_albedo, primary_base_reflectivity);

	bool use_restir_gi = spec_bounce_index == 0 && !half_res && restir_gi_enabled();
	gi_origin = position;
	gi_origin_normal = normal;


	bool primary_is_weapon = (material_id & MATERIAL_FLAG_WEAPON) != 0;

	float direct_specular_weight = smoothstep(
		global_ubo.pt_direct_roughness_threshold - 0.02, 
		global_ubo.pt_direct_roughness_threshold + 0.02, 
		primary_roughness);

	float fake_specular_weight = smoothstep(
		global_ubo.pt_fake_roughness_threshold, 
		global_ubo.pt_fake_roughness_threshold + 0.1, 
		primary_roughness);

    float NoV = max(0, -dot(normal, view_direction.xyz));

	bool first_bounce_is_specular = throughput.a != 0;

	vec3 bounce_throughput = throughput.rgb;

	is_specular_ray = false;
	{ 
		vec2 rng3 = vec2(get_rng(RNG_BRDF_X(spec_bounce_index+1)), get_rng(RNG_BRDF_Y(spec_bounce_index+1)));

		float rng_frensel = get_rng(RNG_BRDF_FRESNEL(spec_bounce_index+1));

		float specular_pdf = 0;

#if BOUNCE_SPECULAR
		if(spec_bounce_index == 0)
		{
			specular_pdf = (primary_metallic == 1 && fake_specular_weight == 0) ? 1.0 : 0.5;

			if(rng_frensel < specular_pdf) 
			{
				mat3 basis = construct_ONB_frisvad(normal);

				// Sampling of normal distribution function to compute the reflected ray.
				// See the paper "Sampling the GGX Distribution of Visible Normals" by E. Heitz, 
				// Journal of Computer Graphics Techniques Vol. 7, No. 4, 2018.
				// http://jcgt.org/published/0007/04/01/paper.pdf 

				vec3 N = normal;
				vec3 V = view_direction.xyz;
				vec3 H = ImportanceSampleGGX_VNDF(rng3, primary_roughness, V, basis);
				vec3 L = reflect(V, H);

				float NoL = max(0, dot(N, L));
				float NoH = max(0, dot(N, H));
				float VoH = max(0, -dot(V, H));

				if (NoL > 0 && NoV > 0)
				{
					// See the Heitz paper referenced above for the estimator explanation.
					//   (BRDF / PDF) = F * G2(V, L) / G1(V)
					// Assume G2 = G1(V) * G1(L) here and simplify that expression to just G1(L).
					
					float G1_NoL = G1_Smith(primary_roughness, NoL);
					vec3 F = schlick_fresnel(primary_base_reflectivity, VoH, primary_specular_factor);

					bounce_throughput *= G1_NoL * F;

					bounce_throughput *= 1 / specular_pdf;
					is_specular_ray = true;
					bounce_direction = normalize(L);
				}
			}
		}
#endif

		if(!is_specular_ray)
		{
			vec3 basis_normal, dir_sphere;
		#if ENABLE_SH
			if(spec_bounce_index == 0 && global_ubo.flt_enable != 0 && !use_restir_gi)
			{
				dir_sphere = sample_cos_hemisphere_multi(0, 1, rng3, HEMISPHERE_UNIFORMISH);
				basis_normal = geo_normal;
			}
			else
		#endif
			{
				dir_sphere = sample_cos_hemisphere(rng3);
				basis_normal = normal;
			}

			mat3 basis = construct_ONB_frisvad(basis_normal);
			bounce_direction = normalize(basis * dir_sphere);
			bounce_throughput *= 1 / (1 - specular_pdf);

			vec3 L = bounce_direction.xyz;
			vec3 V = -view_direction.xyz;
			vec3 H = normalize(V + L);
			float VoH = max(0, dot(V, H));

			vec3 F = schlick_fresnel(primary_base_reflectivity, VoH, primary_specular_factor);

			bounce_throughput *= vec3(1.0) - F;
		}
	}

	Ray bounce_ray;
	bounce_ray.origin = position;
	bounce_ray.direction = bounce_direction;
	bounce_ray.t_min = 0;
	bounce_ray.t_max = 10000;

	bounce_ray.origin -= view_direction.xyz * 0.01;

	int bounce_cull_mask = BOUNCE_RAY_CULL_MASK;
	int shadow_cull_mask = shadow_ray_cull_mask();

	if(global_ubo.first_person_model != 0 && !primary_is_weapon)
	{
		bounce_cull_mask |= AS_FLAG_VIEWER_MODELS;
		shadow_cull_mask |= AS_FLAG_VIEWER_MODELS;
	}
	else
	{
		bounce_cull_mask |= AS_FLAG_VIEWER_WEAPON;
		shadow_cull_mask |= AS_FLAG_VIEWER_WEAPON;
	}

	trace_geometry_ray(bounce_ray, true, bounce_cull_mask);

	if(use_restir_gi && !is_specular_ray)
	{
		gi_candidate = true;
		gi_t0 = bounce_throughput;
		// A miss still makes a (black) sample, somewhere far away along the ray.
		float t = found_intersection(ray_payload_geometry) ? ray_payload_geometry.hit_distance : 10000.0;
		gi_sample_pos = bounce_ray.origin + bounce_direction * t;
		gi_sample_normal = -bounce_direction; // replaced by the surface normal on a surface hit
	}

	// Specular hit distance for DLSS Ray Reconstruction (RR integration guide 3.4.9).
	//
	// This is what RR uses to judge how far a specular lobe is decoupled from the surface
	// carrying it, and therefore how aggressively to reject specular history under motion.
	// Until now only reflect_refract.rgen wrote it, and only for glass / water / chrome;
	// every other pixel kept the per-frame clear of 0, which tells RR "the specular is glued
	// to this surface, accumulate it freely".
	//
	// Harmless for world geometry - a static wall's own motion vector already approximates
	// its reflection's - but exactly wrong for the viewer weapon. The weapon is rigidly
	// attached to the camera, so its motion vector is ~0 while the room it reflects sweeps
	// past at the full camera rate. No motion vector can express "the content of this pixel
	// was replaced rather than moved", so this distance is the only signal that tells RR to
	// stop trusting the history. At 0 it accumulated for as long as the weapon stayed on
	// screen, i.e. forever - the ghosting on fast pans.
	//
	// The bounce ray above is already traced, so this costs nothing. It is taken whether the
	// ray came out specular or diffuse: for a specular ray it is exactly the quantity the
	// guide asks for, and for a diffuse ray it is a cosine-weighted sample of the same
	// neighbourhood - a far better estimate of how far away what this surface sees is than
	// zero. RR filters this input, so sample noise here is expected.
	//
	// Only the first bounce describes the primary surface, and a value already written by
	// reflect_refract.rgen is the exact mirror hit distance - do not overwrite it.
	if(spec_bounce_index == 0 && global_ubo.pt_dlss_spec_hitdist != 0
		&& imageLoad(IMG_PT_RAYLENGTH_SPECULAR, ipos).x <= 0.0)
	{
		float spec_hit_distance = found_intersection(ray_payload_geometry)
			? ray_payload_geometry.hit_distance
			: PRIMARY_RAY_T_MAX;

		imageStore(IMG_PT_RAYLENGTH_SPECULAR, ipos, vec4(spec_hit_distance));
	}

	// Diffuse hit distance for DLSS Ray Reconstruction.
	//
	// IMG_PT_RAYLENGTH_DIFFUSE had no live writer at all - the only code that filled it
	// is the commented-out block further down - so checkerboard_interleave.comp was
	// copying a never-initialised image into IMG_DLSS_RAYLENGTH_DIFFUSE. The buffer was
	// then not even handed to RR. This is the same hole that specular hit distance had.
	//
	// The guide tells RR how far away the geometry feeding a pixel's diffuse lighting is,
	// which is what sizes its diffuse spatial filter. With no signal RR has to assume a
	// wide footprint, so a small bright light - a blaster bolt against a wall - gets its
	// falloff smeared into a flat uniform wash, and light bleeds out of bright areas into
	// neighbouring dark ones, lifting the blacks.
	//
	// The bounce ray is already traced, so like the specular case this costs nothing. It
	// is written whether the bounce came out diffuse or specular: a diffuse ray is exactly
	// the cosine-weighted quantity the guide wants, and a specular ray still samples the
	// same neighbourhood. Writing every frame also keeps the image from going stale, since
	// nothing clears it.
	if(spec_bounce_index == 0)
	{
		float diff_hit_distance = found_intersection(ray_payload_geometry)
			? ray_payload_geometry.hit_distance
			: PRIMARY_RAY_T_MAX;

		imageStore(IMG_PT_RAYLENGTH_DIFFUSE, ipos, vec4(diff_hit_distance));
	}

	bounce_contrib = vec3(0);

	if(is_specular_ray)
	{
		if (found_intersection(ray_payload_geometry))
			bounce_ray.t_max = ray_payload_geometry.hit_distance;

		// a bounce is not a mirror image of the viewer, so it keeps the
		// first-person effects and drops the reflection-only twins
		vec4 transparency = trace_effects_ray(bounce_ray, /* skip_procedural = */ true, /* reflection_ray = */ false);
		bounce_contrib += transparency.rgb * transparency.a * bounce_throughput * (1.0 - direct_specular_weight);
	}

	Triangle triangle;

	bool bounce_is_sky_light = false;

	/*
		if(found_intersection(ray_payload_geometry)) {
			vec4 storedLength = imageLoad(IMG_PT_RAY_LENGTH, ipos);
			float storedDistance = storedLength[0];
			float numSamples = storedLength[1];		
		
			numSamples++;
		
			float totalDistance = storedDistance + ray_payload_geometry.hit_distance;		

			imageStore(IMG_PT_RAY_LENGTH, ipos, vec4(totalDistance, numSamples, numSamples, numSamples));
		
			if(is_specular_ray) {
				imageStore(IMG_PT_RAYLENGTH_SPECULAR, ipos, vec4(ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance));
			}
			else {
				imageStore(IMG_PT_RAYLENGTH_DIFFUSE, ipos, vec4(ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance, ray_payload_geometry.hit_distance));
			}

		}
		else {
			vec4 storedLength = imageLoad(IMG_PT_RAY_LENGTH, ipos);
			float storedDistance = storedLength[0];
			float numSamples = storedLength[1];
			float totalDistance = storedDistance + PRIMARY_RAY_T_MAX;

			numSamples++;

			imageStore(IMG_PT_RAY_LENGTH, ipos, vec4(totalDistance, numSamples, numSamples, numSamples));
			if(!is_specular_ray) {
				imageStore(IMG_PT_RAYLENGTH_DIFFUSE, ipos, vec4(PRIMARY_RAY_T_MAX, PRIMARY_RAY_T_MAX, PRIMARY_RAY_T_MAX, PRIMARY_RAY_T_MAX));
			}

		}
	*/

	if(!found_intersection(ray_payload_geometry)) 
	{
		if(spec_bounce_index < global_ubo.pt_num_bounce_rays - 1)
		{
			imageStore(IMG_PT_SHADING_POSITION, ipos, vec4(0));
		}
		return;
	}

	triangle = get_hit_triangle(ray_payload_geometry);

	float indirect_specular_weight = 1;
	if(is_specular_ray)
	{
		float cone_size = ray_payload_geometry.hit_distance * primary_roughness;
		indirect_specular_weight = 1 - fake_specular_weight;
		indirect_specular_weight /= max(1, cone_size * global_ubo.pt_specular_anti_flicker * 0.01);
	}

	if(is_sky(triangle.material_id))
	{
		// On the first bounce, analytic lights are processed in the direct lighting pass, so 
		// check if `pt_direct_polygon_lights` is non-negative:
		//   0 means disable the polygon lights contribution;
		//   1 means sample the polygon lights analytically;
		//   -1 means replace the polygon lights with bounce ray sampling.
		// On the second bounce, analytic lights are processed in the first bounce pass,
		// guided by the same rules for the `pt_indirect_polygon_lights` setting.

		bool is_analytic_light = (triangle.material_id & MATERIAL_FLAG_LIGHT) != 0 && 
			((spec_bounce_index == 0) && (global_ubo.pt_direct_polygon_lights >= 0)	|| 
			 (spec_bounce_index == 1) && (global_ubo.pt_indirect_polygon_lights >= 0));

		if(!is_analytic_light || is_specular_ray)
		{
			vec3 env = env_map(bounce_direction, true);

			env *= global_ubo.pt_env_scale;
			
			if(!is_analytic_light)
				bounce_contrib = bounce_throughput * env * indirect_specular_weight;
			else if(is_specular_ray)
			{
				// MIS with direct specular
				if (global_ubo.pt_specular_mis != 0)
				{
					mat3 projected_positions = project_triangle(triangle.positions, position);

					vec3 bary = get_hit_barycentric(ray_payload_geometry);
					vec3 pos_on_triangle = triangle.positions * bary;
					pos_on_triangle -= position;
					pos_on_triangle = normalize(pos_on_triangle);

					float pdfw = get_triangle_pdfw(projected_positions, pos_on_triangle);

					direct_specular_weight *= get_specular_sampled_lighting_weight(primary_roughness,
						normal, -view_direction.xyz, bounce_direction, pdfw);
				}

				bounce_contrib = bounce_throughput * env * indirect_specular_weight * (1.0 - direct_specular_weight);
			}
		}

		if(spec_bounce_index < global_ubo.pt_num_bounce_rays - 1)
		{
			imageStore(IMG_PT_SHADING_POSITION, ipos, vec4(0));
		}
	}
	else
	{
		vec3 bary         = get_hit_barycentric(ray_payload_geometry);
		vec2 tex_coord    = triangle.tex_coords * bary;
		uint bounce_material_id = triangle.material_id;

		if((bounce_material_id & MATERIAL_FLAG_WARP) != 0)
		{
			tex_coord = lava_uv_warp(tex_coord, global_ubo.time);
		}

		MaterialInfo bounce_minfo = get_material_info(triangle.material_id);

		// world-space
		vec3 bounce_position = triangle.positions * bary;
		vec3 bounce_geo_normal = normalize(triangle.normals * bary);
			
		vec3 bounce_flat_normal = normalize(cross(
			triangle.positions[1] - triangle.positions[0],
			triangle.positions[2] - triangle.positions[1]));
		
		if (dot(bounce_flat_normal, bounce_direction) > 0)
			bounce_geo_normal = -bounce_geo_normal;

		if(gi_candidate)
			gi_sample_normal = dot(bounce_geo_normal, bounce_direction) > 0 ? -bounce_geo_normal : bounce_geo_normal;
		
		vec3 bounce_normal  = bounce_geo_normal;
		vec3 bounce_base_color = vec3(bounce_minfo.base_factor);
		if (bounce_minfo.base_texture != 0)
			bounce_base_color *= global_textureLod(bounce_minfo.base_texture, tex_coord, 2).rgb;
		bounce_base_color = clamp(bounce_base_color, vec3(0), vec3(1));
		uint bounce_cluster_idx    = triangle.cluster;


		vec3 emissive = sample_emissive_texture(triangle.material_id, bounce_minfo, tex_coord, vec2(0), vec2(0), is_specular_ray ? 2 : 3);
		

		emissive *= triangle.emissive_factor;

    	emissive += get_emissive_shell(triangle.material_id) * bounce_base_color;

		// What the hit reflects. With pt_bounce_material 0 these are exactly the
		// old white-diffuse values, so every expression below is unchanged.
		vec3 bounce_albedo = bounce_base_color;
		vec3 bounce_base_reflectivity = vec3(0);
		float bounce_specular_factor = 0.0;
		float bounce_roughness = 1.0;
		float bounce_direct_specular = 0.0;
		vec3 bounce_light_normal = bounce_geo_normal;

		if (global_ubo.pt_bounce_material != 0)
		{
			/* Ray cone width at the hit. The camera leg uses the pixel angle
			   (P[1][1] = 1 / tan(fov_y / 2)); the bounce leg adds the lobe's
			   spread. Photo mode keeps only the pixel footprint: the reference
			   must not be prefiltered by a guess at the lobe. */
			// abs: P[1][1] is negative (Vulkan Y flip). Without it the cone came out negative,
			// was clamped to nothing, and every bounce hit sampled mip 0.
			float pixel_angle = 2.0 / (abs(global_ubo.P[1][1]) * float(global_ubo.height));
			float lobe_spread = is_specular_ray
				? 2.0 * primary_roughness * primary_roughness
				: global_ubo.pt_bounce_cone_diffuse;
			if (global_ubo.temporal_blend_factor > 0.0)
				lobe_spread = 0.0;
			float cone_width = pixel_angle * length(position - global_ubo.cam_pos.xyz)
			                 + (pixel_angle + lobe_spread) * ray_payload_geometry.hit_distance;

			float lod = bounce_texture_lod(triangle, bounce_minfo.base_texture, cone_width, bounce_direction, bounce_geo_normal);

			vec3 mapped_normal;
			float metallic;
			get_material_allow_pom = false;
			get_material(triangle, bary, triangle.tex_coords * bary, vec2(0), vec2(0), lod,
				bounce_geo_normal, bounce_direction,
				bounce_base_color, mapped_normal, metallic, bounce_roughness, emissive, bounce_specular_factor);

			// A normal map may tip the normal past the horizon at grazing hits;
			// shade those with the geometric normal instead.
			if (dot(mapped_normal, bounce_direction) < 0)
				bounce_normal = mapped_normal;
			bounce_light_normal = bounce_normal;

			get_reflectivity(bounce_base_color, metallic, bounce_albedo, bounce_base_reflectivity);
			bounce_direct_specular = 1.0;
		}

		if(luminance(emissive) > 0) 
		{        
			emissive *= bounce_throughput;

			// spotlight term that matches the sample_light_lists() function in light_lists.h
			float spotlight = sqrt(max(0, -dot(bounce_direction, bounce_normal)));
			emissive *= spotlight;

			// See the comment for `is_analytic_light` above under `if(is_sky(triangle.material_id))`
			// Same logic applies.

			bool is_analytic_light = (bounce_material_id & MATERIAL_FLAG_LIGHT) != 0 && 
				((spec_bounce_index == 0) && (global_ubo.pt_direct_polygon_lights >= 0)	|| 
				 (spec_bounce_index == 1) && (global_ubo.pt_indirect_polygon_lights >= 0));

			if(is_specular_ray)
			{
				if(is_analytic_light)
					bounce_contrib += emissive * (1.0 - direct_specular_weight);
				else
					bounce_contrib += emissive * indirect_specular_weight;
			}
			else 
			{
				if(!is_analytic_light)
					bounce_contrib += emissive;
			}
		}

		if(dot(bounce_direction, bounce_normal) > 0)
			bounce_normal = -bounce_normal;

		// The specular part of the hit's direct light is not tinted by its
		// diffuse albedo - its colour is in the Fresnel term.
		vec3 bounce_specular_throughput = bounce_throughput * indirect_specular_weight;

		bounce_throughput *= bounce_albedo;
		bounce_throughput *= indirect_specular_weight;

		float sun_bounce_range = global_ubo.pt_sun_bounce_range;
		if(is_specular_ray)
			sun_bounce_range *= (1 - sqrt(primary_roughness));
		
		float sun_attenuation = square(clamp(1.0 - square(square(ray_payload_geometry.hit_distance / sun_bounce_range)), 0, 1));

		if(spec_bounce_index == 0)
		{
			bool is_gradient = get_is_gradient(ipos);

			vec3 bounce_diffuse, bounce_specular;
			get_direct_illumination(
				bounce_position,
				bounce_light_normal,
				bounce_geo_normal,
				bounce_cluster_idx,
				bounce_material_id,
				shadow_cull_mask,
				bounce_direction,
				bounce_albedo,
				bounce_base_reflectivity,
				bounce_specular_factor,
				bounce_roughness,
				MEDIUM_NONE,
				false, // enable_caustics
				bounce_direct_specular, // 0 = the old diffuse-only bounce
		    	global_ubo.pt_indirect_polygon_lights > 0,
		    	global_ubo.pt_indirect_dyn_lights > 0,
		    	is_gradient,
		    	1, // bounce
		    	bounce_diffuse,
				bounce_specular);

			bounce_contrib += bounce_throughput * bounce_diffuse;
			bounce_contrib += bounce_specular_throughput * bounce_specular;
		}
		
		if(sun_attenuation > 0)
		{
			vec3 bounce_sun_diffuse, bounce_sun_specular;
			get_sunlight(
				bounce_cluster_idx,
				bounce_material_id,
				bounce_position,
				bounce_normal,
				bounce_geo_normal,
				bounce_direction,
				bounce_base_reflectivity,
				bounce_specular_factor,
				bounce_roughness,
				MEDIUM_NONE,
				false, // enable_caustics
				bounce_sun_diffuse,
				bounce_sun_specular,
				shadow_cull_mask);
			bounce_contrib += bounce_throughput * bounce_sun_diffuse * global_ubo.sun_bounce_scale * sun_attenuation;
			// zero with pt_bounce_material 0 (base_reflectivity 0)
			if (global_ubo.pt_bounce_material != 0)
				bounce_contrib += bounce_specular_throughput * bounce_sun_specular * global_ubo.sun_bounce_scale * sun_attenuation;
		}

		// Radiance cache (pt_sharc): the path ends here, so instead of stopping in the
		// dark, pick up the light that would have kept bouncing - see sharc.h. At the
		// second bounce there was no NEE above either, so that comes from the cache too
		// unless pt_sharc is 2. bounce_throughput already carries this hit's albedo.
		if(sharc_enabled() && spec_bounce_index >= global_ubo.pt_num_bounce_rays - 1)
		{
			// oriented exactly as sharc_update.rgen orients it, or the normal bins differ
			vec3 cache_normal = dot(bounce_geo_normal, bounce_direction) > 0 ? -bounce_geo_normal : bounce_geo_normal;
			vec3 cached_indirect, cached_direct;
			bool sharc_found = sharc_lookup_bounce(bounce_position, cache_normal, ray_payload_geometry.hit_distance,
				rng_seed ^ (spec_bounce_index * 0x9e3779b9u), cached_indirect, cached_direct);
			sharc_debug_hit = sharc_found ? 1 : 0;
			if(sharc_found)
			{
				vec3 cached = cached_indirect;
				if(spec_bounce_index > 0 && global_ubo.pt_sharc != 2)
					cached += cached_direct;
				bounce_contrib += bounce_throughput * cached * global_ubo.pt_sharc_scale;
			}
		}

		if(spec_bounce_index < global_ubo.pt_num_bounce_rays - 1)
		{
			// store surface parameters for the next bounce
			imageStore(IMG_PT_GEO_NORMAL2, ipos, uvec4(encode_normal(bounce_geo_normal)));
			imageStore(IMG_PT_SHADING_POSITION, ipos, vec4(bounce_position.xyz, uintBitsToFloat(triangle.material_id)));
			imageStore(IMG_PT_VIEW_DIRECTION2, ipos, vec4(bounce_direction, 0));
			imageStore(IMG_PT_BOUNCE_THROUGHPUT, ipos, vec4(bounce_throughput, is_specular_ray ? 1 : 0));
		}
	}

	if (is_specular_ray)
		bounce_contrib = demodulate_specular(primary_base_reflectivity, bounce_contrib);

	if(spec_bounce_index > 0 && first_bounce_is_specular)
		is_specular_ray = true;

	if(spec_bounce_index > 0)
		bounce_direction = view_direction.xyz;
}

void
main() 
{
	ivec2 ipos = ivec2(rt_LaunchID.xy);
	if(rt_LaunchID.z != 0)
		ipos.x += global_ubo.pt_field_offset;

	// Half-resolution tracing happens in the "low" GI setting
	bool half_res = global_ubo.pt_num_bounce_rays == 0.5;

	if(half_res)
	{
		// Tracing threads are launched in a dense grid whose vertical
		// size is only half of the frame, so rename the threads.
		// This is more efficient than launching an entire frame of 
		// threads and then doing nothing in every other row.
		ipos.y = ipos.y * 2 + (global_ubo.current_frame_idx & 1);
	}

	vec3 bounce_direction;
	vec3 bounce_contrib;
	bool is_specular_ray;

	// Split-field mode: nothing to bounce for field 1 unless this pixel's two Fresnel
	// paths genuinely diverged - see direct_lighting.rgen. This is the pass that
	// dominated the cost of split-field mode.
	if(global_ubo.pt_fullres_fields != 0)
	{
		bool is_second_field = (rt_LaunchID.z != 0) || (push_constants.gpu_index == 1);
		int cb_flags = int(imageLoad(IMG_PT_VIEW_DIRECTION, ipos).w) & CHECKERBOARD_FLAG_FIELD_MASK;

		// Field 1 is idle wherever the two paths never diverged. In half-resolution mode
		// both fields are also idle on the rows this frame is not tracing - but only on
		// reflect/refract materials, so the opaque frame stays at full render resolution.
		bool field1_idle = is_second_field && bitCount(cb_flags) <= 1;
		bool row_idle = !PT_FIELD_ROW_TRACED(global_ubo, ipos.y)
			&& IS_REFLECT_REFRACT_KIND(floatBitsToUint(imageLoad(IMG_PT_SHADING_POSITION, ipos).w));

		if(field1_idle || row_idle)
			return;
	}

	// pt_sharc 3: debug view of the radiance cache itself. The screen shows what the
	// cache holds at each visible surface (indirect + direct, times the albedo applied
	// downstream) and nothing else; black means the lookup found no usable entry.
	if(global_ubo.pt_sharc == 3 || global_ubo.pt_sharc == 5)
	{
		if(spec_bounce_index == 0)
		{
			vec3 debug_position = texelFetch(TEX_PT_SHADING_POSITION, ipos, 0).xyz;
			vec3 debug_normal = decode_normal(texelFetch(TEX_PT_GEO_NORMAL_A, ipos, 0).x);
			vec3 cached_indirect, cached_direct;
			sharc_lookup(debug_position, debug_normal, cached_indirect, cached_direct);
			// 5 = the indirect half alone, times pt_sharc_scale
			vec3 debug_color = global_ubo.pt_sharc == 5
				? cached_indirect * global_ubo.pt_sharc_scale
				: cached_indirect + cached_direct;
			debug_color = clamp_output(debug_color) * STORAGE_SCALE_HF;

			imageStore(IMG_PT_COLOR_LF_SH, ipos, vec4(0));
			imageStore(IMG_PT_COLOR_LF_COCG, ipos, vec4(0));
			imageStore(IMG_PT_COLOR_HF, ipos, uvec4(packRGBE(debug_color)));
			imageStore(IMG_PT_COLOR_SPEC, ipos, uvec4(packRGBE(vec3(0))));
		}
		return;
	}

	indirect_lighting(ipos, half_res, bounce_direction, bounce_contrib, is_specular_ray);

	// pt_sharc 4: hit-rate view of the cache lookups the path tracer itself makes at its
	// last bounce. Green = found a usable entry, red = missed, black = the path ended
	// in sky / nothing before reaching the last bounce. Best with flt_fixed_albedo 1.
	if(global_ubo.pt_sharc == 4)
	{
		if(spec_bounce_index == 0)
		{
			imageStore(IMG_PT_COLOR_LF_SH, ipos, vec4(0));
			imageStore(IMG_PT_COLOR_LF_COCG, ipos, vec4(0));
			imageStore(IMG_PT_COLOR_HF, ipos, uvec4(packRGBE(vec3(0))));
			imageStore(IMG_PT_COLOR_SPEC, ipos, uvec4(packRGBE(vec3(0))));
		}
		if(sharc_debug_hit >= 0)
		{
			vec3 marker = (sharc_debug_hit == 1 ? vec3(0, 1, 0) : vec3(1, 0, 0)) * global_ubo.prev_adapted_luminance * 2.0;
			imageStore(IMG_PT_COLOR_HF, ipos, uvec4(packRGBE(marker * STORAGE_SCALE_HF)));
		}
		return;
	}

	// ReSTIR GI, first bounce: every pixel leaves restir_gi.rgen a candidate (or a marker
	// saying why there is none), and a diffuse bounce stops here instead of lighting
	// the pixel - restir_gi.rgen does that with whichever sample wins.
	if(spec_bounce_index == 0 && restir_gi_enabled())
	{
		imageStore(IMG_PT_RESTIR_GI_ORIGIN_A, ipos, vec4(gi_origin, uintBitsToFloat(encode_normal(gi_origin_normal))));

		if(gi_candidate)
		{
			vec3 contrib = clamp_output(bounce_contrib);
			vec3 radiance = vec3(
				gi_t0.x > 1e-6 ? contrib.x / gi_t0.x : 0,
				gi_t0.y > 1e-6 ? contrib.y / gi_t0.y : 0,
				gi_t0.z > 1e-6 ? contrib.z / gi_t0.z : 0);

			imageStore(IMG_PT_RESTIR_GI_POS_A, ipos, vec4(gi_sample_pos, 0));
			imageStore(IMG_PT_RESTIR_GI_DATA_A, ipos, uvec4(
				encode_normal(gi_sample_normal),
				packRGBE(radiance),
				floatBitsToUint(RESTIR_GI_CAND_DIFFUSE),
				packRGBE(gi_t0)));
			return;
		}

		// A material-0 or lava pixel returns from indirect_lighting() with
		// is_specular_ray false and nothing sampled.
		float marker = is_specular_ray ? RESTIR_GI_CAND_SPECULAR : RESTIR_GI_CAND_INVALID;
		imageStore(IMG_PT_RESTIR_GI_DATA_A, ipos, uvec4(0, 0, floatBitsToUint(marker), 0));
	}

	if(any(isinf(bounce_contrib)) || any(isnan(bounce_contrib)) || any(isinf(bounce_direction)) || any(isnan(bounce_direction)) )
		return;

	bounce_contrib = clamp_output(bounce_contrib);

	if(all(equal(bounce_contrib, vec3(0))))
		return;

	// ReSTIR GI, second bounce behind a diffuse first bounce: this light belongs to the
	// candidate's L_o, not to the pixel. The throughput here is T0 * albedo * ..., so
	// dividing by T0 leaves what the first hit sends back.
	if(spec_bounce_index > 0 && restir_gi_enabled() && !is_specular_ray)
	{
		uvec4 data = imageLoad(IMG_PT_RESTIR_GI_DATA_A, ipos);
		if(uintBitsToFloat(data.z) == RESTIR_GI_CAND_DIFFUSE)
		{
			vec3 t0 = unpackRGBE(data.w);
			vec3 radiance = unpackRGBE(data.y);
			radiance += vec3(
				t0.x > 1e-6 ? bounce_contrib.x / t0.x : 0,
				t0.y > 1e-6 ? bounce_contrib.y / t0.y : 0,
				t0.z > 1e-6 ? bounce_contrib.z / t0.z : 0);
			data.y = packRGBE(radiance);
			imageStore(IMG_PT_RESTIR_GI_DATA_A, ipos, data);
		}
		return;
	}

	if(is_specular_ray)
	{
		bounce_contrib *= STORAGE_SCALE_SPEC;

		vec3 specular = unpackRGBE(imageLoad(IMG_PT_COLOR_SPEC, ipos).x);
		specular += bounce_contrib;
		imageStore(IMG_PT_COLOR_SPEC, ipos, uvec4(packRGBE(specular)));
	}
	else
	{
		bounce_contrib *= STORAGE_SCALE_LF;

		SH low_freq = load_SH(TEX_PT_COLOR_LF_SH, TEX_PT_COLOR_LF_COCG, ipos);

	#if ENABLE_SH
		if(global_ubo.flt_enable == 0)
			low_freq.shY.xyz += bounce_contrib;
		else
		{
			accumulate_SH(low_freq, irradiance_to_SH(bounce_contrib, bounce_direction), 1.0);
		}
	#else
		low_freq.shY.xyz += bounce_contrib;
	#endif

		STORE_SH(IMG_PT_COLOR_LF_SH, IMG_PT_COLOR_LF_COCG, ipos, low_freq);
	}
}
