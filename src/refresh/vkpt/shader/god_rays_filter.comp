// ========================================================================== //
// This shader applies a bilateral spatial filter to the volumetric lighting 
// effects computed previously by the `god_rays.comp` shader and interpolates
// those half-resolution effects to full screen resolution. 
// In the end, it also blends the effects on top of the color buffer.
// ========================================================================== //

#version 460
#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_GOOGLE_include_directive    : enable
#extension GL_EXT_nonuniform_qualifier    : enable
// not used in this shader, but god_rays_shared.h declares the fog's TLAS and
// the type has to be known for the header to parse
#extension GL_EXT_ray_query               : enable

#define GOD_RAYS_DESC_SET_IDX 0
#include "god_rays_shared.h"

#define GLOBAL_UBO_DESC_SET_IDX 2
#include "global_ubo.h"

#define GLOBAL_TEXTURES_DESC_SET_IDX 3
#include "global_textures.h"

#include "froxel_shared.h"
#include "fog_q3.glsl"   // Quake III fog brushes: their transmittance
#include "projection.glsl"   // the camera ray of a bent pixel, for the fog brushes

// The integrated froxel volume, written by froxel_integrate.comp this frame.
// rgb is in-scattered radiance from the eye to the far face of a slice, a is
// transmittance over that same span - so one fetch replaces the whole march.
//
// Bound TWICE, deliberately: as a storage image (the binding integrate writes)
// and as a sampled image here, because a storage image can only be read
// unfiltered. The grid is 160x88, so a nearest fetch spreads one cell across a
// ~12x12 block of screen pixels and the fog arrives in visible lumps.
// Interpolating is what makes a grid this coarse read as fog.
layout(set = GOD_RAYS_DESC_SET_IDX, binding = 5) uniform sampler3D TEX_FROXEL_INTEGRATED;

/*
Read the volume at this pixel's own depth.

Trilinear, and the Z coordinate is the EXPONENTIAL slice index turned back into
a 0..1 texture coordinate - not the raw depth. Feeding depth in linearly would
sample the wrong slice everywhere except at the two ends, because the slice
distribution is a power law.
*/
vec4 sample_froxel(vec2 screen_uv, float view_depth)
{
	// Past the far plane there is nothing more in the volume, so the last slice
	// is all there is. FROXEL_FAR now matches PRIMARY_RAY_T_MAX, so this only
	// bites for a depth written by something other than the primary rays.
	float slice = clamp(FROXEL_DEPTH_TO_SLICE(max(view_depth, FROXEL_NEAR)),
	                    0.0, float(FROXEL_GRID_Z) - 0.5);

	/* HALF A TEXEL BACK, because of what a texel of the INTEGRATED volume means.

	   froxel_integrate writes into texel z the light accumulated from the eye to
	   the FAR FACE of slice z - that is, out to slice coordinate z + 1. So the
	   accumulation "up to slice coordinate s" lives in texel s - 1, whose centre
	   is at (s - 1 + 0.5) / GRID_Z = (s - 0.5) / GRID_Z.

	   Sampling at s / GRID_Z instead read half a texel too far and returned the
	   fog for a point slightly BEHIND the surface being shaded - a small,
	   systematic over-accumulation that grows with slice thickness, so it was
	   worst exactly where the slices are thickest, out in the distance. */
	vec3 uvw = vec3(clamp(screen_uv, vec2(0.0), vec2(1.0)),
	                max(slice - 0.5, 0.0) / float(FROXEL_GRID_Z));

	return textureLod(TEX_FROXEL_INTEGRATED, uvw, 0);
}

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
void main()
{
	if (any(greaterThanEqual(gl_GlobalInvocationID.xy, ivec2(global_ubo.current_gpu_slice_width, global_ubo.height))))
		return;

	ivec2 i_position = ivec2(gl_GlobalInvocationID.xy);
	vec4 result = vec4(0.0);
	vec4 fallbackResult = vec4(0.0);
	float fallbackCount = 0;
	float weightSum = 0;
	float referenceViewDepth = texelFetch(TEX_PT_VIEW_DEPTH_A, i_position.xy, 0).r;
	ivec2 lowResOrigin = ivec2(i_position.xy) >> 1;

	int field_left = 0;
	int field_right = global_ubo.pt_field_offset;
	if(i_position.x >= field_right)
	{
		field_left = field_right;
		field_right = global_ubo.pt_field_offset * 2;

		// Under the full-resolution split, field 1 is only ever read for a SPLIT
		// pixel: combine_fullres_fields (checkerboard_interleave.comp) takes
		// field 0 alone otherwise, deciding from field 0's flags. Fogging the
		// other ~95% of field 1 was work nobody read.
		// This pass runs after reflect/refract bounce 0 but BEFORE bounces 1-3,
		// so a path can still split later - only where its current vertex is a
		// reflect/refract material (the bounces skip every other pixel). Until it
		// splits both fields carry the same path, so field 0 answers for both.
		// Checkerboard mode needs both halves, so not there.
		if (global_ubo.pt_fullres_fields != 0)
		{
			ivec2 field0_pos = ivec2(i_position.x - field_left, i_position.y);
			int field0_flags = int(texelFetch(TEX_PT_VIEW_DIRECTION, field0_pos, 0).w);
			uint field0_material = floatBitsToUint(texelFetch(TEX_PT_SHADING_POSITION, field0_pos, 0).w);
			if (bitCount(field0_flags & CHECKERBOARD_FLAG_FIELD_MASK) <= 1
			    && !IS_REFLECT_REFRACT_KIND(field0_material))
				return;
		}
	}

	// The march was not dispatched and the grid below replaces this result
	// outright - see fog_march_discarded in global_ubo.h.
	const bool march_discarded = fog_march_discarded();

	for (int dy = -2; dy <= 2 && !march_discarded; dy++)
	{
		for (int dx = -2; dx <= 2; dx++)
		{
			ivec2 lowResPos = lowResOrigin + ivec2(dx, dy);
			ivec2 highResPos = lowResPos * 2 + GetRotatedGridOffset(lowResPos);

			if (highResPos.x < field_left || highResPos.x >= field_right || highResPos.y >= global_ubo.height)
				continue;

			vec4 color = texelFetch(TEX_GODRAYS_INTERMEDIATE, lowResPos, 0);
			float viewDepth = texelFetch(TEX_PT_VIEW_DEPTH_A, highResPos, 0).r;

			float weight = clamp(1 - 10 * abs(viewDepth - referenceViewDepth) / abs(referenceViewDepth), 0, 1);
			weight *= clamp(5 - length(vec2(highResPos - i_position)), 0, 1);

			result.rgba += color.rgba * weight;
			fallbackResult.rgba += color.rgba;
			fallbackCount += 1;
			weightSum += weight;
		}
	}

	if (weightSum > 0)
	{
		// We found some relevant low-res pixels
		result.rgba = result.rgba / weightSum;
	}
	else
	{
		// No relevant low-res pixels found - use non-bilateral spatial blur
		result.rgb = fallbackResult.rgb / 16.0;

		// Alpha is a TRANSMITTANCE, not an amount of added light, so it has to be
		// a true mean of the taps that were actually read. The 16.0 above is a
		// deliberate under-weighting of a 5x5 neighbourhood - fine for a quantity
		// that is only ever added, wrong for one that multiplies the image, where
		// it would leave a dark blotch wherever this branch is taken.
		result.a = (fallbackCount > 0) ? (fallbackResult.a / fallbackCount) : 1.0;
	}

	// THE FROXEL PATH.  When the grid is running, everything above - the
	// half-res march and its bilateral upsample - was not what produced the map
	// fog, so its result is replaced outright rather than added to.  The sun
	// shafts still come from the march, which is why this only takes over when
	// the map's own fog is what is being rendered (pt_fog_froxel, and fog_mode
	// >= 2 on the C side).
	// PHOTO MODE: the march ran at full resolution, so this pixel's own value
	// is the sample. No bilateral taps (they are a spatial filter, and would
	// converge to a blurred fog) and no froxel grid below. See fog_accum_march.
	if (fog_accum_march())
		result = texelFetch(TEX_GODRAYS_INTERMEDIATE, i_position.xy, 0);

	float raw_view_depth = texelFetch(TEX_PT_VIEW_DEPTH_A, i_position.xy, 0).r;

	/* A NEGATIVE VIEW DEPTH MEANS THIS PIXEL WENT THROUGH A REFLECTION OR A
	   REFRACTION, AND THE GRID CANNOT ANSWER FOR IT.

	   The sign is reflect_refract.rgen's marker (see the "Use negative depth for
	   reflections and refractions" note there), and the MAGNITUDE it leaves
	   behind is the APPARENT distance of the reflected image - the unfolded
	   camera -> mirror -> object path length, not the distance to the mirror. A
	   reflection that hits the sky stores the extreme case, -PRIMARY_RAY_T_MAX.

	   Taking abs() of that and handing it to sample_froxel asks the grid for the
	   fog accumulated over that whole distance ALONG THE CAMERA RAY, which runs
	   straight through the mirror and out the far side of the level. Every
	   reflective pixel therefore received a full-length fog column measured
	   through whatever the medium looks like at the CAMERA's altitude, and a
	   reflected-sky pixel received the longest column the volume can produce -
	   the same one a real sky pixel gets, no matter how close the water is.

	   On a map whose height fog is coloured by altitude that is not a subtle
	   error: mgu5m1 has heightfog_end_color 0.64 0.08 0.08 at the band floor and
	   a yellow-green start colour 1200 units above it, so a column integrated at
	   eye level saturates to roughly (0.53, 0.35, 0.10). That is why the
	   reflections of a green sky came out ORANGE.

	   WHAT TO DO INSTEAD IS A THREE-WAY CHOICE, because no option is free.

	   The march does not have the bug: it is already two-pass, running once
	   BEFORE reflect_refract with the true primary distance and again after it
	   (pass_index 1) along the reflected leg, accumulating both into
	   GODRAYS_INTERMEDIATE. But the march is the PER-PIXEL estimator - one
	   stochastic light sample per step, no temporal history, no reservoir - and
	   handing these pixels back to it makes the fog inside a reflection visibly
	   NOISY. It always was; the grid was painting over it with a smooth, wrong
	   answer, which is why the noise only appeared once the colour was fixed.

	   The middle option is the one that is both smooth and honest: ask the grid
	   for the column from the eye to the REFLECTING SURFACE and stop there. That
	   part of the path is genuinely inside the view frustum, so the grid is the
	   right instrument for it and the answer carries the full temporal history.
	   What is lost is the fog INSIDE the reflected image - the reflected leg
	   leaves the frustum immediately and a view-aligned volume has nothing to say
	   about it at any price. In practice that reads as a reflection that is a
	   little too clear, which is a far smaller error than either a wrong colour
	   or a crawling one.

	   It needs the distance to the mirror, which reflect_refract has already
	   overwritten by now - hence PT_PRIMARY_DIST, written by primary_rays.rgen
	   before any of that happens. See global_textures.h.

	     pt_fog_froxel_reflect 0  grid, stopped at the reflecting surface (default)
	                              - smooth, no fog within the reflected image
	     pt_fog_froxel_reflect 1  the march's two-pass result - complete, and noisy
	     pt_fog_froxel_reflect 2  the old full-length column - smooth and wrong,
	                              kept only so the orange bug can be reproduced */
	bool is_reflection = raw_view_depth < 0.0;
	int  reflect_mode  = int(global_ubo.pt_fog_froxel_reflect);

	/* NOT EVERY NEGATIVE DEPTH IS A MIRROR. reflect_refract.rgen marks refractions
	   the same way, and everything above is about reflections: a refracted path
	   carries straight on through the pane, roughly along this pixel's own camera
	   ray, so it stays inside the frustum and the grid CAN answer for it. Stopping
	   it at the pane is why no grid fog - the sky light, the local lights - was
	   ever seen through a window in gameplay, while photo mode, whose march runs
	   the refracted leg as pass 1, showed it.

	   A path is see-through when no bounce has folded it (CHECKERBOARD_FLAG_MIRRORED,
	   raised by reflections, chrome, cameras and total internal reflection) and it
	   did not end up inside water, slime or lava, whose medium the march models and
	   the air grid must not paint over. MEDIUM_GLASS counts as air: the rerelease
	   windows are single two-sided planes, so a pt_thick_glass 2 ray never re-exits
	   them and carries the glass flag on out to the sky. pt_fog_through_glass. */
	bool see_through = false;
	if (is_reflection && global_ubo.pt_fog_through_glass != 0.0)
	{
		int path_flags = int(texelFetch(TEX_PT_VIEW_DIRECTION, i_position.xy, 0).w);
		uint path_material = floatBitsToUint(texelFetch(TEX_PT_SHADING_POSITION, i_position.xy, 0).w);
		int path_medium = int((path_material & MATERIAL_LIGHT_STYLE_MASK) >> MATERIAL_LIGHT_STYLE_SHIFT);
		see_through = (path_flags & CHECKERBOARD_FLAG_MIRRORED) == 0
			&& (path_medium == MEDIUM_NONE || path_medium == MEDIUM_GLASS);
	}

	// mode 1 is the only one that declines the grid and keeps the marched result
	bool froxel_pixel = !is_reflection || reflect_mode != 1;

	if (global_ubo.fog_enable != 0 && global_ubo.pt_fog_froxel > 0.0 && froxel_pixel
	    && !fog_accum_march())
	{
		float view_depth = abs(raw_view_depth);

		// Stop the column at the mirror rather than running it out to the
		// unfolded path length. Not clamped against view_depth - for a reflected
		// SKY pixel the apparent depth is PRIMARY_RAY_T_MAX and the primary
		// distance is the only meaningful number of the two.
		if (is_reflection && reflect_mode == 0)
			view_depth = texelFetch(TEX_PT_PRIMARY_DIST, i_position.xy, 0).r;

		/* THE LOOKUP MUST BE RELATIVE TO THE FIELD, NOT TO THE PACKED IMAGE.
		   This is the bug that made the froxel grid put fog in the wrong place
		   from the day it was written, and it is why it looked broken while the
		   per-pixel march looked correct.

		   The path-tracer screen images hold TWO FIELDS PACKED SIDE BY SIDE,
		   field 1 starting at x == pt_field_offset - see the FIELD LAYOUT note
		   in global_ubo.h. In the pt_fullres_fields 1 mode that DLSS selects,
		   EACH FIELD IS A FULL WIDTH x HEIGHT LAYER OF THE WHOLE SCREEN, so a
		   pixel's x within its own field is what corresponds to a screen
		   position - its x within the packed image is not.

		   Dividing by current_gpu_slice_width therefore squeezed the whole
		   screen into HALF the volume's u range: field 0 sampled the volume's
		   left half stretched across the entire picture and field 1 the right
		   half, so the fog from the right of the frustum never appeared at all
		   and everything else landed at roughly double its correct horizontal
		   offset from the centre. That reads exactly as "the fog is in the
		   middle and there is none around the lights".

		   The march has never had this problem because it works per pixel from
		   TEX_PT_VIEW_DIRECTION, which is already correct within each field.

		   field_left is the one computed above for the bilateral taps, so this
		   uses the same field split the rest of the pass does. pt_field_offset
		   is the field WIDTH, and it is the right divisor in the checkerboard
		   mode too: a checkerboard half also spans the full screen, just at half
		   the horizontal sample density. */
		int field_width = max(global_ubo.pt_field_offset, 1);

		vec2 screen_uv = (vec2(i_position - ivec2(field_left, 0)) + 0.5)
		               / vec2(float(field_width), float(global_ubo.height));

		vec4 grid = sample_froxel(screen_uv, view_depth);

		/* ONE COLUMN, TWO LAYERS. Under the full-resolution split the reflection
		   (field 0) and refraction (field 1) layers of a water or glass pixel are
		   SUMMED by checkerboard_interleave.comp, and both of them start at the eye,
		   so each taking this whole column put it on screen twice - the veil over
		   water came out about twice the one over the floor beside it. Each layer
		   keeps half, the same split reflect_refract.rgen gives the overlay; the
		   combine pass reads the split from field 0's flags, so this does too.
		   pt_fog_split_once. */
		vec3 shared_column = grid.rgb;
		if (global_ubo.pt_fullres_fields != 0 && global_ubo.pt_fog_split_once != 0.0)
		{
			int field0_flags = int(texelFetch(TEX_PT_VIEW_DIRECTION, ivec2(i_position.x - field_left, i_position.y), 0).w);
			if (bitCount(field0_flags & CHECKERBOARD_FLAG_FIELD_MASK) > 1)
				grid.rgb *= 0.5;
		}

		/* Through the pane: the column to the pane once, plus the stretch beyond it
		   scaled by this layer's throughput - (1 - F) and the glass tint for the
		   refraction field - which is how the march's pass 1 weights the same leg.
		   The integrated volume is cumulative from the eye, so the stretch beyond is
		   a difference of two lookups down the same screen position; abs() of the
		   negative depth is the radial distance to the refracted hit, PRIMARY_RAY_T_MAX
		   for sky. A bent ray is read down the unbent column - the grid holds nothing
		   else - which is a small error next to having no fog there at all. */
		if (see_through && reflect_mode == 0)
		{
			vec4 beyond = sample_froxel(screen_uv, abs(raw_view_depth));
			vec3 layer_throughput = texelFetch(TEX_PT_GODRAYS_THROUGHPUT_DIST, i_position.xy, 0).rgb;
			grid.rgb += layer_throughput * max(beyond.rgb - shared_column, vec3(0.0));
			grid.a = beyond.a;
		}

		/* REPLACE, OR ADD.

		   Replacing is the normal case: the grid computed everything and the
		   march above was thrown away. A map SKYBOX always takes this path, so
		   cl_fog 3 there is unchanged.

		   Under fog_sun_in_march() the two shaders have SPLIT the work -
		   froxel_scatter.comp skipped its sun term and god_rays.comp dropped its
		   local half - so each holds exactly one half of the same integral and
		   they sum. Adding is only correct BECAUSE of those two skips; an
		   earlier version added here without them and double-counted the sun,
		   which showed up as fog in dim interiors while outdoor shafts still
		   clipped correctly (both copies agreed about the shadow map and simply
		   summed to 2x). If this is ever reworked, check all three sites.

		   Transmittance is neither summed nor multiplied: it is one property of
		   one path and both estimators measure that same path. The grid's is the
		   one to keep - it carries the temporal history, where the march's is a
		   single per-pixel sample. */
		if (fog_sun_in_march())
		{
			result.rgb += grid.rgb;
			result.a = grid.a;
		}
		else
		{
			result = grid;
		}
	}

	vec4 originalColor = imageLoad(IMG_PT_TRANSPARENT, ivec2(gl_GlobalInvocationID.xy));

	// Additive blending - the correct way would be to use alpha blending,
	// but we don't really want to darken the entire map where there is no sun.
	// Darkening would happen because our volumetric lighting effect does not
	// consider any light sources but the sun, nor it considers indirect 
	// illumination, but the extinction (out-scatter) of light along the view ray 
	// is still calculated.
	//
	// That objection is exactly right for the classic sun-only god rays, and it
	// is why this stays additive by default. It stops applying once the map's own
	// medium is being marched with real extinction (pt_fog_extinction > 0): there
	// the in-scatter IS the medium's radiance, computed per step from the map's
	// fog colour and its own lights, so multiplying the background by the
	// transmittance is what the additive term is the other half of. Without it
	// the fog can only ever brighten - it never hides anything - which is why a
	// long ray runs away instead of settling at the fog's colour, and why one
	// cl_fog_scale could not serve both an enclosed room and an open vista.
	//
	// pt_fog_opacity trades between the two: 0 is the historical purely additive
	// look, 1 is a full alpha blend.
	float transmittance = 1.0;
	bool  q3_fog = false;
	vec3  q3_glow = vec3(0.0);
	// A Quake III map's fog brushes have REAL extinction (fog_q3.glsl), which has
	// to hide what is behind them even while the map fog itself is additive.
	// Computed exactly from the boxes rather than taken from result.a: the grid's
	// transmittance also carries the flat medium's token 0.0001 per unit, which
	// over a long view would dim the whole far scene, fog brush or not.
	if (global_ubo.fog_enable != 0 && global_ubo.pt_fog_extinction <= 0.0 && q3_fog_present())
	{
		vec3 q3_dir = texelFetch(TEX_PT_VIEW_DIRECTION, i_position.xy, 0).xyz;
		vec4 q3_leg = texelFetch(TEX_PT_GODRAYS_THROUGHPUT_DIST, i_position.xy, 0);
		if (dot(q3_dir, q3_dir) > 0.0)
		{
			q3_dir = normalize(q3_dir);

			// Quake III's fog is its colour whatever the light: what the fog takes
			// away comes back as that colour, at pt_fog_q3_ambient times the
			// exposure's level, its brightness taken out (see global_ubo.h)
			float q3_level = global_ubo.prev_adapted_luminance * max(global_ubo.pt_fog_q3_ambient, 0.0);
			vec3 q3_color;

			if (raw_view_depth >= 0.0)
			{
				// straight from the eye: the direction and distance are the camera ray's
				// (none of it when the eye is in a liquid - no fog brush in the water)
				q3_fog_leg_in_liquid = q3_fog_medium_is_liquid(global_ubo.medium);
				transmittance = q3_fog_transmittance(global_ubo.cam_pos.xyz, q3_dir, q3_leg.w, q3_color);
				q3_fog_leg_in_liquid = false;
				q3_glow = (1.0 - transmittance) * q3_fog_tint(q3_color) * q3_level;
			}
			else
			{
				/* A BENT PATH: glass, water, a mirror, a portal. reflect_refract's bounce 0
				   has already overwritten the direction and the distance with ITS leg - the
				   bent ray from the surface to what it hit - and reading that from the eye
				   measured a few units of fog next to the camera instead of the column out
				   to the surface: the health orbs in q3dm4's fog pit stood out clear, and so
				   did their whole see-through image (Matt, 2026-11-17). So two legs: the eye
				   to the surface along the camera ray (PT_PRIMARY_DIST, kept from the primary
				   rays), and bounce 0's own, from where it really began - its hit minus its
				   length, which also holds at a camera portal, whose leg starts at the
				   camera. Bounces 1-3 come after this pass and add their own legs
				   (reflect_refract.rgen, fog_filter_active). */
				int field_width = max(global_ubo.pt_field_offset, 1);
				vec2 uv = (vec2(i_position - ivec2(field_left, 0)) + 0.5)
				        / vec2(float(field_width), float(global_ubo.height));
				vec3 dir0 = normalize((global_ubo.invV * vec4(projection_screen_to_view(uv, 1.0, false), 0.0)).xyz);
				float dist0 = texelFetch(TEX_PT_PRIMARY_DIST, i_position.xy, 0).r;
				// the eye's column: in the water when the eye is (fog_q3.glsl)
				q3_fog_leg_in_liquid = q3_fog_medium_is_liquid(global_ubo.medium);
				float t0 = q3_fog_transmittance(global_ubo.cam_pos.xyz, dir0, dist0, q3_color);
				q3_fog_leg_in_liquid = false;
				vec3 glow0 = (1.0 - t0) * q3_fog_tint(q3_color);

				vec4 hit1_material = texelFetch(TEX_PT_SHADING_POSITION, i_position.xy, 0);
				vec3 hit1 = hit1_material.xyz;
				// bounce 0's leg under a liquid's surface sees no fog brush (fog_q3.glsl);
				// its medium is in the material's light style bits, as god_rays.comp reads it
				uint leg_material = floatBitsToUint(hit1_material.w);
				q3_fog_leg_in_liquid = q3_fog_medium_is_liquid(
					int((leg_material & MATERIAL_LIGHT_STYLE_MASK) >> MATERIAL_LIGHT_STYLE_SHIFT));
				float t1 = q3_fog_transmittance(hit1 - q3_dir * q3_leg.w, q3_dir, q3_leg.w, q3_color);
				q3_fog_leg_in_liquid = false;
				vec3 glow1 = (t1 < 1.0) ? (1.0 - t1) * q3_fog_tint(q3_color) : vec3(0.0);

				/* The eye's column is shared by both layers of a split pixel, which the
				   combine pass SUMS - each takes half, as the grid's column does above
				   (pt_fog_split_once). The leg past the surface is this layer's own, at
				   its throughput (Fresnel share, glass tint), as the march weights it. */
				float share0 = 1.0;
				if (global_ubo.pt_fullres_fields != 0 && global_ubo.pt_fog_split_once != 0.0)
				{
					int field0_flags = int(texelFetch(TEX_PT_VIEW_DIRECTION, ivec2(i_position.x - field_left, i_position.y), 0).w);
					if (bitCount(field0_flags & CHECKERBOARD_FLAG_FIELD_MASK) > 1)
						share0 = 0.5;
				}

				transmittance = t0 * t1;
				q3_glow = (share0 * glow0 + t0 * q3_leg.rgb * glow1) * q3_level;
			}
			q3_fog = transmittance < 1.0;
		}
	}
	else if (global_ubo.fog_enable != 0 && global_ubo.pt_fog_extinction > 0.0)
	{
		transmittance = mix(1.0, clamp(result.a, 0.0, 1.0),
		                    clamp(global_ubo.pt_fog_opacity, 0.0, 1.0));
	}

	vec3 composition = originalColor.rgb * transmittance + result.rgb + q3_glow;

	/* The SCENE behind a fog brush has to go too, not only this overlay. The
	   overlay is laid over the scene as scene * (1 - alpha) + overlay
	   (brdf.glsl composite_color), and the alpha used to go back untouched - so a
	   fog brush dimmed the sky, the glows and the effects in front of the walls and
	   never the walls themselves, and read as a faint haze however thick it was
	   (Matt, 2026-11-17, q3dm4). 1 - (1 - alpha) * T takes the scene's share down
	   by T as well. The other extinction path below (pt_fog_extinction > 0) keeps
	   the old alpha: changing what it hides is a separate decision. */
	float alpha = q3_fog ? 1.0 - (1.0 - originalColor.a) * transmittance : originalColor.a;

	imageStore(IMG_PT_TRANSPARENT, ivec2(gl_GlobalInvocationID.xy), vec4(composition.rgb, alpha));

	/* pt_dlss_particle_layer: the effects are in RR's transparency layer now, not in
	   PT_TRANSPARENT, so the fog's dimming has to reach them there - by the same
	   whole-path transmittance it used to apply to them (an effect half way to the
	   wall is dimmed as if at the wall, as before). Its alpha stays: the fog does not
	   change how much of the surface an effect hides. Field 0 owns the layer. */
	if (global_ubo.pt_dlss_particle_layer != 0 && transmittance < 1.0 && i_position.x < global_ubo.pt_field_offset)
	{
		vec4 layer = imageLoad(IMG_DLSS_PARTICLE_LAYER, i_position);
		imageStore(IMG_DLSS_PARTICLE_LAYER, i_position, vec4(layer.rgb * transmittance, layer.a));
	}
}
