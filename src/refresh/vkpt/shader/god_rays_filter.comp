// ========================================================================== //
// This shader applies a bilateral spatial filter to the volumetric lighting 
// effects computed previously by the `god_rays.comp` shader and interpolates
// those half-resolution effects to full screen resolution. 
// In the end, it also blends the effects on top of the color buffer.
// ========================================================================== //

#version 460
#extension GL_EXT_samplerless_texture_functions : enable
#extension GL_GOOGLE_include_directive    : enable
#extension GL_EXT_nonuniform_qualifier    : enable
// not used in this shader, but god_rays_shared.h declares the fog's TLAS and
// the type has to be known for the header to parse
#extension GL_EXT_ray_query               : enable

#define GOD_RAYS_DESC_SET_IDX 0
#include "god_rays_shared.h"

#define GLOBAL_UBO_DESC_SET_IDX 2
#include "global_ubo.h"

#define GLOBAL_TEXTURES_DESC_SET_IDX 3
#include "global_textures.h"

#include "froxel_shared.h"

// The integrated froxel volume, written by froxel_integrate.comp this frame.
// rgb is in-scattered radiance from the eye to the far face of a slice, a is
// transmittance over that same span - so one fetch replaces the whole march.
//
// Bound TWICE, deliberately: as a storage image (the binding integrate writes)
// and as a sampled image here, because a storage image can only be read
// unfiltered. The grid is 160x88, so a nearest fetch spreads one cell across a
// ~12x12 block of screen pixels and the fog arrives in visible lumps.
// Interpolating is what makes a grid this coarse read as fog.
layout(set = GOD_RAYS_DESC_SET_IDX, binding = 5) uniform sampler3D TEX_FROXEL_INTEGRATED;

/*
Read the volume at this pixel's own depth.

Trilinear, and the Z coordinate is the EXPONENTIAL slice index turned back into
a 0..1 texture coordinate - not the raw depth. Feeding depth in linearly would
sample the wrong slice everywhere except at the two ends, because the slice
distribution is a power law.
*/
vec4 sample_froxel(vec2 screen_uv, float view_depth)
{
	// Past the far plane there is nothing more in the volume, so the last slice
	// is all there is. FROXEL_FAR now matches PRIMARY_RAY_T_MAX, so this only
	// bites for a depth written by something other than the primary rays.
	float slice = clamp(FROXEL_DEPTH_TO_SLICE(max(view_depth, FROXEL_NEAR)),
	                    0.0, float(FROXEL_GRID_Z) - 0.5);

	/* HALF A TEXEL BACK, because of what a texel of the INTEGRATED volume means.

	   froxel_integrate writes into texel z the light accumulated from the eye to
	   the FAR FACE of slice z - that is, out to slice coordinate z + 1. So the
	   accumulation "up to slice coordinate s" lives in texel s - 1, whose centre
	   is at (s - 1 + 0.5) / GRID_Z = (s - 0.5) / GRID_Z.

	   Sampling at s / GRID_Z instead read half a texel too far and returned the
	   fog for a point slightly BEHIND the surface being shaded - a small,
	   systematic over-accumulation that grows with slice thickness, so it was
	   worst exactly where the slices are thickest, out in the distance. */
	vec3 uvw = vec3(clamp(screen_uv, vec2(0.0), vec2(1.0)),
	                max(slice - 0.5, 0.0) / float(FROXEL_GRID_Z));

	return textureLod(TEX_FROXEL_INTEGRATED, uvw, 0);
}

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;
void main()
{
	if (any(greaterThanEqual(gl_GlobalInvocationID.xy, ivec2(global_ubo.current_gpu_slice_width, global_ubo.height))))
		return;

	ivec2 i_position = ivec2(gl_GlobalInvocationID.xy);
	vec4 result = vec4(0.0);
	vec4 fallbackResult = vec4(0.0);
	float fallbackCount = 0;
	float weightSum = 0;
	float referenceViewDepth = texelFetch(TEX_PT_VIEW_DEPTH_A, i_position.xy, 0).r;
	ivec2 lowResOrigin = ivec2(i_position.xy) >> 1;

	int field_left = 0;
	int field_right = global_ubo.pt_field_offset;
	if(i_position.x >= field_right)
	{
		field_left = field_right;
		field_right = global_ubo.pt_field_offset * 2;
	}

	for (int dy = -2; dy <= 2; dy++)
	{
		for (int dx = -2; dx <= 2; dx++)
		{
			ivec2 lowResPos = lowResOrigin + ivec2(dx, dy);
			ivec2 highResPos = lowResPos * 2 + GetRotatedGridOffset(lowResPos);

			if (highResPos.x < field_left || highResPos.x >= field_right || highResPos.y >= global_ubo.height)
				continue;

			vec4 color = texelFetch(TEX_GODRAYS_INTERMEDIATE, lowResPos, 0);
			float viewDepth = texelFetch(TEX_PT_VIEW_DEPTH_A, highResPos, 0).r;

			float weight = clamp(1 - 10 * abs(viewDepth - referenceViewDepth) / abs(referenceViewDepth), 0, 1);
			weight *= clamp(5 - length(vec2(highResPos - i_position)), 0, 1);

			result.rgba += color.rgba * weight;
			fallbackResult.rgba += color.rgba;
			fallbackCount += 1;
			weightSum += weight;
		}
	}

	if (weightSum > 0)
	{
		// We found some relevant low-res pixels
		result.rgba = result.rgba / weightSum;
	}
	else
	{
		// No relevant low-res pixels found - use non-bilateral spatial blur
		result.rgb = fallbackResult.rgb / 16.0;

		// Alpha is a TRANSMITTANCE, not an amount of added light, so it has to be
		// a true mean of the taps that were actually read. The 16.0 above is a
		// deliberate under-weighting of a 5x5 neighbourhood - fine for a quantity
		// that is only ever added, wrong for one that multiplies the image, where
		// it would leave a dark blotch wherever this branch is taken.
		result.a = (fallbackCount > 0) ? (fallbackResult.a / fallbackCount) : 1.0;
	}

	// THE FROXEL PATH.  When the grid is running, everything above - the
	// half-res march and its bilateral upsample - was not what produced the map
	// fog, so its result is replaced outright rather than added to.  The sun
	// shafts still come from the march, which is why this only takes over when
	// the map's own fog is what is being rendered (pt_fog_froxel, and fog_mode
	// >= 2 on the C side).
	if (global_ubo.fog_enable != 0 && global_ubo.pt_fog_froxel > 0.0)
	{
		float view_depth = abs(texelFetch(TEX_PT_VIEW_DEPTH_A, i_position.xy, 0).r);

		/* THE LOOKUP MUST BE RELATIVE TO THE FIELD, NOT TO THE PACKED IMAGE.
		   This is the bug that made the froxel grid put fog in the wrong place
		   from the day it was written, and it is why it looked broken while the
		   per-pixel march looked correct.

		   The path-tracer screen images hold TWO FIELDS PACKED SIDE BY SIDE,
		   field 1 starting at x == pt_field_offset - see the FIELD LAYOUT note
		   in global_ubo.h. In the pt_fullres_fields 1 mode that DLSS selects,
		   EACH FIELD IS A FULL WIDTH x HEIGHT LAYER OF THE WHOLE SCREEN, so a
		   pixel's x within its own field is what corresponds to a screen
		   position - its x within the packed image is not.

		   Dividing by current_gpu_slice_width therefore squeezed the whole
		   screen into HALF the volume's u range: field 0 sampled the volume's
		   left half stretched across the entire picture and field 1 the right
		   half, so the fog from the right of the frustum never appeared at all
		   and everything else landed at roughly double its correct horizontal
		   offset from the centre. That reads exactly as "the fog is in the
		   middle and there is none around the lights".

		   The march has never had this problem because it works per pixel from
		   TEX_PT_VIEW_DIRECTION, which is already correct within each field.

		   field_left is the one computed above for the bilateral taps, so this
		   uses the same field split the rest of the pass does. pt_field_offset
		   is the field WIDTH, and it is the right divisor in the checkerboard
		   mode too: a checkerboard half also spans the full screen, just at half
		   the horizontal sample density. */
		int field_width = max(global_ubo.pt_field_offset, 1);

		vec2 screen_uv = (vec2(i_position - ivec2(field_left, 0)) + 0.5)
		               / vec2(float(field_width), float(global_ubo.height));

		result = sample_froxel(screen_uv, view_depth);
	}

	vec4 originalColor = imageLoad(IMG_PT_TRANSPARENT, ivec2(gl_GlobalInvocationID.xy));

	// Additive blending - the correct way would be to use alpha blending,
	// but we don't really want to darken the entire map where there is no sun.
	// Darkening would happen because our volumetric lighting effect does not
	// consider any light sources but the sun, nor it considers indirect 
	// illumination, but the extinction (out-scatter) of light along the view ray 
	// is still calculated.
	//
	// That objection is exactly right for the classic sun-only god rays, and it
	// is why this stays additive by default. It stops applying once the map's own
	// medium is being marched with real extinction (pt_fog_extinction > 0): there
	// the in-scatter IS the medium's radiance, computed per step from the map's
	// fog colour and its own lights, so multiplying the background by the
	// transmittance is what the additive term is the other half of. Without it
	// the fog can only ever brighten - it never hides anything - which is why a
	// long ray runs away instead of settling at the fog's colour, and why one
	// cl_fog_scale could not serve both an enclosed room and an open vista.
	//
	// pt_fog_opacity trades between the two: 0 is the historical purely additive
	// look, 1 is a full alpha blend.
	float transmittance = 1.0;
	if (global_ubo.fog_enable != 0 && global_ubo.pt_fog_extinction > 0.0)
	{
		transmittance = mix(1.0, clamp(result.a, 0.0, 1.0),
		                    clamp(global_ubo.pt_fog_opacity, 0.0, 1.0));
	}

	vec3 composition = originalColor.rgb * transmittance + result.rgb;
	
	imageStore(IMG_PT_TRANSPARENT, ivec2(gl_GlobalInvocationID.xy), vec4(composition.rgb, originalColor.a));
}
