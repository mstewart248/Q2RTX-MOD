/*
DLSS 5 NEURAL RENDERING - the passes around the model. See DLSSNR.c.

VKPT_IMG_DLSS_OUTPUT is LINEAR display-referred light after tone mapping; the sRGB encode only
happens later, in the _SRGB swapchain blit. The model was trained on what an SDR game buffer
actually holds, which is sRGB-ENCODED values - OptiScaler's proxy is linear -> sRGB for the
same reason. Handing it linear values reads to the model as a dark, oversaturated frame, and
its global colour/tone adaptation then hunts: the red <-> washed-out blue cycling.

  mode 0  ENCODE, in place on DLSS_OUTPUT: linear -> sRGB, clamped to [0,1], alpha 1.
  mode 1  RESOLVE: the model's answer (written by NGX into IMG_MOTION_BLUR, free scratch at
          this point in the frame) against the encoded original still in DLSS_OUTPUT, back
          to linear into DLSS_OUTPUT.

The resolve, in linear light:
  colour    0 keeps the ORIGINAL's hue and takes only the model's luminance change (a ratio,
            bounded to 4x so a near-black pixel cannot explode); 1 takes the model's colour
            as well. OptiScaler separates the two for the same reason: letting the model
            shift hue is where the colour drift shows.
  strength  scales the edit: 0 is the original, 1 the model, above 1 exaggerates it.
  view 2    |edit| x8 in sRGB units - black means the model left the pixel alone.
  split     pixels left of it are the original (compare mode 1).

HDR (push.hdr, the swapchain is scRGB). DLSS_OUTPUT then holds scRGB: the SDR tone mapper's
answer BEFORE its knee and clamp, times tm_hdr_peak_nits / 80 (tone_mapping_apply.comp), so
SDR white is ~10, not 1. The model is LDR-only - RTX Remix's own integration says as much
("highlights compressed by ... LDR-domain processing"). Clamping that straight to [0,1], as
the SDR encode does, clipped everything above a tenth of SDR white channel by channel: the
model saw a blown-out frame with hues bent toward yellow/cyan/white and the clipped result
went back on screen. So in HDR:
  encode    divide by the tone mapper's HDR scale, apply the SDR knee (tm_knee_start ->
            tm_white_point, the same rational curve tone mapping uses), clamp, sRGB. The
            model sees exactly the frame SDR mode would have shown it, minus the dither.
  resolve   the knee is strictly increasing up to tm_white_point (its asymptote w is > 1),
            so it is inverted to recover the HDR original from the encoded input. The
            model's luminance change is taken as a ratio in the LDR domain - stable at the
            shoulder, where expanding the model's own value would turn a 1% nudge into a
            blown highlight - and applied to that original, so hue is exact and pixels
            below the knee change exactly as they would in SDR. Colour from the model
            (colour > 0) is its answer expanded back through the inverse knee, rescaled to
            that same luminance.
  Only values above tm_white_point (10x the brightest SDR white) or below 0 do not survive
  the round trip; the display clips the first anyway.
*/

#version 460
#extension GL_GOOGLE_include_directive    : enable
#extension GL_EXT_nonuniform_qualifier    : enable

layout(local_size_x = 16, local_size_y = 16, local_size_z = 1) in;

#define GLOBAL_UBO_DESC_SET_IDX 0
#include "global_ubo.h"

#define GLOBAL_TEXTURES_DESC_SET_IDX 1
#include "global_textures.h"

#include "utils.glsl"

layout(push_constant) uniform Dlss5ConvertPushConstants {
	ivec2 extent;
	int   mode;
	int   split;
	float strength;
	float colour;
	int   view;
	int   hdr;
} push;

const vec3 kLuma = vec3(0.2126, 0.7152, 0.0722);

/* scRGB per unit of SDR tone-mapped colour - the factor tone_mapping_apply.comp's HDR
   branch multiplies by, including the menu-mode clamp toward ui_hdr_nits. */
float hdr_scale()
{
	const float nits_factor = global_ubo.tm_hdr_peak_nits / 80.0;
	const float nits_factor_ui = global_ubo.ui_hdr_nits / 80.0;
	return max(mix(nits_factor, min(nits_factor, nits_factor_ui), global_ubo.tonemap_hdr_clamp_strength), 1e-3);
}

/* The SDR knee from tone_mapping.c: identity below k, then y = (w x + a) / (x + b), which
   has slope 1 at k and reaches 1 at the white point W. k is kept below 1 so the curve
   stays invertible. */
void knee_params(out float k, out float w, out float a, out float b, out float white)
{
	k = clamp(global_ubo.tm_knee_start, 0.0, 0.99);
	white = max(global_ubo.tm_white_point, 1.001);
	w = (k * (k - 2.0) + white) / (white - 1.0);
	a = -k * k;
	b = w - 2.0 * k;
}

vec3 knee_forward(vec3 x)
{
	float k, w, a, b, white;
	knee_params(k, w, a, b, white);
	vec3 y = (w * x + a) / max(x + b, vec3(1e-6));
	return mix(x, y, step(vec3(k), x));
}

vec3 knee_inverse(vec3 y)
{
	float k, w, a, b, white;
	knee_params(k, w, a, b, white);
	/* y never reaches w (> 1): the input is clamped to [0,1] */
	vec3 x = (a - y * b) / min(y - w, vec3(-1e-6));
	return clamp(mix(y, x, step(vec3(k), y)), vec3(0), vec3(white));
}

void resolve_hdr(ivec2 ipos, vec4 c)
{
	const float scale = hdr_scale();

	vec3 in_enc    = clamp(c.rgb, vec3(0), vec3(1));
	vec3 model_enc = clamp(imageLoad(IMG_MOTION_BLUR, ipos).rgb, vec3(0), vec3(1));
	vec3 x_ldr = srgb_to_linear(in_enc);      /* what the model was given */
	vec3 m_ldr = srgb_to_linear(model_enc);   /* what it answered */

	vec3 o = knee_inverse(x_ldr) * scale;     /* the original scRGB frame */

	float r = clamp(dot(m_ldr, kLuma) / max(dot(x_ldr, kLuma), 1e-4), 0.0, 4.0);
	vec3 luma_only = o * r;

	vec3 m_hdr = knee_inverse(m_ldr) * scale;
	float y_m = dot(m_hdr, kLuma);
	vec3 model_colour = y_m > 1e-6 ? m_hdr * (dot(luma_only, kLuma) / y_m) : luma_only;

	vec3 edited = mix(luma_only, model_colour, clamp(push.colour, 0.0, 1.0));
	vec3 result = max(o + (edited - o) * push.strength, vec3(0));

	if (push.view == 2)
	{
		/* Same |edit| x8 as SDR, measured in the model's own LDR units, shown at UI
		   brightness so it reads the same on an HDR screen. */
		vec3 edited_ldr = mix(x_ldr * r, m_ldr, clamp(push.colour, 0.0, 1.0));
		vec3 diff = clamp(abs(linear_to_srgb(clamp(edited_ldr, vec3(0), vec3(1))) - in_enc) * 8.0, vec3(0), vec3(1));
		result = srgb_to_linear(diff) * (global_ubo.ui_hdr_nits / 80.0);
	}

	if (ipos.x < push.split)
		result = o;

	imageStore(IMG_DLSS_OUTPUT, ipos, vec4(result, c.a));
}

void main()
{
	ivec2 ipos = ivec2(gl_GlobalInvocationID.xy);
	if (any(greaterThanEqual(ipos, push.extent)))
		return;

	vec4 c = imageLoad(IMG_DLSS_OUTPUT, ipos);

	if (push.mode == 0)
	{
		vec3 ldr = c.rgb;
		if (push.hdr != 0)
			ldr = knee_forward(max(c.rgb / hdr_scale(), vec3(0)));
		imageStore(IMG_DLSS_OUTPUT, ipos, vec4(linear_to_srgb(clamp(ldr, vec3(0), vec3(1))), 1.0));
		return;
	}

	if (push.hdr != 0)
	{
		resolve_hdr(ipos, c);
		return;
	}

	vec3 orig_enc  = clamp(c.rgb, vec3(0), vec3(1));
	vec3 model_enc = clamp(imageLoad(IMG_MOTION_BLUR, ipos).rgb, vec3(0), vec3(1));
	vec3 o = srgb_to_linear(orig_enc);
	vec3 m = srgb_to_linear(model_enc);

	float yo = dot(o, kLuma);
	float ym = dot(m, kLuma);
	vec3 luma_only = o * clamp(ym / max(yo, 1e-4), 0.0, 4.0);
	vec3 edited = mix(luma_only, m, clamp(push.colour, 0.0, 1.0));

	vec3 result = max(o + (edited - o) * push.strength, vec3(0));

	if (push.view == 2)
		result = srgb_to_linear(clamp(abs(linear_to_srgb(clamp(edited, vec3(0), vec3(1))) - orig_enc) * 8.0, vec3(0), vec3(1)));

	if (ipos.x < push.split)
		result = o;

	imageStore(IMG_DLSS_OUTPUT, ipos, vec4(result, c.a));
}
